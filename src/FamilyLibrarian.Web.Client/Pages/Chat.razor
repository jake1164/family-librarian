@page "/chat"
@attribute [Authorize]
@using FamilyLibrarian.Contracts.Conversation
@using FamilyLibrarian.Web.Client.Conversation
@using System.Diagnostics
@implements IDisposable
@inject ConversationApiClient Conversation

<PageTitle>Chat · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">Chat</MudText>
        <MudText Typo="Typo.body1">
            Ask for a book the way you would ask a librarian: a title, an author, an ISBN, or “the third Murderbot book”.
            Requests go through the same approval process as the rest of Family Librarian. Say “help” to see what I can do.
        </MudText>
    </div>

    @if (status is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading chat" />
    }
    else if (!status.Enabled)
    {
        <MudAlert Severity="Severity.Info">Chat isn't turned on for this Family Librarian. <MudLink Href="search">Search the catalog</MudLink> instead.</MudAlert>
    }
    else
    {
        <MudStack Spacing="2" role="log" aria-live="polite" aria-label="Conversation">
            @foreach (var entry in entries)
            {
                if (entry.Reply is null)
                {
                    <MudText Typo="Typo.body1" Align="Align.Right" Class="family-librarian-chat-you"><strong>You:</strong> @entry.Text</MudText>
                }
                else
                {
                    <ConversationReplyView Reply="entry.Reply" OnSend="SendAsync" />
                    @if (entry.Elapsed is { } elapsed)
                    {
                        <MudText Typo="Typo.caption" Class="family-librarian-chat-elapsed">Answered in @FormatElapsed(elapsed)</MudText>
                    }
                }
            }
            @if (isSending)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Waiting for an answer" />
                <MudText Typo="Typo.caption">Working… @FormatElapsed(stopwatch?.Elapsed ?? TimeSpan.Zero)</MudText>
            }
        </MudStack>

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="draft" Label="Message" Variant="Variant.Outlined" Immediate="true"
                              MaxLength="@status.MaxMessageLength" Disabled="@isSending" AutoFocus="true"
                              Class="flex-grow-1" aria-label="Message to the librarian" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(isSending || string.IsNullOrWhiteSpace(draft))">Send</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" Disabled="@(isSending || entries.Count == 0)"
                           OnClick="StartOverAsync">New conversation</MudButton>
            </MudStack>
        </form>
    }
</MudStack>

@code {
    private sealed record Entry(string? Text, ConversationReplyResponse? Reply, TimeSpan? Elapsed = null);

    private readonly List<Entry> entries = [];
    private ConversationStatusResponse? status;
    private string draft = string.Empty;
    private bool isSending;
    private Stopwatch? stopwatch;
    private Timer? ticker;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            status = await Conversation.GetStatusAsync();
        }
        catch (HttpRequestException)
        {
            status = new ConversationStatusResponse(false, 0);
        }
    }

    private Task SubmitAsync()
    {
        var text = draft.Trim();
        draft = string.Empty;
        return text.Length == 0 ? Task.CompletedTask : SendAsync(text);
    }

    // A fresh id per message: a retry of the same message (not a repeat of the same words) is what the id protects.
    private async Task SendAsync(string text)
    {
        if (isSending) return;
        isSending = true;
        entries.Add(new Entry(text, null));
        StartClock();
        try
        {
            var reply = await Conversation.SendAsync(text, Guid.NewGuid().ToString("N"));
            entries.Add(reply is null
                ? new Entry(null, Fallback("Chat isn't available right now. Please sign in again or use search."), stopwatch?.Elapsed)
                : new Entry(null, reply, stopwatch?.Elapsed));
        }
        catch (HttpRequestException)
        {
            entries.Add(new Entry(null, Fallback("I couldn't reach Family Librarian just now. Please try again."), stopwatch?.Elapsed));
        }
        finally
        {
            StopClock();
            isSending = false;
        }
    }

    // Clears what is on screen and, through the ordinary "cancel" message, what the host remembers: the offered list, any
    // pending format question and the turn count. The answer is not shown; the page simply starts empty.
    private async Task StartOverAsync()
    {
        if (isSending) return;
        isSending = true;
        entries.Clear();
        StartClock();
        try
        {
            await Conversation.SendAsync("cancel", Guid.NewGuid().ToString("N"));
        }
        catch (HttpRequestException)
        {
            entries.Add(new Entry(null, Fallback("I cleared the screen but couldn't reach Family Librarian to reset the conversation. Say \"cancel\" to try again.")));
        }
        finally
        {
            StopClock();
            isSending = false;
        }
    }

    private void StartClock()
    {
        stopwatch = Stopwatch.StartNew();
        ticker = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }

    private void StopClock()
    {
        ticker?.Dispose();
        ticker = null;
        stopwatch?.Stop();
    }

    private static string FormatElapsed(TimeSpan elapsed) =>
        elapsed.TotalSeconds < 10
            ? $"{elapsed.TotalSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} s"
            : $"{elapsed.TotalSeconds.ToString("0", System.Globalization.CultureInfo.InvariantCulture)} s";

    public void Dispose() => ticker?.Dispose();

    private static ConversationReplyResponse Fallback(string text) => new("Unavailable", text, [], [], [], null, false);
}
