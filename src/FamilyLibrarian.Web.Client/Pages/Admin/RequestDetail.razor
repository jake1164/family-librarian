    private static string AdminCandidateLabel(AdminRequestReviewCandidateResponse candidate) =>
        (candidate.Author is { } author
            ? string.IsNullOrWhiteSpace(candidate.Language)
                ? $"{candidate.Title} by {author}"
                : $"{candidate.Title} by {author} ({candidate.Language})"
            : string.IsNullOrWhiteSpace(candidate.Language)
                ? candidate.Title
                : $"{candidate.Title} ({candidate.Language})") +
        (string.IsNullOrWhiteSpace(candidate.Details) ? string.Empty : $" — {candidate.Details}");

    private static string AdminProviderName(AdminRequestReviewCandidateResponse candidate) =>
        candidate.ProviderId.Equals("gutendex", StringComparison.OrdinalIgnoreCase)
            ? "Project Gutenberg"
            : candidate.ProviderId;

    /// <summary>
    /// The server's verdict on whether this candidate's own claimed title
    /// names the requested work. Computed host-side (WorkTitlePlausibility) so
    /// the WebAssembly client never carries a second copy of the matching
    /// rules that could drift from the ones acquisition actually enforces.
    /// </summary>
    private static bool CandidateMatchesRequest(AdminRequestReviewCandidateResponse candidate) =>
        candidate.NamesRequestedWork;

    private static string ReviewSummary(int candidateCount) => candidateCount == 1
        ? "One source record needs your review. Inspect its source page and media details before acquiring it."
        : $"{candidateCount} distinct source records need your review. Compare their source pages and media details before acquiring one.";

    private static string ReviewReason(NeedsReviewResponse? review, int candidateCount)
    {
        if (string.Equals(review?.Reason, "Multiple plausible editions were found.", StringComparison.Ordinal))
        {
            return candidateCount == 1
                ? "One source record was retained from an earlier review. Project Gutenberg compares ebook and audiobook records separately and only selects a record automatically when it has at least 1,000 downloads and a 3× lead over the runner-up. Inspect this audiobook record before acquiring it."
                : "Several eligible records were found, but no single record met the automatic-selection rule.";
        }

        return string.IsNullOrWhiteSpace(review?.Reason)
            ? "Compare the source evidence here, then select one copy for acquisition."
            : review.Reason;
    }

    private async Task ApplyOutcomeAsync(AdminRequestActionOutcome outcome)
    {
        if (!outcome.Succeeded)
        {
            errorMessage = outcome.Error;
            return;
        }

        request = outcome.Request;
        adminNote = request?.Request.AdminNote;
        // Reload after a successful command so the detail's timeline and version
        // are both the authoritative server state.
        await LoadAsync();
    }

    private static string TransitionLabel(string status) => status switch
    {
        "PendingAcquisition" => "Return to queue",
        "NeedsReview" => "Needs review",
        "NotAvailable" => "Mark unavailable",
        "Cancelled" => "Cancel request",
        _ => status
    };

    private static Color TransitionColor(string status) => status switch
    {
        "NotAvailable" or "Cancelled" => Color.Error,
        "NeedsReview" => Color.Warning,
        _ => Color.Primary
    };

    private void StopFulfillmentOptionsLoad()
    {
        fulfillmentLoadCancellation?.Cancel();
        fulfillmentLoadCancellation?.Dispose();
        fulfillmentLoadCancellation = null;
    }

    public override void Dispose()
    {
        base.Dispose();
        StopFulfillmentOptionsLoad();
    }
}
