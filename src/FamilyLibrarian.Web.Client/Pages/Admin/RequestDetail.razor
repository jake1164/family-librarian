    private async Task ResolveNeedsReviewAsync(Guid? candidateId)
    {
        if (request is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            var outcome = await Requests.ResolveNeedsReviewAsync(
                request.Request.Id, candidateId, request.Request.Version);
            await ApplyOutcomeAsync(outcome);
        }
        catch (HttpRequestException)
        {
            errorMessage = "That choice could not be saved. Please try again.";
