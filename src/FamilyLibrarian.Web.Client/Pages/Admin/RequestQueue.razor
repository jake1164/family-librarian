@page "/admin/requests"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Web.Client.Acquisition
@inject AdminRequestsApiClient Requests
@inject MediaAssetsApiClient MediaAssets
@inject ISnackbar Snackbar

<PageTitle>Request queue · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">Request queue</MudText>
        <MudText Typo="Typo.body1">
            Review family requests without exposing one member's private list to another.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }

    @if (attention is { } summary && summary.NeedsReviewCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2">
                    @summary.NeedsReviewCount request@(summary.NeedsReviewCount == 1 ? string.Empty : "s") need librarian review.
                </MudText>
                <MudButton Variant="Variant.Text" Color="Color.Warning" Disabled="@isLoading"
                           OnClick='@(() => SelectStatusAsync("NeedsReview"))'>
                    Show needs review
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (attention is { } sourceAttention && sourceAttention.ProviderIssues.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            An automatic source needs attention. Review <MudLink Href="settings/sources">Sources</MudLink> for the safe diagnostic and next step.
        </MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Batch upload</MudText>
            <MudText Typo="Typo.body2">
                Choose several files at once. Each is matched to one waiting request by title and format,
                then quarantined and scanned automatically. A file with no unambiguous match is left out
                so it cannot fulfill the wrong request.
            </MudText>
            <InputFile OnChange="ImportBatchAsync" multiple disabled="@isUploading" aria-label="Choose files to upload" />
            @if (isUploading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            @if (batchResults.Count > 0)
            {
                <MudList T="string" Dense="true">
                    @foreach (var result in batchResults)
                    {
                        <MudListItem T="string" Icon="@(result.Succeeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                                     IconColor="@(result.Succeeded ? Color.Success : Color.Warning)">
                            @result.FileName — @result.Message
                        </MudListItem>
                    }
                </MudList>
            }
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        @foreach (var filter in Filters)
        {
            <MudButton Variant="@(selectedStatus == filter.Status ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary"
                       Disabled="@isLoading"
                       OnClick="() => SelectStatusAsync(filter.Status)">
                @FilterLabel(filter)
            </MudButton>
        }
    </MudStack>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (requests.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No requests match this filter.</MudAlert>
    }
    else
    {
        @foreach (var item in requests)
        {
            <MudCard Outlined="true" Class="mb-3">
                <MudCardContent>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">@item.Request.WorkTitle</MudText>
                        <MudText Typo="Typo.body2">@string.Join(", ", item.Request.Authors)</MudText>
                        <MudText Typo="Typo.body2">
                            Requested by @item.RequesterDisplayName (@item.RequesterEmail)
                        </MudText>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Request.Status)">
                                @StatusLabel(item.Request.Status)
                            </MudChip>
                            @foreach (var format in item.Request.Formats)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @format.MediaType
                                </MudChip>
                            }
                        </MudStack>
                        @foreach (var format in item.Request.Formats.Where(format =>
                            !string.IsNullOrWhiteSpace(format.ProgressDescription)))
                        {
                            <MudText Typo="Typo.body2" Color="@ProgressColor(format.ProgressCode)">
                                @format.MediaType: @format.ProgressDescription
                            </MudText>
                        }
                        <MudText Typo="Typo.caption">
                            Asked @item.Request.RequestedAtUtc.ToLocalTime().ToString("g")
                            (@Age(item.Request.RequestedAtUtc))
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Href="@($"admin/requests/{item.Request.Id}")">
                        Review request
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }
    }
</MudStack>

@code {
    private static readonly (string? Status, string Label)[] Filters =
    [
        ("PendingAcquisition", "Waiting"),
        ("NeedsReview", "Needs review"),
        (null, "All requests")
    ];

    private IReadOnlyList<AdminBookRequestResponse> requests = [];
    private string? selectedStatus = "PendingAcquisition";
    private bool isLoading = true;
    private bool isUploading;
    private string? errorMessage;
    private IReadOnlyList<BatchUploadResult> batchResults = [];
    private AdminRequestAttentionResponse? attention;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SelectStatusAsync(string? status)
    {
        selectedStatus = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            requests = await Requests.GetQueueAsync(selectedStatus);
            try
            {
                attention = await Requests.GetAttentionAsync();
            }
            catch (HttpRequestException)
            {
                // A failed attention refresh must not make the queue itself
                // disappear. The persistent layout will retry independently.
            }
        }
        catch (HttpRequestException)
        {
            requests = [];
            errorMessage = "The request queue could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FilterLabel((string? Status, string Label) filter) =>
        filter.Status == "NeedsReview" && attention?.NeedsReviewCount is > 0
            ? $"{filter.Label} ({attention.NeedsReviewCount})"
            : filter.Label;

    private async Task ImportBatchAsync(InputFileChangeEventArgs args)
    {
        isUploading = true;
        errorMessage = null;
        var results = new List<BatchUploadResult>();

        try
        {
            // Resolve against the whole waiting queue, not just whichever filter
            // happens to be selected on screen.
            var waiting = await Requests.GetQueueAsync("PendingAcquisition");
            foreach (var file in args.GetMultipleFiles(50))
            {
                var match = FindBatchMatch(file.Name, waiting);
                if (match is null)
                {
                    results.Add(new BatchUploadResult(
                        file.Name,
                        false,
                        "No unambiguous waiting request matched this filename. Use the individual uploader to choose its request."));
                    continue;
                }

                var outcome = await MediaAssets.ImportAsync(match.RequestId, match.FormatId, file);
                results.Add(new BatchUploadResult(
                    file.Name,
                    outcome.Succeeded,
                    outcome.Succeeded
                        ? $"Matched to {match.Title}; security and delivery processing started automatically."
                        : outcome.Error ?? "The file could not be imported."));
            }

            batchResults = results;
            if (results.Any(result => result.Succeeded))
            {
                Snackbar.Add("Batch upload complete. Matched files are ready for security approval.", Severity.Success);
            }

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            batchResults = results;
            errorMessage = "The batch could not be uploaded. Check the completed results and try again.";
        }
        finally
        {
            isUploading = false;
        }
    }

    private static BatchMatch? FindBatchMatch(
        string fileName,
        IReadOnlyList<AdminBookRequestResponse> waiting)
    {
        var mediaType = MediaTypeFor(fileName);
        if (mediaType is null)
        {
            return null;
        }

        var normalizedName = Normalize(Path.GetFileNameWithoutExtension(fileName));
        var candidates = waiting
            .SelectMany(request => request.Request.Formats
                .Where(format => format.MediaType == mediaType)
                .Select(format => new BatchMatch(
                    request.Request.Id,
                    format.FormatId,
                    request.Request.WorkTitle,
                    MatchScore(normalizedName, request.Request.WorkTitle, request.Request.Authors))))
            .Where(candidate => candidate.Score > 0)
            .OrderByDescending(candidate => candidate.Score)
            .ToArray();

        if (candidates.Length == 0 ||
            (candidates.Length > 1 && candidates[0].Score == candidates[1].Score))
        {
            return null;
        }

        return candidates[0];
    }

    private static int MatchScore(string normalizedName, string title, IReadOnlyList<string> authors)
    {
        var normalizedTitle = Normalize(title);
        if (normalizedTitle.Length < 4 || !normalizedName.Contains(normalizedTitle, StringComparison.Ordinal))
        {
            return 0;
        }

        var authorBonus = authors
            .Select(Normalize)
            .Any(author => author.Length >= 4 && normalizedName.Contains(author, StringComparison.Ordinal))
            ? 10_000
            : 0;
        return authorBonus + normalizedTitle.Length;
    }

    private static string? MediaTypeFor(string fileName) => Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".epub" or ".pdf" or ".mobi" or ".azw" or ".azw3" or ".fb2" or ".txt" or ".html" or ".rtf" or ".odt" or ".djvu" or ".prc" or ".doc" or ".docx" => "Ebook",
        ".mp3" or ".m4a" or ".m4b" => "Audiobook",
        _ => null
    };

    private static string Normalize(string value) => new(value
        .Where(char.IsLetterOrDigit)
        .Select(char.ToLowerInvariant)
        .ToArray());

    private sealed record BatchMatch(Guid RequestId, Guid FormatId, string Title, int Score);

    private sealed record BatchUploadResult(string FileName, bool Succeeded, string Message);

    private static Color StatusColor(string status) => status switch
    {
        "PendingAcquisition" => Color.Info,
        "NeedsReview" => Color.Warning,
        "NotAvailable" => Color.Error,
        _ => Color.Default
    };

    private static Color ProgressColor(string? progressCode) => progressCode switch
    {
        "SecurityCheckFailed" or "PublishingNeedsAttention" => Color.Error,
        "AwaitingApproval" or "SecurityReviewRequired" or "IdentityReviewRequired" => Color.Warning,
        "Available" => Color.Success,
        _ => Color.Info
    };

    private static string StatusLabel(string status) => status switch
    {
        "PendingAcquisition" => "Waiting",
        "NeedsReview" => "Needs review",
        "NotAvailable" => "Not available",
        "Cancelled" => "Cancelled",
        _ => status
    };

    private static string Age(DateTimeOffset requestedAtUtc)
    {
        var age = DateTimeOffset.UtcNow - requestedAtUtc;
        return age.TotalDays >= 1
            ? $"{Math.Floor(age.TotalDays)} days ago"
            : age.TotalHours >= 1
                ? $"{Math.Floor(age.TotalHours)} hours ago"
                : "less than an hour ago";
    }
}
