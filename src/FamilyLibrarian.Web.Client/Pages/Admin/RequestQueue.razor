@inherits LiveComponentBase
@page "/admin/requests"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Providers
@using FamilyLibrarian.Web.Client.Acquisition
@using FamilyLibrarian.Web.Client.Integrations
@inject AdminRequestsApiClient Requests
@inject MetadataIntegrationsApiClient MetadataIntegrations
@inject ISnackbar Snackbar

<PageTitle>Request queue · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">Request queue</MudText>
        <MudText Typo="Typo.body1">
            Review family requests without exposing one member's private list to another.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            @foreach (var filter in Filters)
            {
                <MudButton Variant="@(selectedStatus == filter.Status ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           Disabled="@isLoading"
                           OnClick="() => SelectStatusAsync(filter.Status)">
                    @FilterLabel(filter)
                </MudButton>
            }
        </MudStack>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="admin/batch-upload"
                   StartIcon="@Icons.Material.Filled.UploadFile">
            Batch upload
        </MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (requests.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No requests match this filter.</MudAlert>
    }
    else
    {
        @foreach (var item in requests)
        {
            <MudCard Outlined="true" Class="mb-3">
                <MudCardContent>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">@item.Request.WorkTitle</MudText>
                        <MudText Typo="Typo.body2">@string.Join(", ", item.Request.Authors)</MudText>
                        <MudText Typo="Typo.body2">
                            Requested by @item.RequesterDisplayName (@item.RequesterEmail)
                        </MudText>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <RequestStatusChip Status="@item.Request.Status" Label="@RequestLabel(item.Request)" />
                            @foreach (var format in item.Request.Formats)
                            {
                                <FormatStatusChip MediaType="@format.MediaType" Status="@format.Status"
                                                   ProgressCode="@FormatProgressCode(item, format)"
                                                   ProgressDescription="@FormatDescription(item, format)"
                                                   ExternalActionUri="@format.ExternalActionUri" />
                            }
                        </MudStack>
                        @foreach (var activity in ActiveForRequest(item.Request.Id))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info">
                                @activity.Stage from @activity.ProviderDisplayName for @FormatName(item.Request, activity.RequestFormatId)
                                since @activity.StartedAtUtc.ToLocalTime().ToString("t").
                            </MudText>
                        }
                        <MudText Typo="Typo.caption">
                            Asked @item.Request.RequestedAtUtc.ToLocalTime().ToString("g")
                            (@Age(item.Request.RequestedAtUtc))
                        </MudText>
                        @if (WaitingInteractionFor(item.Request.Id) is { } waitingInteraction)
                        {
                            @* HUMAN-ACQ-1 D7: claimed-by-another is informational, not a "needs you" prompt. *@
                            @if (!string.IsNullOrWhiteSpace(waitingInteraction.ClaimedByDisplayName) && !waitingInteraction.IsClaimedByCurrentUser)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                    Being handled by @waitingInteraction.ClaimedByDisplayName.
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="@(waitingInteraction.IsExpired ? Severity.Error : Severity.Warning)"
                                          Dense="true" Variant="Variant.Outlined">
                                    Needs you: @(waitingInteraction.Message ?? $"{waitingInteraction.ProviderId} needs a librarian action.")
                                    <MudLink Href="admin/provider-interactions" Class="ml-1">Open provider interactions</MudLink>
                                </MudAlert>
                            }
                        }
                        @if (item.Request.Status == "NeedsReview")
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                <MudText Typo="Typo.body2">@ReviewDescription(item)</MudText>
                                @if (item.ReviewCandidates is { Count: > 0 } candidates)
                                {
                                    <MudText Typo="Typo.caption">
                                        @candidates.Count source record@(candidates.Count == 1 ? "" : "s")
                                        from @string.Join(", ", candidates.Select(candidate => candidate.ProviderId).Distinct(StringComparer.OrdinalIgnoreCase)).
                                        Open the request to inspect and resolve them.
                                    </MudText>
                                }
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1" Wrap="Wrap.Wrap">
                                    <MudMenu Label="Recheck" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                             StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isRechecking">
                                        <MudMenuItem OnClick="@(() => RecheckAsync(null))">
                                            All providers
                                        </MudMenuItem>
                                        @foreach (var provider in directAcquisitionProviders)
                                        {
                                            <MudMenuItem OnClick="@(() => RecheckAsync(provider.ProviderId))">
                                                @provider.DisplayName only
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                    <MudText Typo="Typo.caption">
                                        Requeues every request needing review — not just this one — for another
                                        automatic pass.
                                    </MudText>
                                </MudStack>
                            </MudAlert>
                        }
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Href="@($"admin/requests/{item.Request.Id}")">
                        Review request
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }
    }
</MudStack>

@code {
    [CascadingParameter]
    private IReadOnlyList<AdminActiveAcquisitionResponse> ActiveAcquisitions { get; set; } = [];

    private IEnumerable<AdminActiveAcquisitionResponse> ActiveForRequest(Guid requestId) =>
        ActiveAcquisitions.Where(activity => activity.RequestId == requestId);

    private AdminActiveAcquisitionResponse? ActiveForFormat(Guid formatId) =>
        ActiveAcquisitions.FirstOrDefault(activity => activity.RequestFormatId == formatId);

    private string? RequestLabel(BookRequestResponse request) => request.Status == "PendingAcquisition"
        ? ActiveForRequest(request.Id).Any() ? "Working" : "Awaiting next check"
        : null;

    private static bool HasReviewCandidates(AdminBookRequestResponse item, Guid formatId) =>
        item.Request.Status == "NeedsReview" &&
        item.ReviewCandidates?.Any(candidate => candidate.RequestFormatId == formatId) == true;

    private string? FormatProgressCode(AdminBookRequestResponse item, BookRequestFormatResponse format) =>
        HasReviewCandidates(item, format.FormatId) ? "AwaitingApproval" : format.ProgressCode;

    private string? FormatDescription(AdminBookRequestResponse item, BookRequestFormatResponse format) =>
        ActiveForFormat(format.FormatId) is { } activity
            ? AdminAcquisitionProgressText.Describe(activity)
            : HasReviewCandidates(item, format.FormatId) ? "Source review needed"
            : WaitingInteractionForFormat(item.Request.Id, format.FormatId) is not null ? "Provider action needed"
            : format.ProgressDescription ?? (format.Status == "Requested" ? "Awaiting next check" : null);

    private static string FormatName(BookRequestResponse request, Guid formatId) =>
        request.Formats.FirstOrDefault(format => format.FormatId == formatId)?.MediaType ?? "format";

    private static string ReviewDescription(AdminBookRequestResponse item) =>
        item.Request.NeedsReview?.Reason is { Length: > 0 } reason && !string.IsNullOrWhiteSpace(reason)
            ? reason
            : item.Request.StatusDescription;

    private static readonly (string? Status, string Label)[] Filters =
    [
        (null, "All requests"),
        ("PendingAcquisition", "Waiting"),
        ("NeedsReview", "Needs review")
    ];

    private IReadOnlyList<AdminBookRequestResponse> requests = [];
    private string? selectedStatus;
    private bool isLoading = true;
    private string? errorMessage;
    private AdminRequestAttentionResponse? attention;
    private IReadOnlyList<ProviderStatusResponse> directAcquisitionProviders = [];
    private bool isRechecking;

    protected override async Task OnInitializedAsync()
    {
        Observe(LiveUpdateTopics.Requests | LiveUpdateTopics.Sources, LoadAsync);
        await RefreshLiveAsync();
        await LoadDirectAcquisitionProvidersAsync();
    }

    private async Task LoadDirectAcquisitionProvidersAsync()
    {
        try
        {
            directAcquisitionProviders = (await MetadataIntegrations.GetProvidersAsync())
                .Where(provider => provider.Capabilities.Contains("DirectAcquisition", StringComparer.Ordinal))
                .ToArray();
        }
        catch (HttpRequestException)
        {
            // The recheck menu just offers fewer per-provider choices; "All providers" still works.
        }
    }

    private async Task RecheckAsync(string? providerId)
    {
        isRechecking = true;
        errorMessage = null;
        try
        {
            var outcome = await Requests.RecheckNeedsReviewAsync(providerId);
            if (outcome.Succeeded)
            {
                Snackbar.Add(
                    outcome.RequeuedCount == 0
                        ? "No matching requests needed a recheck."
                        : $"Requeued {outcome.RequeuedCount} request{(outcome.RequeuedCount == 1 ? string.Empty : "s")} for another automatic pass.",
                    Severity.Success);
                await LoadAsync();
            }
            else
            {
                errorMessage = outcome.Error;
            }
        }
        finally
        {
            isRechecking = false;
        }
    }

    private async Task SelectStatusAsync(string? status)
    {
        selectedStatus = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var loaded = await Requests.GetQueueAsync(selectedStatus);
            requests = loaded
                .OrderBy(AttentionRank)
                .ThenBy(item => item.Request.RequestedAtUtc)
                .ToArray();
            try
            {
                attention = await Requests.GetAttentionAsync();
            }
            catch (HttpRequestException)
            {
                // A failed attention refresh must not make the queue itself
                // disappear. The persistent layout will retry independently.
            }
        }
        catch (HttpRequestException)
        {
            requests = [];
            errorMessage = "The request queue could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// The waiting provider interaction for one request in the queue, if any
    /// -- looked up from the same attention payload the "Needs review" filter
    /// count already uses, so no extra round trip per card.
    /// </summary>
    private AdminProviderInteractionAttentionResponse? WaitingInteractionFor(Guid requestId) =>
        attention?.WaitingProviderInteractions.FirstOrDefault(interaction => interaction.RequestId == requestId);

    private AdminProviderInteractionAttentionResponse? WaitingInteractionForFormat(Guid requestId, Guid formatId) =>
        attention?.WaitingProviderInteractions.FirstOrDefault(interaction =>
            interaction.RequestId == requestId && interaction.RequestFormatId == formatId);

    /// <summary>
    /// Lowest rank surfaces first: requests or formats colored red (failed /
    /// not available) outrank amber (needs review / awaiting approval),
    /// which outrank in-progress blue, which outrank resolved green/grey.
    /// Mirrors the chip color convention in <see cref="MediaTypeVisuals"/> so
    /// "needs action" in the queue always means the same thing it means on
    /// the chip. A waiting provider interaction is folded in at the same
    /// amber/red tier as the shared status vocabulary, even though the
    /// underlying format chip itself stays the deliberately generic blue
    /// "AwaitingProviderAction" (docs/07-ui-conventions.md) -- this ranking
    /// is admin-only and does not touch that shared chip.
    /// </summary>
    private int AttentionRank(AdminBookRequestResponse item)
    {
        var colors = item.Request.Formats
            .Select(format => MediaTypeVisuals.StatusColor(format.Status, format.ProgressCode))
            .Append(MediaTypeVisuals.StatusColor(item.Request.Status));
        var rank = colors.Min(ColorRank);
        if (WaitingInteractionFor(item.Request.Id) is { } interaction)
        {
            rank = Math.Min(rank, ColorRank(interaction.IsExpired ? Color.Error : Color.Warning));
        }

        return rank;
    }

    private static int ColorRank(Color color) => color switch
    {
        Color.Error => 0,
        Color.Warning => 1,
        Color.Info => 2,
        _ => 3
    };

    private string FilterLabel((string? Status, string Label) filter) =>
        filter.Status == "NeedsReview" && attention?.NeedsReviewCount is > 0
            ? $"{filter.Label} ({attention.NeedsReviewCount})"
            : filter.Label;

    private static string Age(DateTimeOffset requestedAtUtc)
    {
        var age = DateTimeOffset.UtcNow - requestedAtUtc;
        return age.TotalDays >= 1
            ? $"{Math.Floor(age.TotalDays)} days ago"
            : age.TotalHours >= 1
                ? $"{Math.Floor(age.TotalHours)} hours ago"
                : "less than an hour ago";
    }
}
