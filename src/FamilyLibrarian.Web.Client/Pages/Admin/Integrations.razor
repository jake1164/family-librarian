@page "/settings/metadata-providers"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Providers
@using FamilyLibrarian.Web.Client.Integrations
@using Microsoft.AspNetCore.Authorization
@* Named IntegrationsApi, not Integrations: a member may not share the enclosing
   component's type name. *@
@inject MetadataIntegrationsApiClient IntegrationsApi
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Metadata providers | Family Librarian</PageTitle>
<SettingsDraftGuard IsDirty="@(HasUnsavedChanges)" />

<MudText Typo="Typo.h4" GutterBottom="true">Metadata providers</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Choose the services Family Librarian uses to identify and describe books. API keys
    are stored encrypted and are never shown again after you save them.
</MudText>

@if (loadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the provider settings.</MudAlert>
}
else if (providers is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading providers" />
}
else
{
    <MudStack Spacing="4">
        @foreach (var provider in providers.Where(provider => provider.Capabilities.Contains("Metadata", StringComparer.Ordinal)))
        {
            var needsSetup = NeedsSetup(provider);
            // The detail section (key/test) tracks Enabled directly — off means
            // collapsed to just the name and description. expandedSetup covers
            // the one case that would otherwise be a dead end: flipping the
            // switch on an unconfigured provider (see SetEnabledAsync) reveals
            // the key field instead of calling an API that would only reject it.
            var expanded = provider.IsEnabled || provider.IsExternallyManaged || expandedSetup.Contains(provider.ProviderId);

            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6">@provider.DisplayName</MudText>

                    @if (provider.IsExternallyManaged)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            Managed by this deployment
                        </MudChip>
                    }
                    @if (needsSetup)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            Needs an API key
                        </MudChip>
                    }

                    <MudSpacer />

                    <SettingSwitch Value="provider.IsEnabled" AlignEnd="true"
                                   Changing="@(change => SetEnabledAsync(provider, change))"
                                   Disabled="@(provider.IsExternallyManaged || busyProviderId is not null)"
                                   Label="@(provider.IsEnabled ? "Enabled" : "Disabled")" aria-label="@provider.DisplayName" />
                </MudStack>

                @if (provider.IsExternallyManaged)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        This provider is configured by the deployment. Change its key and
                        enabled state where the deployment secrets are managed.
                    </MudAlert>
                }

                @if (!string.IsNullOrWhiteSpace(provider.SetupInstructions) || provider.SetupLinks.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        <MudStack Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(provider.SetupInstructions))
                            {
                                <MudText Typo="Typo.body2">@provider.SetupInstructions</MudText>
                            }
                            @if (provider.SetupLinks.Count > 0)
                            {
                                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                                    @foreach (var link in provider.SetupLinks)
                                    {
                                        <MudLink Href="@link.Url" Target="_blank" rel="noopener noreferrer">
                                            @link.Label
                                        </MudLink>
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudAlert>
                }

                @if (expanded)
                {
                    @if (!provider.IsExternallyManaged && provider.RequiresCredential)
                    {
                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">API key</MudText>
                        @if (provider.HasStoredCredential)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">
                                A key ending in <strong>@provider.CredentialHint</strong> was saved
                                @(provider.CredentialSetAtUtc?.ToLocalTime().ToString("f")).
                                Enter a new key to replace it.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">No key is stored yet.</MudText>
                        }

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTextField T="string"
                                          @bind-Value="credentialDrafts[provider.ProviderId]"
                                          Label="@(provider.HasStoredCredential ? "Replace API key" : "API key")"
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Disabled="@(busyProviderId is not null)"
                                          Class="flex-grow-1" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(busyProviderId is not null || string.IsNullOrWhiteSpace(credentialDrafts[provider.ProviderId]))"
                                       OnClick="@(() => SaveCredentialAsync(provider))">
                                Save key
                            </MudButton>

                            @if (provider.HasStoredCredential)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Disabled="@(busyProviderId is not null)"
                                           OnClick="@(() => ClearCredentialAsync(provider))">
                                    Remove key
                                </MudButton>
                            }
                        </MudStack>
                    }

                    <MudDivider Class="my-3" />

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudButton Variant="Variant.Outlined"
                                   Disabled="@(busyProviderId is not null)"
                                   OnClick="@(() => TestAsync(provider))">
                            Test connection
                        </MudButton>

                        @if (!string.IsNullOrWhiteSpace(credentialDrafts.GetValueOrDefault(provider.ProviderId)))
                        {
                            <MudText Typo="Typo.caption">Tests the key above, not yet saved.</MudText>
                        }

                        @if (provider.LastTestedAtUtc is not null)
                        {
                            <MudText Typo="Typo.body2">
                                <MudIcon Icon="@(provider.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                         Color="@(provider.LastTestSucceeded == true ? Color.Success : Color.Error)"
                                         Size="Size.Small" />
                                @provider.LastTestMessage
                                <MudText Typo="Typo.caption" Class="ml-1">
                                    (@provider.LastTestedAtUtc.Value.ToLocalTime().ToString("f"))
                                </MudText>
                            </MudText>
                        }
                    </MudStack>

                    @if (testResults.TryGetValue(provider.ProviderId, out var testResult))
                    {
                        <MudAlert Severity="@(testResult.Succeeded ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2" role="status">
                            @testResult.Message
                        </MudAlert>
                    }

                    @if (needsSetup)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Save a working API key above to enable this provider.
                        </MudText>
                    }
                }
            </MudPaper>
        }
    </MudStack>
}

@code {
    private bool HasUnsavedChanges => credentialDrafts.Values.Any(value => !string.IsNullOrEmpty(value));
    private IReadOnlyList<ProviderStatusResponse>? providers;
    private readonly Dictionary<string, string?> credentialDrafts = new(StringComparer.OrdinalIgnoreCase);
    // Providers whose detail section is showing even though they're not
    // Enabled — set when flipping the switch on an unconfigured provider reveals
    // its key field instead of calling the API (see SetEnabledAsync), and
    // cleared again once the provider is actually switched off for real.
    private readonly HashSet<string> expandedSetup = new(StringComparer.OrdinalIgnoreCase);
    private string? busyProviderId;
    private readonly Dictionary<string, (bool Succeeded, string? Message)> testResults = new(StringComparer.OrdinalIgnoreCase);
    private bool loadFailed;

    private void Expand(string providerId) => expandedSetup.Add(providerId);
    private void Collapse(string providerId) => expandedSetup.Remove(providerId);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            providers = await IntegrationsApi.GetProvidersAsync();
            foreach (var provider in providers)
            {
                credentialDrafts.TryAdd(provider.ProviderId, null);
            }
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    private static bool NeedsSetup(ProviderStatusResponse provider) =>
        provider.RequiresCredential && !provider.IsExternallyManaged && !provider.HasStoredCredential;

    private async Task SetEnabledAsync(ProviderStatusResponse provider, SettingSwitchChange change)
    {
        if (change.Value && NeedsSetup(provider))
        {
            // The server would refuse without a key, so open the key field and say so.
            Expand(provider.ProviderId);
            change.Refuse("Save an API key first. The key field is open below.");
            return;
        }

        var (saved, error) = await RunAsync(provider, () => IntegrationsApi.SetEnabledAsync(provider.ProviderId, change.Value));
        if (!saved)
        {
            Expand(provider.ProviderId);
            change.Refuse(error);
            return;
        }

        Snackbar.Saved($"{provider.DisplayName} {(change.Value ? "enabled" : "disabled")}.");
        if (!change.Value)
        {
            // Once switched off, the detail section should actually collapse
            // rather than stay open because an earlier attempt to configure it
            // left it expanded.
            Collapse(provider.ProviderId);
        }
    }

    private async Task SaveCredentialAsync(ProviderStatusResponse provider)
    {
        var credential = credentialDrafts[provider.ProviderId];
        if (string.IsNullOrWhiteSpace(credential))
        {
            return;
        }

        var (saved, error) = await RunAsync(
            provider,
            () => IntegrationsApi.SetCredentialAsync(provider.ProviderId, credential));

        if (!saved)
        {
            Snackbar.Failed(error);
        }
        else
        {
            // Drop the plaintext from the component as soon as the host has it,
            // so it does not linger in the rendered field or component state.
            credentialDrafts[provider.ProviderId] = null;
            Snackbar.Saved($"Saved the {provider.DisplayName} API key.");
        }
    }

    private async Task ClearCredentialAsync(ProviderStatusResponse provider)
    {
        if (!await Dialogs.ConfirmRemovalAsync($"Remove the {provider.DisplayName} API key?",
                "The stored key is deleted. A provider that needs a key is switched off."))
        {
            return;
        }

        var (saved, error) = await RunAsync(provider, () => IntegrationsApi.ClearCredentialAsync(provider.ProviderId));
        if (saved)
        {
            Snackbar.Saved($"Removed the {provider.DisplayName} API key.");
        }
        else
        {
            Snackbar.Failed(error);
        }
    }

    private async Task TestAsync(ProviderStatusResponse provider)
    {
        busyProviderId = provider.ProviderId;
        try
        {
            // A key typed into the draft field but not yet saved is tested in
            // place of the stored one, so an admin can verify it works before
            // committing to Save key.
            var result = await IntegrationsApi.TestAsync(
                provider.ProviderId,
                credentialDrafts.GetValueOrDefault(provider.ProviderId));
            if (result is null)
            {
                Snackbar.Failed("The connection test could not be run.");
                return;
            }

            Replace(result.Provider);
            testResults[provider.ProviderId] = (result.Succeeded, result.Message);
        }
        finally
        {
            busyProviderId = null;
        }
    }

    private async Task<(bool Saved, string? Error)> RunAsync(
        ProviderStatusResponse provider,
        Func<Task<MetadataIntegrationsResult>> action)
    {
        busyProviderId = provider.ProviderId;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                return (false, result.Error);
            }

            if (result.Provider is not null)
            {
                Replace(result.Provider);
            }

            return (true, null);
        }
        finally
        {
            busyProviderId = null;
        }
    }

    private void Replace(ProviderStatusResponse updated)
    {
        if (providers is null)
        {
            return;
        }

        providers = providers
            .Select(provider => string.Equals(provider.ProviderId, updated.ProviderId, StringComparison.OrdinalIgnoreCase)
                ? updated
                : provider)
            .ToArray();
    }

}
