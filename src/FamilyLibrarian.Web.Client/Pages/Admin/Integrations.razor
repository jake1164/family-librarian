@page "/admin/integrations"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Providers
@using FamilyLibrarian.Contracts.Publishing
@using FamilyLibrarian.Web.Client.Integrations
@using FamilyLibrarian.Web.Client.Publishing
@using Microsoft.AspNetCore.Authorization
@* Named IntegrationsApi, not Integrations: a member may not share the enclosing
   component's type name. *@
@inject MetadataIntegrationsApiClient IntegrationsApi
@inject CwaSettingsApiClient CwaApi
@inject AudiobookshelfSettingsApiClient AudiobookshelfApi
@inject ISnackbar Snackbar

<PageTitle>Metadata integrations | Family Librarian</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Metadata integrations</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Choose which sources Family Librarian searches for book information. API keys are
    stored encrypted and are never shown again after you save them.
</MudText>

@if (loadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the provider settings.</MudAlert>
}
else if (providers is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading providers" />
}
else
{
    <MudStack Spacing="4">
        @foreach (var provider in providers)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6">@provider.DisplayName</MudText>

                    @if (provider.IsExternallyManaged)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            Managed by this deployment
                        </MudChip>
                    }
                    @if (provider.IsMisconfigured)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            Needs an API key
                        </MudChip>
                    }

                    <MudSpacer />

                    @* Keyed on a generation counter, not just ProviderId: MudSwitch flips
                       its own checked-state immediately on click, before the round trip
                       resolves. When the server rejects the change (or, for Remove key,
                       flips a value it wasn't watching), the value it's bound to can end
                       up unchanged or unnoticed from its perspective, and it never syncs
                       back. Forcing a fresh instance after every attempt — success or
                       failure — is what actually guarantees it reflects the true state. *@
                    <MudSwitch T="bool"
                               @key="@($"{provider.ProviderId}:{SwitchGeneration(provider.ProviderId)}")"
                               Value="provider.IsEnabled"
                               ValueChanged="@(enabled => SetEnabledAsync(provider, enabled))"
                               Color="Color.Primary"
                               Disabled="@(provider.IsExternallyManaged || busyProviderId is not null)"
                               Label="@(provider.IsEnabled ? "Enabled" : "Disabled")" />
                </MudStack>

                @if (provider.IsExternallyManaged)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        This provider is configured by the deployment. Change its key and
                        enabled state where the deployment secrets are managed.
                    </MudAlert>
                }
                else if (provider.RequiresCredential)
                {
                    <MudDivider Class="my-3" />

                    @if (!string.IsNullOrWhiteSpace(provider.SetupInstructions) || provider.SetupLinks.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            <MudStack Spacing="1">
                                @if (!string.IsNullOrWhiteSpace(provider.SetupInstructions))
                                {
                                    <MudText Typo="Typo.body2">@provider.SetupInstructions</MudText>
                                }
                                @if (provider.SetupLinks.Count > 0)
                                {
                                    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                                        @foreach (var link in provider.SetupLinks)
                                        {
                                            <MudLink Href="@link.Url" Target="_blank" rel="noopener noreferrer">
                                                @link.Label
                                            </MudLink>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </MudAlert>
                    }

                    <MudText Typo="Typo.subtitle2">API key</MudText>
                    @if (provider.HasStoredCredential)
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">
                            A key ending in <strong>@provider.CredentialHint</strong> was saved
                            @(provider.CredentialSetAtUtc?.ToLocalTime().ToString("f")).
                            Enter a new key to replace it.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">No key is stored yet.</MudText>
                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField T="string"
                                      @bind-Value="credentialDrafts[provider.ProviderId]"
                                      Label="@(provider.HasStoredCredential ? "Replace API key" : "API key")"
                                      InputType="InputType.Password"
                                      Immediate="true"
                                      Disabled="@(busyProviderId is not null)"
                                      Class="flex-grow-1" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(busyProviderId is not null || string.IsNullOrWhiteSpace(credentialDrafts[provider.ProviderId]))"
                                   OnClick="@(() => SaveCredentialAsync(provider))">
                            Save key
                        </MudButton>

                        @if (provider.HasStoredCredential)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Disabled="@(busyProviderId is not null)"
                                       OnClick="@(() => ClearCredentialAsync(provider))">
                                Remove key
                            </MudButton>
                        }
                    </MudStack>
                }

                <MudDivider Class="my-3" />

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(busyProviderId is not null)"
                               OnClick="@(() => TestAsync(provider))">
                        Test connection
                    </MudButton>

                    @if (provider.LastTestedAtUtc is not null)
                    {
                        <MudText Typo="Typo.body2">
                            <MudIcon Icon="@(provider.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                     Color="@(provider.LastTestSucceeded == true ? Color.Success : Color.Error)"
                                     Size="Size.Small" />
                            @provider.LastTestMessage
                            <MudText Typo="Typo.caption" Class="ml-1">
                                (@provider.LastTestedAtUtc.Value.ToLocalTime().ToString("f"))
                            </MudText>
                        </MudText>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

<MudDivider Class="my-6" />
<MudText Typo="Typo.h4" GutterBottom="true">Library publishing destinations</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Where an approved file goes once it passes the security gate. An ebook is
    handed to CWA's ingest folder; an audiobook is uploaded to Audiobookshelf.
    Visit <MudLink Href="admin/library-publishing">Library Publishing</MudLink>
    to see what happened to each one.
</MudText>

@if (cwaLoadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the CWA settings.</MudAlert>
}
else if (cwa is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading CWA settings" />
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">CWA (ebook library)</MudText>
            <MudSpacer />
            <MudSwitch T="bool"
                       @key="@("cwa:" + cwaSwitchGeneration)"
                       Value="cwa.IsEnabled"
                       ValueChanged="@(enabled => SetCwaEnabledAsync(enabled))"
                       Color="Color.Primary"
                       Disabled="@cwaBusy"
                       Label="@(cwa.IsEnabled ? "Enabled" : "Disabled")" />
        </MudStack>

        <MudDivider Class="my-3" />

        <MudSelect T="string" Label="Transport" @bind-Value="cwaTransportMode" Disabled="@cwaBusy">
            <MudSelectItem Value="@("Local")">Local path (same host / mounted share)</MudSelectItem>
            <MudSelectItem Value="@("Sftp")">SFTP (remote host)</MudSelectItem>
        </MudSelect>

        @if (cwaTransportMode == "Local")
        {
            <MudTextField T="string" Label="Ingest folder path" @bind-Value="cwaLocalIngestPath"
                          Disabled="@cwaBusy" Class="mt-3" />
        }
        else
        {
            <MudStack Spacing="3" Class="mt-3">
                <MudTextField T="string" Label="SFTP host" @bind-Value="cwaSftpHost" Disabled="@cwaBusy" />
                <MudNumericField T="int?" Label="SFTP port (default 22)" @bind-Value="cwaSftpPort" Disabled="@cwaBusy" />
                <MudTextField T="string" Label="SFTP username" @bind-Value="cwaSftpUsername" Disabled="@cwaBusy" />
                <MudTextField T="string" Label="Ingest folder path (remote)" @bind-Value="cwaSftpIngestPath" Disabled="@cwaBusy" />

                <MudText Typo="Typo.subtitle2">SFTP private key</MudText>
                <MudText Typo="Typo.body2">
                    @(cwa.HasSftpPrivateKey
                        ? $"A key ending in {cwa.SftpPrivateKeyHint} was saved {cwa.SftpPrivateKeySetAtUtc?.ToLocalTime().ToString("f")}."
                        : "No key is stored yet.")
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudTextField T="string" @bind-Value="cwaSftpPrivateKeyDraft" Label="Replace private key (PEM)"
                                  Lines="4" Disabled="@cwaBusy" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled"
                               Disabled="@(cwaBusy || string.IsNullOrWhiteSpace(cwaSftpPrivateKeyDraft))"
                               OnClick="SaveCwaSftpPrivateKeyAsync">
                        Save key
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField T="string" @bind-Value="cwaSftpPassphraseDraft" Label="Passphrase (optional)"
                                  InputType="InputType.Password" Disabled="@cwaBusy" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled"
                               Disabled="@(cwaBusy || string.IsNullOrWhiteSpace(cwaSftpPassphraseDraft))"
                               OnClick="SaveCwaSftpPassphraseAsync">
                        Save
                    </MudButton>
                    @if (cwa.HasSftpPassphrase)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@cwaBusy"
                                   OnClick="ClearCwaSftpPassphraseAsync">
                            Remove
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        }

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">OPDS catalog (confirms a book actually landed)</MudText>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="OPDS base URL" @bind-Value="cwaOpdsBaseUrl" Disabled="@cwaBusy" />
            <MudTextField T="string" Label="OPDS username" @bind-Value="cwaOpdsUsername" Disabled="@cwaBusy" />
            <MudStack Row="true" Spacing="2">
                <MudTextField T="string" @bind-Value="cwaOpdsPasswordDraft" Label="OPDS password"
                              InputType="InputType.Password" Disabled="@cwaBusy" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled"
                           Disabled="@(cwaBusy || string.IsNullOrWhiteSpace(cwaOpdsPasswordDraft))"
                           OnClick="SaveCwaOpdsPasswordAsync">
                    Save
                </MudButton>
            </MudStack>
        </MudStack>

        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@cwaBusy" OnClick="SaveCwaSettingsAsync">
            Save settings
        </MudButton>

        <MudDivider Class="my-3" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudButton Variant="Variant.Outlined" Disabled="@cwaBusy" OnClick="TestCwaAsync">Test connection</MudButton>
            @if (cwa.LastTestedAtUtc is not null)
            {
                <MudText Typo="Typo.body2">
                    <MudIcon Icon="@(cwa.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                             Color="@(cwa.LastTestSucceeded == true ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    @cwa.LastTestMessage
                </MudText>
            }
        </MudStack>
    </MudPaper>
}

@if (audiobookshelfLoadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the Audiobookshelf settings.</MudAlert>
}
else if (audiobookshelf is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading Audiobookshelf settings" />
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">Audiobookshelf</MudText>
            <MudSpacer />
            <MudSwitch T="bool"
                       @key="@("abs:" + audiobookshelfSwitchGeneration)"
                       Value="audiobookshelf.IsEnabled"
                       ValueChanged="@(enabled => SetAudiobookshelfEnabledAsync(enabled))"
                       Color="Color.Primary"
                       Disabled="@audiobookshelfBusy"
                       Label="@(audiobookshelf.IsEnabled ? "Enabled" : "Disabled")" />
        </MudStack>

        <MudDivider Class="my-3" />
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Base URL" @bind-Value="audiobookshelfBaseUrl" Disabled="@audiobookshelfBusy" />
            <MudTextField T="string" Label="Library ID" @bind-Value="audiobookshelfLibraryId" Disabled="@audiobookshelfBusy" />
            <MudTextField T="string" Label="Folder ID" @bind-Value="audiobookshelfFolderId" Disabled="@audiobookshelfBusy" />
        </MudStack>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">API token</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(audiobookshelf.HasApiToken
                ? $"A token ending in {audiobookshelf.ApiTokenHint} was saved {audiobookshelf.ApiTokenSetAtUtc?.ToLocalTime().ToString("f")}."
                : "No token is stored yet.")
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudTextField T="string" @bind-Value="audiobookshelfApiTokenDraft" Label="Replace API token"
                          InputType="InputType.Password" Disabled="@audiobookshelfBusy" Class="flex-grow-1" />
            <MudButton Variant="Variant.Filled"
                       Disabled="@(audiobookshelfBusy || string.IsNullOrWhiteSpace(audiobookshelfApiTokenDraft))"
                       OnClick="SaveAudiobookshelfApiTokenAsync">
                Save token
            </MudButton>
            @if (audiobookshelf.HasApiToken)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@audiobookshelfBusy"
                           OnClick="ClearAudiobookshelfApiTokenAsync">
                    Remove
                </MudButton>
            }
        </MudStack>

        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@audiobookshelfBusy"
                   OnClick="SaveAudiobookshelfSettingsAsync">
            Save settings
        </MudButton>

        <MudDivider Class="my-3" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudButton Variant="Variant.Outlined" Disabled="@audiobookshelfBusy" OnClick="TestAudiobookshelfAsync">
                Test connection
            </MudButton>
            @if (audiobookshelf.LastTestedAtUtc is not null)
            {
                <MudText Typo="Typo.body2">
                    <MudIcon Icon="@(audiobookshelf.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                             Color="@(audiobookshelf.LastTestSucceeded == true ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    @audiobookshelf.LastTestMessage
                </MudText>
            }
        </MudStack>
    </MudPaper>
}

@code {
    private IReadOnlyList<ProviderStatusResponse>? providers;
    private readonly Dictionary<string, string?> credentialDrafts = new(StringComparer.OrdinalIgnoreCase);
    // Bumped after every enable/credential attempt (see RunAsync), win or lose, so
    // the @key on each provider's MudSwitch forces a fresh instance rather than
    // risking stale optimistic checked-state from a prior click.
    private readonly Dictionary<string, int> switchGenerations = new(StringComparer.OrdinalIgnoreCase);
    private string? busyProviderId;
    private bool loadFailed;

    private int SwitchGeneration(string providerId) => switchGenerations.GetValueOrDefault(providerId);

    protected override Task OnInitializedAsync() =>
        Task.WhenAll(LoadAsync(), LoadCwaAsync(), LoadAudiobookshelfAsync());

    private async Task LoadAsync()
    {
        try
        {
            providers = await IntegrationsApi.GetProvidersAsync();
            foreach (var provider in providers)
            {
                credentialDrafts.TryAdd(provider.ProviderId, null);
            }
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    private async Task SetEnabledAsync(ProviderStatusResponse provider, bool enabled)
    {
        await RunAsync(provider, () => IntegrationsApi.SetEnabledAsync(provider.ProviderId, enabled));
    }

    private async Task SaveCredentialAsync(ProviderStatusResponse provider)
    {
        var credential = credentialDrafts[provider.ProviderId];
        if (string.IsNullOrWhiteSpace(credential))
        {
            return;
        }

        var saved = await RunAsync(
            provider,
            () => IntegrationsApi.SetCredentialAsync(provider.ProviderId, credential));

        if (saved)
        {
            // Drop the plaintext from the component as soon as the host has it,
            // so it does not linger in the rendered field or component state.
            credentialDrafts[provider.ProviderId] = null;
            Snackbar.Add($"Saved the {provider.DisplayName} API key.", Severity.Success);
        }
    }

    private async Task ClearCredentialAsync(ProviderStatusResponse provider)
    {
        if (await RunAsync(provider, () => IntegrationsApi.ClearCredentialAsync(provider.ProviderId)))
        {
            Snackbar.Add($"Removed the {provider.DisplayName} API key.", Severity.Success);
        }
    }

    private async Task TestAsync(ProviderStatusResponse provider)
    {
        busyProviderId = provider.ProviderId;
        try
        {
            var result = await IntegrationsApi.TestAsync(provider.ProviderId);
            if (result is null)
            {
                Snackbar.Add("The connection test could not be run.", Severity.Error);
                return;
            }

            Replace(result.Provider);
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Warning);
        }
        finally
        {
            busyProviderId = null;
        }
    }

    private async Task<bool> RunAsync(
        ProviderStatusResponse provider,
        Func<Task<MetadataIntegrationsResult>> action)
    {
        busyProviderId = provider.ProviderId;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error);
                return false;
            }

            if (result.Provider is not null)
            {
                Replace(result.Provider);
            }

            return true;
        }
        finally
        {
            busyProviderId = null;
            switchGenerations[provider.ProviderId] = SwitchGeneration(provider.ProviderId) + 1;
        }
    }

    private void Replace(ProviderStatusResponse updated)
    {
        if (providers is null)
        {
            return;
        }

        providers = providers
            .Select(provider => string.Equals(provider.ProviderId, updated.ProviderId, StringComparison.OrdinalIgnoreCase)
                ? updated
                : provider)
            .ToArray();
    }

    // --- CWA ---------------------------------------------------------------

    private CwaSettingsResponse? cwa;
    private bool cwaLoadFailed;
    private bool cwaBusy;
    private int cwaSwitchGeneration;
    private string cwaTransportMode = "Local";
    private string? cwaLocalIngestPath;
    private string? cwaSftpHost;
    private int? cwaSftpPort;
    private string? cwaSftpUsername;
    private string? cwaSftpIngestPath;
    private string? cwaSftpPrivateKeyDraft;
    private string? cwaSftpPassphraseDraft;
    private string? cwaOpdsBaseUrl;
    private string? cwaOpdsUsername;
    private string? cwaOpdsPasswordDraft;

    private async Task LoadCwaAsync()
    {
        try
        {
            cwa = await CwaApi.GetAsync();
            ApplyCwaFields(cwa);
        }
        catch (HttpRequestException)
        {
            cwaLoadFailed = true;
        }
    }

    private void ApplyCwaFields(CwaSettingsResponse? settings)
    {
        if (settings is null)
        {
            return;
        }

        cwaTransportMode = settings.TransportMode;
        cwaLocalIngestPath = settings.LocalIngestPath;
        cwaSftpHost = settings.SftpHost;
        cwaSftpPort = settings.SftpPort;
        cwaSftpUsername = settings.SftpUsername;
        cwaSftpIngestPath = settings.SftpIngestPath;
        cwaOpdsBaseUrl = settings.OpdsBaseUrl;
        cwaOpdsUsername = settings.OpdsUsername;
    }

    private Task SetCwaEnabledAsync(bool enabled) => RunCwaAsync(() => CwaApi.SetEnabledAsync(enabled));

    private Task SaveCwaSettingsAsync() => RunCwaAsync(() => CwaApi.SetSettingsAsync(new SetCwaSettingsRequest(
        cwaTransportMode, cwaLocalIngestPath, cwaSftpHost, cwaSftpPort, cwaSftpUsername, cwaSftpIngestPath,
        cwaOpdsBaseUrl, cwaOpdsUsername)));

    private async Task SaveCwaSftpPrivateKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(cwaSftpPrivateKeyDraft))
        {
            return;
        }

        if (await RunCwaAsync(() => CwaApi.SetSftpPrivateKeyAsync(cwaSftpPrivateKeyDraft)))
        {
            cwaSftpPrivateKeyDraft = null;
            Snackbar.Add("Saved the CWA SFTP private key.", Severity.Success);
        }
    }

    private async Task SaveCwaSftpPassphraseAsync()
    {
        if (string.IsNullOrWhiteSpace(cwaSftpPassphraseDraft))
        {
            return;
        }

        if (await RunCwaAsync(() => CwaApi.SetSftpPassphraseAsync(cwaSftpPassphraseDraft)))
        {
            cwaSftpPassphraseDraft = null;
            Snackbar.Add("Saved the SFTP passphrase.", Severity.Success);
        }
    }

    private Task ClearCwaSftpPassphraseAsync() => RunCwaAsync(() => CwaApi.ClearSftpPassphraseAsync());

    private async Task SaveCwaOpdsPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(cwaOpdsPasswordDraft))
        {
            return;
        }

        if (await RunCwaAsync(() => CwaApi.SetOpdsPasswordAsync(cwaOpdsPasswordDraft)))
        {
            cwaOpdsPasswordDraft = null;
            Snackbar.Add("Saved the OPDS password.", Severity.Success);
        }
    }

    private async Task TestCwaAsync()
    {
        cwaBusy = true;
        try
        {
            var result = await CwaApi.TestAsync();
            if (result is null)
            {
                Snackbar.Add("The connection test could not be run.", Severity.Error);
                return;
            }

            await LoadCwaAsync();
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Warning);
        }
        finally
        {
            cwaBusy = false;
        }
    }

    private async Task<bool> RunCwaAsync(Func<Task<CwaResult>> action)
    {
        cwaBusy = true;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error);
                return false;
            }

            cwa = result.Settings;
            ApplyCwaFields(cwa);
            return true;
        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    // --- Audiobookshelf ------------------------------------------------------

    private AudiobookshelfSettingsResponse? audiobookshelf;
    private bool audiobookshelfLoadFailed;
    private bool audiobookshelfBusy;
    private int audiobookshelfSwitchGeneration;
    private string? audiobookshelfBaseUrl;
    private string? audiobookshelfLibraryId;
    private string? audiobookshelfFolderId;
    private string? audiobookshelfApiTokenDraft;

    private async Task LoadAudiobookshelfAsync()
    {
        try
        {
            audiobookshelf = await AudiobookshelfApi.GetAsync();
            ApplyAudiobookshelfFields(audiobookshelf);
        }
        catch (HttpRequestException)
        {
            audiobookshelfLoadFailed = true;
        }
    }

    private void ApplyAudiobookshelfFields(AudiobookshelfSettingsResponse? settings)
    {
        if (settings is null)
        {
            return;
        }

        audiobookshelfBaseUrl = settings.BaseUrl;
        audiobookshelfLibraryId = settings.LibraryId;
        audiobookshelfFolderId = settings.FolderId;
    }

    private Task SetAudiobookshelfEnabledAsync(bool enabled) =>
        RunAudiobookshelfAsync(() => AudiobookshelfApi.SetEnabledAsync(enabled));

    private Task SaveAudiobookshelfSettingsAsync() => RunAudiobookshelfAsync(() => AudiobookshelfApi.SetSettingsAsync(
        new SetAudiobookshelfSettingsRequest(audiobookshelfBaseUrl, audiobookshelfLibraryId, audiobookshelfFolderId)));

    private async Task SaveAudiobookshelfApiTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(audiobookshelfApiTokenDraft))
        {
            return;
        }

        if (await RunAudiobookshelfAsync(() => AudiobookshelfApi.SetApiTokenAsync(audiobookshelfApiTokenDraft)))
        {
            audiobookshelfApiTokenDraft = null;
            Snackbar.Add("Saved the Audiobookshelf API token.", Severity.Success);
        }
    }

    private Task ClearAudiobookshelfApiTokenAsync() => RunAudiobookshelfAsync(() => AudiobookshelfApi.ClearApiTokenAsync());

    private async Task TestAudiobookshelfAsync()
    {
        audiobookshelfBusy = true;
        try
        {
            var result = await AudiobookshelfApi.TestAsync();
            if (result is null)
            {
                Snackbar.Add("The connection test could not be run.", Severity.Error);
                return;
            }

            await LoadAudiobookshelfAsync();
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Warning);
        }
        finally
        {
            audiobookshelfBusy = false;
        }
    }

    private async Task<bool> RunAudiobookshelfAsync(Func<Task<AudiobookshelfResult>> action)
    {
        audiobookshelfBusy = true;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error);
                return false;
            }

            audiobookshelf = result.Settings;
            ApplyAudiobookshelfFields(audiobookshelf);
            return true;
        }
        finally
        {
            audiobookshelfBusy = false;
            audiobookshelfSwitchGeneration++;
        }
    }
}
