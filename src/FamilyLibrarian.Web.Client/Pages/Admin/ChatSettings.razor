@page "/settings/chat"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Conversation
@using FamilyLibrarian.Web.Client.Conversation
@inject ChatSettingsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Chat assistant settings | Family Librarian</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">Chat assistant</MudText>
        <MudText Typo="Typo.body1">
            Let people ask for books in plain language. Chat uses the same permissions and request approval as the rest of
            Family Librarian. A change here applies to the next message; nothing needs to be restarted.
        </MudText>
    </div>

    @if (loadFailed)
    {
        <MudAlert Severity="Severity.Error" role="alert">We could not load the chat settings. Refresh to try again.</MudAlert>
    }
    else if (settings is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading chat settings" />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h6">Web chat is @(settings.WebEnabled ? "on" : "off")</MudText>
                    <MudText Typo="Typo.body2">Adds a Chat page to the menu for everyone who is signed in.</MudText>
                </div>
                <SettingSwitch Value="settings.WebEnabled" Changing="SetWebAsync" Disabled="@busy" AlignEnd="true" Class="flex-shrink-0"
                               Label="@(settings.WebEnabled ? "Enabled" : "Disabled")" aria-label="Web chat" />
            </MudStack>
            @if (settings.WebEnabled)
            {
                <MudLink Href="chat" Class="mt-2 d-inline-block">Open chat</MudLink>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h6">Matrix chat is @(settings.MatrixEnabled ? "on" : "off")</MudText>
                    <MudText Typo="Typo.body2">
                        Lets people chat with the Matrix bot in an unencrypted direct message. Each person first links their own
                        account under <MudLink Href="settings/matrix">Message the Librarian</MudLink> in the settings menu.
                    </MudText>
                </div>
                <SettingSwitch Value="settings.MatrixEnabled" Changing="SetMatrixAsync" Disabled="@busy" AlignEnd="true" Class="flex-shrink-0"
                               Label="@(settings.MatrixEnabled ? "Enabled" : "Disabled")" aria-label="Matrix chat" />
            </MudStack>
            @if (!settings.MatrixConnectionReady)
            {
                <MudAlert Severity="@(settings.MatrixEnabled ? Severity.Warning : Severity.Info)" Class="mt-3">
                    The Matrix bot connection isn't set up and enabled, so Matrix chat can't answer yet. Set it up in
                    <MudLink Href="settings/communications">Communications</MudLink>.
                </MudAlert>
            }
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Chat works without AI. To let a model help with messages the built-in rules don't recognize, set up
            <MudLink Href="admin/model-gateway">AI models</MudLink>.
        </MudAlert>
    }
</MudStack>

@code {
    private ChatSettingsResponse? settings;
    private bool loadFailed, busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await Api.GetAsync();
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    private Task SetWebAsync(SettingSwitchChange change) =>
        SaveAsync(change, new SetChatSettingsRequest(WebEnabled: change.Value), "Web chat");

    private Task SetMatrixAsync(SettingSwitchChange change) =>
        SaveAsync(change, new SetChatSettingsRequest(MatrixEnabled: change.Value), "Matrix chat");

    private async Task SaveAsync(SettingSwitchChange change, SetChatSettingsRequest request, string name)
    {
        busy = true;
        try
        {
            var saved = await Api.SaveAsync(request);
            if (saved is null)
            {
                change.Refuse("That change could not be saved.");
                return;
            }

            settings = saved;
            Snackbar.Saved($"{name} turned {(change.Value ? "on" : "off")}.");
        }
        finally
        {
            busy = false;
        }
    }
}
