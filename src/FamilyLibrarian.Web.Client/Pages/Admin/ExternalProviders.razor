    private bool GutenbergCatalogIsSynchronizing => gutenbergCatalogRefreshInProgress ||
        IsGutenbergCatalogOperationStatus(gutenbergCatalogStatus?.Status);

    private bool GutenbergCatalogIsPurging => gutenbergCatalogPurgeInProgress ||
        gutenbergCatalogStatus?.Status == "Purging";

    private bool GutenbergCatalogOperationInProgress => GutenbergCatalogIsSynchronizing || GutenbergCatalogIsPurging;

    private bool GutenbergCatalogHasRecords => gutenbergCatalogStatus?.BookCount > 0;

    private string GutenbergCatalogStateLabel => GutenbergCatalogIsPurging
        ? "Deleting records"
        : gutenbergCatalogRefreshInProgress
        ? "Refreshing"
        : gutenbergCatalogStatus?.Status switch
        {
            "CheckingUpdates" => "Checking changes",
            "Downloading" => "Downloading",
            "Parsing" => "Parsing",
            "Importing" => "Importing",
            "Retrying" => "Retrying",
            "Completed" when gutenbergCatalogStatus.IsReady => "Ready",
            "Failed" => "Refresh failed",
            "NeverSynced" => "Not downloaded",
            _ => gutenbergCatalogStatus?.Status ?? "Checking"
        };

    private Color GutenbergCatalogStateColor => GutenbergCatalogIsPurging
        ? Color.Info
        : gutenbergCatalogRefreshInProgress
        ? Color.Info
        : gutenbergCatalogStatus?.Status switch
        {
            "CheckingUpdates" or "Downloading" or "Parsing" or "Importing" => Color.Info,
            "Retrying" => Color.Warning,
            "Completed" when gutenbergCatalogStatus.IsReady => Color.Success,
            "Failed" => Color.Error,
            _ => Color.Warning
        };

    private string GutenbergCatalogSummary => GutenbergCatalogIsPurging
        ? "Deleting the local catalogue. Search records will be removed when this operation completes."
        : gutenbergCatalogRefreshInProgress
        ? gutenbergCatalogStatus?.IsReady == true
            ? "Refreshing the local catalogue. The existing local snapshot remains searchable."
            : "Refreshing the first local catalogue. Searches will be available after validation completes."
        : gutenbergCatalogStatus?.Status switch
        {
            "CheckingUpdates" => gutenbergCatalogStatus.IsReady
                ? "Checking Project Gutenberg's daily new-and-updated-books feed. The local catalogue remains searchable."
                : "Checking Project Gutenberg for the first local catalogue update.",
            "Downloading" => gutenbergCatalogStatus.IsReady
                ? "Downloading an updated catalogue. The existing local snapshot remains searchable."
                : "Downloading the first local catalogue. Searches will be available after validation completes.",
            "Parsing" or "Importing" => gutenbergCatalogStatus.IsReady
                ? "Building an updated catalogue. The existing local snapshot remains searchable."
                : "Building the first local catalogue. Searches will be available after validation completes.",
            "Retrying" => gutenbergCatalogStatus.IsReady
                ? "Retrying the refresh after a transient archive error. The existing local snapshot remains searchable."
                : "Retrying the first catalogue download after a transient archive error.",
            "Failed" when gutenbergCatalogStatus.IsReady =>
                "The latest refresh failed, but the previous local catalogue is still searchable.",
            "Failed" => "The local catalogue is unavailable until a refresh succeeds.",
            "Completed" when gutenbergCatalogStatus.IsReady => "The local catalogue is ready for automatic request lookup.",
            _ => "The local catalogue has not been downloaded yet."
        };

    private string GutenbergImportProgressSummary => gutenbergCatalogStatus is not { } status
        ? "Waiting for the catalogue importer to report its first progress update."
        : $"Imported so far: {status.InProgressBookCount:N0} books · {status.InProgressFormatCount:N0} formats. " +
          (status.LastProgressUtc is { } progressedAt
              ? $"Last progress: {progressedAt.ToLocalTime():g}."
              : "No progress timestamp is available yet.");

    private string GutenbergAvailableRecords => gutenbergCatalogStatus is { IsReady: true } status
        ? $"{status.BookCount:N0} books · {status.FormatCount:N0} formats"
        : "No searchable local records yet";

    private string GutenbergLastSuccessfulDownload => gutenbergCatalogStatus?.LastSuccessfulSyncUtc is { } downloadedAt
        ? downloadedAt.ToLocalTime().ToString("g")
        : "Never";

    private Severity GutenbergCatalogMessageSeverity =>
        gutenbergCatalogStatus?.Status == "Retrying" ? Severity.Warning : Severity.Error;

    private string GutenbergCatalogMessageTitle =>
        gutenbergCatalogStatus?.Status == "Retrying" ? "Refresh retrying" : "Latest refresh failed";

    private string GutenbergLastAttempt => gutenbergCatalogStatus?.LastAttemptUtc is { } attemptedAt
        ? attemptedAt.ToLocalTime().ToString("g")
        : "Never";

    private async Task LoadGutenbergCatalogStatusAsync()
    {
        try
        {
            gutenbergCatalogStatus = await GutenbergCatalog.GetStatusAsync();
            gutenbergCatalogStatusUnavailable = false;
            StartGutenbergCatalogStatusPollingIfNeeded();
        }
        catch (HttpRequestException)
        {
            // Source settings remain usable while the informational status is unavailable.
            gutenbergCatalogStatusUnavailable = true;
        }
    }

    private void StartGutenbergCatalogStatusPollingIfNeeded()
    {
        if (!GutenbergCatalogOperationInProgress ||
            gutenbergCatalogStatusPollingTask is { IsCompleted: false } ||
            isDisposed)
        {
            return;
        }

        gutenbergCatalogStatusPollingTask = PollGutenbergCatalogStatusAsync();
    }

    private async Task PollGutenbergCatalogStatusAsync()
    {
        try
        {
            while (!gutenbergCatalogStatusPollingCancellation.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), gutenbergCatalogStatusPollingCancellation.Token);
                var status = await GutenbergCatalog.GetStatusAsync(gutenbergCatalogStatusPollingCancellation.Token);
                await InvokeAsync(() =>
                {
                    if (isDisposed)
                    {
                        return;
                    }

                    gutenbergCatalogStatus = status;
                    gutenbergCatalogStatusUnavailable = false;
                    StateHasChanged();
                });

                if (!IsGutenbergCatalogOperationStatus(status?.Status))
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (gutenbergCatalogStatusPollingCancellation.IsCancellationRequested)
        {
            // Page navigation stops this page's display polling; the server-side
            // purge itself continues and the next visit resumes from its status.
        }
        catch (HttpRequestException)
        {
            await InvokeAsync(() =>
            {
                if (!isDisposed)
                {
                    gutenbergCatalogStatusUnavailable = true;
                    StateHasChanged();
                }
            });
        }
    }

    private async Task RefreshGutenbergCatalogAsync()
    {
        gutenbergCatalogBusy = true;
        gutenbergCatalogRefreshInProgress = true;
        StartGutenbergCatalogStatusPollingIfNeeded();
        try
        {
            var result = await GutenbergCatalog.RefreshAsync();
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "The Project Gutenberg catalogue could not be refreshed.", Severity.Error);
                await LoadGutenbergCatalogStatusAsync();
                return;
            }

            gutenbergCatalogStatus = result.Status;
            gutenbergCatalogStatusUnavailable = false;
            Snackbar.Add("Project Gutenberg catalogue refreshed.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The Project Gutenberg catalogue could not be refreshed.", Severity.Error);
            await LoadGutenbergCatalogStatusAsync();
        }
        finally
        {
            gutenbergCatalogRefreshInProgress = false;
            gutenbergCatalogBusy = false;
        }
    }

    private void BeginGutenbergCatalogPurge() => gutenbergCatalogPurgeConfirmation = true;

    private void CancelGutenbergCatalogPurge() => gutenbergCatalogPurgeConfirmation = false;

    private async Task PurgeGutenbergCatalogAsync()
    {
        gutenbergCatalogBusy = true;
        gutenbergCatalogPurgeInProgress = true;
        try
        {
            var result = await GutenbergCatalog.PurgeAsync();
            if (isDisposed)
            {
                return;
            }

            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "The local Project Gutenberg catalogue could not be deleted.", Severity.Error);
                await LoadGutenbergCatalogStatusAsync();
                return;
            }

            await LoadGutenbergCatalogStatusAsync();
            gutenbergCatalogPurgeConfirmation = false;
            Snackbar.Add($"Deleted {result.DeletedBookCount:N0} Project Gutenberg catalogue records.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            if (!isDisposed)
            {
                Snackbar.Add("The local Project Gutenberg catalogue could not be deleted.", Severity.Error);
                await LoadGutenbergCatalogStatusAsync();
            }
        }
        finally
        {
            if (!isDisposed)
            {
                gutenbergCatalogPurgeInProgress = false;
                gutenbergCatalogBusy = false;
            }
        }
    }

    public void Dispose()
    {
        isDisposed = true;
        gutenbergCatalogStatusPollingCancellation.Cancel();
        gutenbergCatalogStatusPollingCancellation.Dispose();
