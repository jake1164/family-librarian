@page "/settings/sources"
@attribute [Authorize(Roles = "Admin")]
@inherits LiveComponentBase
@using FamilyLibrarian.Contracts.Providers
@using FamilyLibrarian.Web.Client.Gutenberg
@using FamilyLibrarian.Web.Client.Integrations
@using FamilyLibrarian.Web.Client.Providers
@using Microsoft.AspNetCore.Authorization
@inject ExternalProviderApiClient Api
@inject MetadataIntegrationsApiClient BuiltInSourcesApi
@inject AdminRequestsApiClient AdminRequests
@inject GutenbergCatalogApiClient GutenbergCatalog
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Sources | Family Librarian</PageTitle>
<SettingsDraftGuard IsDirty="@(HasUnsavedChanges)" />

<MudText Typo="Typo.h4" GutterBottom="true">Sources</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Configure book-acquisition sources. Built-in sources and registered external
    sources stay here because they supply books; they do not enrich metadata or
    receive published files.
</MudText>

<MudPaper Class="pa-4 mb-6" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Built-in sources</MudText>
    @if (sourceLoadFailed)
    {
        <MudAlert Severity="Severity.Error">We could not load the built-in source settings.</MudAlert>
    }
    else if (builtInSources is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="Loading built-in sources" />
    }
    else
    {
        @foreach (var source in builtInSources)
        {
            var configurationIssue = ProviderIssueFor(source.ProviderId, "Configuration");
            var operationalIssue = ProviderIssueFor(source.ProviderId, "Operational");
            <MudPaper Outlined="true" Class="pa-3 mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@source.DisplayName</MudText>
                    <SettingSwitch Value="source.IsEnabled" AlignEnd="true"
                                   Changing="@(change => SetBuiltInSourceEnabledAsync(source, change))"
                                   Disabled="@(builtInSourcesBusy || source.IsExternallyManaged)"
                                   Label="@(source.IsEnabled ? "Enabled" : "Disabled")" aria-label="@source.DisplayName" />
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-2">
                    @if (source.ProviderId == "gutendex")
                    {
                        <span>Searches the locally imported Project Gutenberg catalogue; downloads use configured mirrors when a family request is fulfilled.</span>
                    }
                    else if (source.ProviderId == "librivox")
                    {
                        <span>Searches the live LibriVox audiobook catalog; selected recordings are downloaded as a whole-book ZIP and validated as MP3 tracks.</span>
                    }
                    else
                    {
                        <span>Provides direct acquisition options during fulfillment.</span>
                    }
                </MudText>
                @if (source.ProviderId == "gutendex")
                {
                    <MudPaper Outlined="true" Class="pa-3 mt-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Local catalogue status</MudText>
                            @if (gutenbergCatalogStatus is not null)
                            {
                                <GutenbergCatalogStatusChip Status="@gutenbergCatalogStatus.Status" />
                            }
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@(!source.IsEnabled || gutenbergCatalogBusy || GutenbergCatalogOperationInProgress)"
                                       OnClick="RefreshGutenbergCatalogAsync">
                                @(gutenbergCatalogBusy || GutenbergCatalogIsSynchronizing ? "Refreshing…" : "Refresh now")
                            </MudButton>
                        </MudStack>

                        @if (gutenbergCatalogStatusUnavailable)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                                The catalogue status could not be loaded. Refresh the page and try again.
                            </MudAlert>
                        }
                        else if (gutenbergCatalogStatus is null)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" aria-label="Loading local catalogue status" />
                        }
                        else
                        {
                            @if (gutenbergCatalogStatus.IsWorking)
                            {
                                <GutenbergCatalogProgress Status="gutenbergCatalogStatus" />
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@GutenbergCatalogSummary</MudText>
                            }
                            <MudGrid Class="mt-1">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption">Available locally</MudText>
                                    <MudText Typo="Typo.body2">@GutenbergAvailableRecords</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption">Last full catalogue download</MudText>
                                    <MudText Typo="Typo.body2">@GutenbergLastSuccessfulDownload</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption">Last successful check</MudText>
                                    <MudText Typo="Typo.body2">@(gutenbergCatalogStatus.LastSuccessfulCheckUtc?.ToLocalTime().ToString("g") ?? "Never")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption">Latest refresh attempt</MudText>
                                    <MudText Typo="Typo.body2">@GutenbergLastAttempt</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (!string.IsNullOrWhiteSpace(gutenbergCatalogStatus.FailureMessage))
                            {
                                <MudAlert Severity="@GutenbergCatalogMessageSeverity" Variant="Variant.Outlined" Class="mt-2">
                                    <MudText Typo="Typo.subtitle2">@GutenbergCatalogMessageTitle</MudText>
                                    <MudText Typo="Typo.body2">@gutenbergCatalogStatus.FailureMessage</MudText>
                                    @if (gutenbergCatalogStatus.IsReady)
                                    {
                                        <MudText Typo="Typo.caption">The last successful local catalogue remains available for searches.</MudText>
                                    }
                                </MudAlert>
                            }
                        }
                    </MudPaper>
                    @if (!source.IsEnabled)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Turning this source off retains the downloaded catalogue but stops automatic lookup and daily refreshes.
                        </MudText>
                        @if (GutenbergCatalogIsPurging)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                                <MudText Typo="Typo.body2">Deleting local catalogue records. This page will update when deletion completes.</MudText>
                            </MudAlert>
                        }
                        else if (GutenbergCatalogHasRecords && gutenbergCatalogPurgeConfirmation)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                                <MudText Typo="Typo.body2">
                                    Delete the local Project Gutenberg catalogue? This permanently removes the imported catalogue records, not requests or provider activity.
                                </MudText>
                                <MudStack Row="true" Spacing="2" Class="mt-2">
                                    <MudButton Variant="Variant.Outlined" Disabled="@gutenbergCatalogBusy"
                                               OnClick="CancelGutenbergCatalogPurge">
                                        Keep catalogue
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(gutenbergCatalogBusy || GutenbergCatalogOperationInProgress)"
                                               OnClick="PurgeGutenbergCatalogAsync">
                                        @(gutenbergCatalogBusy ? "Deleting…" : "Delete local catalogue")
                                    </MudButton>
                                </MudStack>
                            </MudAlert>
                        }
                        else if (GutenbergCatalogHasRecords)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="mt-2"
                                       Disabled="@(gutenbergCatalogBusy || GutenbergCatalogOperationInProgress)"
                                       OnClick="BeginGutenbergCatalogPurge">
                                Delete local catalogue
                            </MudButton>
                        }
                    }
                }
                @if (configurationIssue is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                        <MudText Typo="Typo.subtitle2">Configuration needs attention</MudText>
                        <MudText Typo="Typo.body2">@configurationIssue.Summary</MudText>
                        <MudText Typo="Typo.caption">
                            Last blocked automatic lookup: @configurationIssue.OccurredAtUtc.ToLocalTime().ToString("g").
                            Review this source's settings and the acquisition policy before rechecking affected requests.
                        </MudText>
                    </MudAlert>
                }
                @if (operationalIssue is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                        <MudText Typo="Typo.subtitle2">Latest automatic lookup failed</MudText>
                        <MudText Typo="Typo.body2">@operationalIssue.Summary</MudText>
                        <MudText Typo="Typo.caption">
                            Last operational failure: @operationalIssue.OccurredAtUtc.ToLocalTime().ToString("g").
                            This is separate from source configuration; the source will be tried again when eligible.
                        </MudText>
                    </MudAlert>
                }
                @if (configurationIssue is null && operationalIssue is null && source.IsEnabled)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">
                        Automatic lookup is enabled for new ebook requests. This stable public-domain source is checked once per request cycle.
                    </MudText>
                }
                else if (configurationIssue is null && operationalIssue is null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">
                        Automatic lookup is disabled for this source.
                    </MudText>
                }
                @if (!string.IsNullOrWhiteSpace(source.SetupInstructions) || source.SetupLinks.Count > 0)
                {
                    <MudStack Spacing="1" Class="mt-2">
                        @if (!string.IsNullOrWhiteSpace(source.SetupInstructions))
                        {
                            <MudText Typo="Typo.body2">@source.SetupInstructions</MudText>
                        }
                        @if (source.SetupLinks.Count > 0)
                        {
                            <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                                @foreach (var link in source.SetupLinks)
                                {
                                    <MudLink Href="@link.Url" Target="_blank" rel="noopener noreferrer">
                                        @link.Label
                                    </MudLink>
                                }
                            </MudStack>
                        }
                    </MudStack>
                }
                @if (source.LastTestedAtUtc is not null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">@source.LastTestMessage</MudText>
                }
            </MudPaper>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-6" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">External sources</MudText>
    <ProviderConfidenceReviewNotice Providers="providers" />

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField Immediate="true" T="string" Label="Provider id" @bind-Value="newProviderId" Disabled="@providersBusy" />
        <MudTextField Immediate="true" T="string" Label="Display name" @bind-Value="newProviderDisplayName" Disabled="@providersBusy" />
        <MudTextField Immediate="true" T="string" Label="Base URL" @bind-Value="newProviderBaseUrl" Disabled="@providersBusy" Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(providersBusy || !CanRegister)" OnClick="RegisterProviderAsync">
            Register
        </MudButton>
    </MudStack>

    @if (providers is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
    }
    else if (providers.Count == 0)
    {
        <MudText Typo="Typo.body2">No external providers registered.</MudText>
    }
    else
    {
        @foreach (var provider in providers)
        {
            var configurationIssue = ProviderIssueFor(provider.ProviderId, "Configuration");
            var operationalIssue = ProviderIssueFor(provider.ProviderId, "Operational");
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">@provider.DisplayName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@provider.ProviderId</MudChip>
                    <SettingSwitch Value="provider.IsEnabled" AlignEnd="true" Disabled="@providersBusy"
                                   Changing="@(change => SetProviderEnabledAsync(provider.Id, change))"
                                   Label="@(provider.IsEnabled ? "Enabled" : "Disabled")" aria-label="@provider.DisplayName" />
                </MudStack>

                @if (configurationIssue is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                        <MudText Typo="Typo.subtitle2">Configuration needs attention</MudText>
                        <MudText Typo="Typo.body2">@configurationIssue.Summary</MudText>
                        <MudText Typo="Typo.caption">Blocked @configurationIssue.OccurredAtUtc.ToLocalTime().ToString("g").</MudText>
                    </MudAlert>
                }
                @if (operationalIssue is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                        <MudText Typo="Typo.subtitle2">Latest automatic recheck failed</MudText>
                        <MudText Typo="Typo.body2">@operationalIssue.Summary</MudText>
                        <MudText Typo="Typo.caption">Failed @operationalIssue.OccurredAtUtc.ToLocalTime().ToString("g").</MudText>
                    </MudAlert>
                }

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Automatic rechecks</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Choose how often this source should look again for unfulfilled requests. New sources start at Daily.
                    The download confidence below decides which copies may be downloaded without a person.
                </MudText>
                <MudText Typo="Typo.caption" Class="mb-2">
                    This does not affect the health/search/acquire chips below — Family Librarian checks this
                    provider's reachability on its own fixed interval regardless of this setting, including when
                    set to Manual.
                </MudText>
                <MudSelect T="string" Label="Recheck schedule" @bind-Value="GetDraft(provider).Schedule"
                           Disabled="@(providersBusy || !provider.IsEnabled)" Class="mb-2">
                    <MudSelectItem T="string" Value="@("Manual")">Manual — do not retry automatically</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Daily")">Daily</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Weekly")">Weekly</MudSelectItem>
                </MudSelect>
                @if (!provider.IsEnabled)
                {
                    <MudText Typo="Typo.caption">Enable this source to allow its selected recheck schedule to run.</MudText>
                }

                <MudNumericField T="int" @bind-Value="GetDraft(provider).AttemptLimit" Disabled="@providersBusy"
                                 Min="1" Max="10" Step="1" Immediate="true"
                                 Label="Candidates to try before asking a librarian" />
                <MudSelect T="string" Label="Download confidence" @bind-Value="GetDraft(provider).Level"
                           Disabled="providersBusy" Class="mt-2 mb-2">
                    @foreach (var level in ConfidenceLevels)
                    {
                        <MudSelectItem T="string" Value="@level">@ConfidenceLabel(level) — @ConfidenceDescription(level)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Ebook confidence override" @bind-Value="GetDraft(provider).Ebook"
                           Disabled="providersBusy" Class="mb-2">
                    <MudSelectItem T="string" Value="@("Inherit")">Use source confidence</MudSelectItem>
                    @foreach (var level in ConfidenceLevels)
                    {
                        <MudSelectItem T="string" Value="@level">@ConfidenceLabel(level) — @ConfidenceDescription(level)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Audiobook confidence override" @bind-Value="GetDraft(provider).Audiobook"
                           Disabled="providersBusy" Class="mb-2">
                    <MudSelectItem T="string" Value="@("Inherit")">Use source confidence</MudSelectItem>
                    @foreach (var level in ConfidenceLevels)
                    {
                        <MudSelectItem T="string" Value="@level">@ConfidenceLabel(level) — @ConfidenceDescription(level)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.body2" Class="mb-2">
                    When an automatically downloaded copy fails its post-download checks — malware, a malformed
                    file, or content that turns out not to be the requested book — FL rules that copy out and tries
                    the next best candidate, up to this many times. Set this to 1 for a source with a limited
                    download allowance: FL cannot see a provider's remaining quota, so this is the only limit it can
                    enforce. A candidate a requester set aside with "keep looking" is free and never counts here.
                </MudText>

                <MudText Typo="Typo.caption" Class="mb-2">
                    Provider-specific options (for example how a source uses its own quota or download methods) are
                    managed in the provider's own admin page, linked below when the provider offers one.
                </MudText>

                <MudTextField Immediate="true" T="string" Label="Base URL" Class="mt-2" Disabled="@providersBusy"
                              Value="@baseUrlDrafts.GetValueOrDefault(provider.Id, provider.BaseUrl)"
                              ValueChanged="@(value => baseUrlDrafts[provider.Id] = value)" />

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">API key</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    @(provider.HasApiKey
                        ? $"A key ending in {provider.ApiKeyHint} was saved {provider.ApiKeySetAtUtc?.ToLocalTime().ToString("f")}."
                        : "No key is stored yet.")
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudTextField Immediate="true" T="string" Value="@GetApiKeyDraft(provider.Id)"
                                  ValueChanged="@(value => apiKeyDrafts[provider.Id] = value)" Label="Replace API key"
                                  InputType="InputType.Password" Disabled="@providersBusy" Class="flex-grow-1" />
                    @if (provider.HasApiKey)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@providersBusy"
                                   OnClick="@(() => ClearApiKeyAsync(provider))">
                            Remove
                        </MudButton>
                    }
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@providersBusy"
                               OnClick="@(() => SaveProviderAsync(provider))">
                        Save settings
                    </MudButton>
                    @if (IsCardDirty(provider))
                    {
                        <MudText Typo="Typo.caption" role="status">You have unsaved changes to this source.</MudText>
                    }
                </MudStack>

                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudButton Variant="Variant.Outlined" Disabled="@providersBusy" OnClick="@(() => TestProviderAsync(provider.Id))">
                        Test connection
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@providersBusy"
                               OnClick="@(() => RemoveProviderAsync(provider))">
                        Remove provider
                    </MudButton>
                </MudStack>
                @if (IsCardDirty(provider))
                {
                    <MudText Typo="Typo.caption">Test connection checks the saved settings. Save your changes first.</MudText>
                }

                @if (provider.LastTestedAtUtc is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <MudIcon Icon="@(provider.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                 Color="@(provider.LastTestSucceeded == true ? Color.Success : Color.Error)"
                                 Size="Size.Small" />
                        @provider.LastTestMessage
                    </MudText>
                    @if (provider.CachedProtocolVersion is not null || provider.CachedHealthStatus is not null)
                    {
                        @* Health/Search/Acquire can now refresh independently of a full
                           Test Connection (ExternalProviderRecheckService's own scheduled
                           probe), so this no longer gates on LastTestSucceeded -- a
                           provider whose last check found it degraded must still show
                           these chips, not just the summary line above. Each chip already
                           guards on its own underlying cached value being present. *@
                        <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
                            @if (provider.CachedProtocolVersion is not null)
                            {
                                <MudChip T="string" Size="Size.Small">Protocol v@(provider.CachedProtocolVersion)</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(provider.CachedProviderVersion))
                            {
                                <MudChip T="string" Size="Size.Small">Version @(provider.CachedProviderVersion)</MudChip>
                            }
                            @if (provider.CachedHealthStatus is not null)
                            {
                                <MudTooltip Text="@(AllReasons(provider) ?? string.Empty)" Disabled="@(AllReasons(provider) is null)">
                                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(provider.CachedHealthStatus)">
                                        Health: @provider.CachedHealthStatus
                                    </MudChip>
                                </MudTooltip>
                            }
                            @if (provider.CachedSearchOperationStatus is not null)
                            {
                                <MudTooltip Text="@(ReasonFor(provider, "search") ?? string.Empty)" Disabled="@(ReasonFor(provider, "search") is null)">
                                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(provider.CachedSearchOperationStatus)">
                                        Search: @provider.CachedSearchOperationStatus
                                    </MudChip>
                                </MudTooltip>
                            }
                            @if (provider.CachedAcquireOperationStatus is not null)
                            {
                                <MudTooltip Text="@(ReasonFor(provider, "acquire") ?? string.Empty)" Disabled="@(ReasonFor(provider, "acquire") is null)">
                                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(provider.CachedAcquireOperationStatus)">
                                        Acquire: @provider.CachedAcquireOperationStatus
                                    </MudChip>
                                </MudTooltip>
                            }
                            @foreach (var (group, capability) in ParseCapabilities(provider.CachedCapabilities))
                            {
                                <MudTooltip Text="@group" Disabled="@(group.Length == 0)">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@capability</MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                        <ProviderHealthIssueList Issues="@provider.CachedHealthIssues" />
                        @if (!string.IsNullOrWhiteSpace(provider.CachedInstanceId))
                        {
                            <MudText Typo="Typo.caption" Class="mt-1">
                                Instance: @provider.CachedInstanceId
                            </MudText>
                        }
                        @if (provider.InstanceReplacedSincePreviousTest)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2" Dense="true">
                                This provider reported a different instance id than its previous test — the
                                underlying deployment was likely replaced. Any acquisition job already tracked
                                against the old instance may no longer resolve.
                            </MudAlert>
                        }
                        @if (IsSafeExternalUrl(provider.CachedManagementUrl) || IsSafeExternalUrl(provider.CachedDocumentationUrl))
                        {
                            <MudStack Row="true" Spacing="3" Class="mt-1" Wrap="Wrap.Wrap">
                                @if (IsSafeExternalUrl(provider.CachedManagementUrl))
                                {
                                    <MudLink Href="@provider.CachedManagementUrl" Target="_blank" rel="noopener noreferrer">
                                        Configure provider
                                    </MudLink>
                                }
                                @if (IsSafeExternalUrl(provider.CachedDocumentationUrl))
                                {
                                    <MudLink Href="@provider.CachedDocumentationUrl" Target="_blank" rel="noopener noreferrer">
                                        Documentation
                                    </MudLink>
                                }
                            </MudStack>
                        }
                    }
                }
            </MudPaper>
        }
    }
</MudPaper>

@code {
    private bool HasUnsavedChanges => !string.IsNullOrEmpty(newProviderId) ||
        !string.IsNullOrEmpty(newProviderDisplayName) || !string.IsNullOrEmpty(newProviderBaseUrl) ||
        providers?.Any(IsCardDirty) == true;

    /// <summary>Whether anything on one source's card differs from what is saved.</summary>
    private bool IsCardDirty(ExternalProviderResponse provider) =>
        !string.IsNullOrEmpty(GetApiKeyDraft(provider.Id)) ||
        (baseUrlDrafts.TryGetValue(provider.Id, out var url) && url != provider.BaseUrl) ||
        // Compared with what the draft was started from, so a change made elsewhere is not mistaken for an edit here.
        (providerDrafts.TryGetValue(provider.Id, out var draft) && !draft.Matches(draftSources[provider.Id]));

    private IReadOnlyList<ExternalProviderResponse>? providers;
    private static readonly string[] ConfidenceLevels = ["Strict", "Standard", "Liberal", "SuggestOnly"];
    private readonly Dictionary<Guid, ProviderDraft> providerDrafts = [];

    private sealed class ProviderDraft(ExternalProviderResponse provider)
    {
        public string Level { get; set; } = provider.ConfidenceLevel;
        public string Ebook { get; set; } = provider.EbookConfidenceLevel ?? "Inherit";
        public string Audiobook { get; set; } = provider.AudiobookConfidenceLevel ?? "Inherit";
        public string Schedule { get; set; } = provider.RecheckSchedule;
        public int AttemptLimit { get; set; } = provider.AutomaticAttemptLimit;

        public bool ConfidenceMatches(ExternalProviderResponse saved) =>
            Level == saved.ConfidenceLevel && Ebook == (saved.EbookConfidenceLevel ?? "Inherit") &&
            Audiobook == (saved.AudiobookConfidenceLevel ?? "Inherit");

        public bool Matches(ExternalProviderResponse saved) =>
            ConfidenceMatches(saved) && Schedule == saved.RecheckSchedule && AttemptLimit == saved.AutomaticAttemptLimit;
    }

    // A card nobody has edited follows the host, so a change made elsewhere shows up on the next live update.
    private readonly Dictionary<Guid, ExternalProviderResponse> draftSources = [];

    private ProviderDraft GetDraft(ExternalProviderResponse provider)
    {
        if (!providerDrafts.TryGetValue(provider.Id, out var draft) ||
            (!ReferenceEquals(draftSources[provider.Id], provider) && draft.Matches(draftSources[provider.Id])))
        {
            providerDrafts[provider.Id] = draft = new(provider);
        }

        draftSources[provider.Id] = provider;
        return draft;
    }

    private static string ConfidenceLabel(string level) => level == "SuggestOnly" ? "Suggest only" : level;

    private static string ConfidenceDescription(string level) => level switch
    {
        "Strict" => "Download only copies with strong identity evidence.",
        "Standard" => "Also download close matches supported by author or independent work evidence.",
        "Liberal" => "Also download a single plausible copy with incomplete metadata, then validate it.",
        "SuggestOnly" => "Find copies for review; a librarian chooses before downloading.",
        _ => string.Empty
    };

    /// <summary>
    /// Saves everything changed on one source's card. Each part has its own host route, so they are saved in turn;
    /// the first refusal stops there and leaves the rest of the typed values on the card.
    /// </summary>
    private async Task SaveProviderAsync(ExternalProviderResponse provider)
    {
        var draft = GetDraft(provider);
        var baseUrl = baseUrlDrafts.GetValueOrDefault(provider.Id, provider.BaseUrl);
        var key = GetApiKeyDraft(provider.Id);
        var steps = new List<Func<Task<ExternalProviderResult>>>();
        if (baseUrl != provider.BaseUrl)
        {
            steps.Add(() => Api.SetProviderDetailsAsync(provider.Id, provider.DisplayName, baseUrl));
        }

        if (!string.IsNullOrWhiteSpace(key))
        {
            steps.Add(() => Api.SetProviderApiKeyAsync(provider.Id, key));
        }

        if (!draft.ConfidenceMatches(provider))
        {
            steps.Add(() => Api.SetProviderConfidenceLevelAsync(provider.Id, draft.Level,
                draft.Ebook == "Inherit" ? null : draft.Ebook, draft.Audiobook == "Inherit" ? null : draft.Audiobook));
        }

        if (draft.Schedule != provider.RecheckSchedule)
        {
            steps.Add(() => Api.SetProviderRecheckScheduleAsync(provider.Id, draft.Schedule));
        }

        if (draft.AttemptLimit != provider.AutomaticAttemptLimit)
        {
            steps.Add(() => Api.SetProviderAutomaticAttemptLimitAsync(provider.Id, draft.AttemptLimit));
        }

        providersBusy = true;
        try
        {
            foreach (var step in steps)
            {
                var result = await step();
                if (!result.Succeeded)
                {
                    Snackbar.Failed(result.Error);
                    await LoadProvidersAsync();
                    return;
                }
            }

            apiKeyDrafts.Remove(provider.Id);
            baseUrlDrafts.Remove(provider.Id);
            providerDrafts.Remove(provider.Id);
            await LoadProvidersAsync();
            Snackbar.Saved($"Saved the settings for {provider.DisplayName}.");
        }
        finally
        {
            providersBusy = false;
        }
    }

    private bool providersBusy;
    private string? newProviderId;
    private string? newProviderDisplayName;
    private string? newProviderBaseUrl;
    private readonly Dictionary<Guid, string?> apiKeyDrafts = new();
    private readonly Dictionary<Guid, string> baseUrlDrafts = new();
    private IReadOnlyList<ProviderStatusResponse>? builtInSources;
    private bool sourceLoadFailed;
    private bool builtInSourcesBusy;
    private AdminRequestAttentionResponse? attention;
    private GutenbergCatalogStatusResponse? gutenbergCatalogStatus;
    private bool gutenbergCatalogBusy;
    private bool gutenbergCatalogRefreshInProgress;
    private bool gutenbergCatalogStatusUnavailable;
    private bool gutenbergCatalogPurgeConfirmation;
    private bool gutenbergCatalogPurgeInProgress;
    private bool isDisposed;

    private bool CanRegister =>
        !string.IsNullOrWhiteSpace(newProviderId) && !string.IsNullOrWhiteSpace(newProviderDisplayName) &&
        !string.IsNullOrWhiteSpace(newProviderBaseUrl);

    protected override async Task OnInitializedAsync()
    {
        Observe(LiveUpdateTopics.Sources | LiveUpdateTopics.Requests,
            () => Task.WhenAll(LoadProvidersAsync(), LoadAttentionAsync(), LoadGutenbergCatalogStatusAsync()));
        await Task.WhenAll(
            LoadProvidersAsync(),
            LoadBuiltInSourcesAsync(),
            LoadAttentionAsync(),
            LoadGutenbergCatalogStatusAsync());
        await RefreshLiveAsync();
    }

    private string? GetApiKeyDraft(Guid id) => apiKeyDrafts.GetValueOrDefault(id);

    private AdminProviderIssueResponse? ProviderIssueFor(string providerId, string issueKind) =>
        attention?.ProviderIssues.FirstOrDefault(issue =>
            string.Equals(issue.ProviderId, providerId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(issue.IssueKind, issueKind, StringComparison.Ordinal));

    // Providers self-report managementUrl/documentationUrl (protocol v2 S4) and are often
    // reached over plain http on an internal/lab network (docs/04-external-provider-http-protocol.md
    // S4's own example is http). Restricting to https here would silently hide a correctly
    // configured, provider-supplied link, so both schemes are allowed; anything else (e.g.
    // javascript:) is rejected.
    private static bool IsSafeExternalUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
        (string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) ||
         string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Shared coloring for the health/operations chips (protocol v2 §5):
    /// healthy/available -> success, degraded -> warning, unhealthy/unavailable -> error.
    /// </summary>
    // CachedCapabilities is stored as "mediaTypes:ebook,audiobook;operations:search,acquire;
    // features:x" (ExternalProviderAdminService.SerializeCapabilities): groups are
    // ';'-separated, values ','-separated. A value with no "group:" prefix gets an empty group.
    private static IEnumerable<(string Group, string Value)> ParseCapabilities(string? stored)
    {
        foreach (var segment in (stored ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var colon = segment.IndexOf(':');
            var group = colon < 0 ? string.Empty : segment[..colon].Trim();
            var values = colon < 0 ? segment : segment[(colon + 1)..];
            foreach (var value in values.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                yield return (group, value);
            }
        }
    }

    // Health is the summary chip, so its tooltip carries every reported reason,
    // each prefixed with the operation it concerns ("general" issues unprefixed).
    private static string? AllReasons(ExternalProviderResponse provider)
    {
        var messages = provider.CachedHealthIssues
            .Select(issue => issue.Operation switch
            {
                "search" => $"Search: {issue.Message}",
                "acquire" => $"Acquire: {issue.Message}",
                _ => issue.Message
            })
            .ToList();
        return messages.Count == 0 ? null : string.Join(" ", messages);
    }

    // The provider's own reason (protocol v2 §5 "issues") for one operation, as
    // plain text for a chip tooltip; null when it reported none.
    private static string? ReasonFor(ExternalProviderResponse provider, string operation)
    {
        var messages = provider.CachedHealthIssues
            .Where(issue => issue.Operation == operation)
            .Select(issue => issue.Message)
            .ToList();
        return messages.Count == 0 ? null : string.Join(" ", messages);
    }

    private static Color HealthColor(string? status) => status switch
    {
        "Healthy" or "Available" => Color.Success,
        "Degraded" => Color.Warning,
        "Unhealthy" or "Unavailable" => Color.Error,
        _ => Color.Default
    };

    private async Task LoadBuiltInSourcesAsync()
    {
        try
        {
            builtInSources = (await BuiltInSourcesApi.GetProvidersAsync())
                .Where(provider => provider.Capabilities.Contains("DirectAcquisition", StringComparer.Ordinal))
                .ToArray();
        }
        catch (HttpRequestException)
        {
            sourceLoadFailed = true;
        }
    }

    private async Task LoadAttentionAsync()
    {
        try
        {
            attention = await AdminRequests.GetAttentionAsync();
        }
        catch (HttpRequestException)
        {
            // The Sources page remains usable if the informational summary is
            // temporarily unavailable; source configuration is still loaded.
        }
    }

    private bool GutenbergCatalogIsSynchronizing => gutenbergCatalogRefreshInProgress ||
        IsGutenbergCatalogOperationStatus(gutenbergCatalogStatus?.Status);

    private bool GutenbergCatalogIsPurging => gutenbergCatalogPurgeInProgress ||
        gutenbergCatalogStatus?.Status == "Purging";

    private bool GutenbergCatalogOperationInProgress => GutenbergCatalogIsSynchronizing || GutenbergCatalogIsPurging;

    private bool GutenbergCatalogHasRecords => gutenbergCatalogStatus?.BookCount > 0;

    private string GutenbergCatalogSummary => GutenbergCatalogIsPurging
        ? "Deleting the local catalogue. Search records will be removed when this operation completes."
        : gutenbergCatalogRefreshInProgress
        ? gutenbergCatalogStatus?.IsReady == true
            ? "Refreshing the local catalogue. The existing local snapshot remains searchable."
            : "Refreshing the first local catalogue. Searches will be available after validation completes."
        : gutenbergCatalogStatus?.Status switch
        {
            "CheckingUpdates" => gutenbergCatalogStatus.IsReady
                ? "Checking Project Gutenberg's daily new-and-updated-books feed. The local catalogue remains searchable."
                : "Checking Project Gutenberg for the first local catalogue update.",
            "Downloading" => gutenbergCatalogStatus.IsReady
                ? "Downloading an updated catalogue. The existing local snapshot remains searchable."
                : "Downloading the first local catalogue. Searches will be available after validation completes.",
            "Parsing" or "Importing" => gutenbergCatalogStatus.IsReady
                ? "Building an updated catalogue. The existing local snapshot remains searchable."
                : "Building the first local catalogue. Searches will be available after validation completes.",
            "Retrying" => gutenbergCatalogStatus.IsReady
                ? "Retrying the refresh after a transient archive error. The existing local snapshot remains searchable."
                : "Retrying the first catalogue download after a transient archive error.",
            "Failed" when gutenbergCatalogStatus.IsReady =>
                "The latest refresh failed, but the previous local catalogue is still searchable.",
            "Failed" => "The local catalogue is unavailable until a refresh succeeds.",
            "Completed" when gutenbergCatalogStatus.IsReady => "The local catalogue is ready for automatic request lookup.",
            _ => "The local catalogue has not been downloaded yet."
        };

    private string GutenbergAvailableRecords => gutenbergCatalogStatus is { IsReady: true } status
        ? $"{status.BookCount:N0} books · {status.FormatCount:N0} formats"
        : "No searchable local records yet";

    private string GutenbergLastSuccessfulDownload => gutenbergCatalogStatus?.LastSuccessfulSyncUtc is { } downloadedAt
        ? downloadedAt.ToLocalTime().ToString("g")
        : "Never";

    private Severity GutenbergCatalogMessageSeverity =>
        gutenbergCatalogStatus?.Status == "Retrying" ? Severity.Warning : Severity.Error;

    private string GutenbergCatalogMessageTitle =>
        gutenbergCatalogStatus?.Status == "Retrying" ? "Refresh retrying" : "Latest refresh failed";

    private string GutenbergLastAttempt => gutenbergCatalogStatus?.LastAttemptUtc is { } attemptedAt
        ? attemptedAt.ToLocalTime().ToString("g")
        : "Never";

    private async Task LoadGutenbergCatalogStatusAsync()
    {
        try
        {
            gutenbergCatalogStatus = await GutenbergCatalog.GetStatusAsync();
            gutenbergCatalogStatusUnavailable = false;
        }
        catch (HttpRequestException)
        {
            // Source settings remain usable while the informational status is unavailable.
            gutenbergCatalogStatusUnavailable = true;
        }
    }

    private async Task RefreshGutenbergCatalogAsync()
    {
        gutenbergCatalogBusy = true;
        gutenbergCatalogRefreshInProgress = true;
        try
        {
            var result = await GutenbergCatalog.RefreshAsync();
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error ?? "The Project Gutenberg catalogue could not be refreshed.");
                await LoadGutenbergCatalogStatusAsync();
                return;
            }

            gutenbergCatalogStatus = result.Status;
            gutenbergCatalogStatusUnavailable = false;
            Snackbar.Add("Catalogue refresh queued. You can leave this page; the server will continue.", Severity.Info);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("The refresh request timed out. Check the catalogue status before trying again.", Severity.Error);
            await LoadGutenbergCatalogStatusAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Failed("The Project Gutenberg catalogue could not be refreshed.");
            await LoadGutenbergCatalogStatusAsync();
        }
        finally
        {
            gutenbergCatalogRefreshInProgress = false;
            gutenbergCatalogBusy = false;
        }
    }

    private void BeginGutenbergCatalogPurge() => gutenbergCatalogPurgeConfirmation = true;

    private void CancelGutenbergCatalogPurge() => gutenbergCatalogPurgeConfirmation = false;

    private async Task PurgeGutenbergCatalogAsync()
    {
        gutenbergCatalogBusy = true;
        gutenbergCatalogPurgeInProgress = true;
        try
        {
            var result = await GutenbergCatalog.PurgeAsync();
            if (isDisposed)
            {
                return;
            }

            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error ?? "The local Project Gutenberg catalogue could not be deleted.");
                await LoadGutenbergCatalogStatusAsync();
                return;
            }

            await LoadGutenbergCatalogStatusAsync();
            gutenbergCatalogPurgeConfirmation = false;
            Snackbar.Add($"Deleted {result.DeletedBookCount:N0} Project Gutenberg catalogue records.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            if (!isDisposed)
            {
                Snackbar.Failed("The local Project Gutenberg catalogue could not be deleted.");
                await LoadGutenbergCatalogStatusAsync();
            }
        }
        finally
        {
            if (!isDisposed)
            {
                gutenbergCatalogPurgeInProgress = false;
                gutenbergCatalogBusy = false;
            }
        }
    }

    public override void Dispose()
    {
        isDisposed = true;
        base.Dispose();
    }

    private static bool IsGutenbergCatalogOperationStatus(string? status) => status is
        "Queued" or "CheckingUpdates" or "Downloading" or "Decompressing" or "Parsing" or "Importing" or "Retrying" or "Purging";

    private async Task SetBuiltInSourceEnabledAsync(ProviderStatusResponse source, SettingSwitchChange change)
    {
        builtInSourcesBusy = true;
        try
        {
            var result = await BuiltInSourcesApi.SetEnabledAsync(source.ProviderId, change.Value);
            if (!result.Succeeded)
            {
                change.Refuse(result.Error);
                return;
            }

            await LoadBuiltInSourcesAsync();
            if (source.ProviderId == "gutendex")
            {
                gutenbergCatalogPurgeConfirmation = false;
            }

            Snackbar.Saved($"{source.DisplayName} {(change.Value ? "enabled" : "disabled")}.");
        }
        finally
        {
            builtInSourcesBusy = false;
        }
    }

    // --- Providers -------------------------------------------------------------

    private async Task LoadProvidersAsync() => providers = await Api.GetProvidersAsync();

    private async Task RegisterProviderAsync()
    {
        if (!CanRegister)
        {
            return;
        }

        providersBusy = true;
        try
        {
            var result = await Api.CreateProviderAsync(newProviderId!, newProviderDisplayName!, newProviderBaseUrl!);
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error ?? "That provider could not be registered.");
                return;
            }

            newProviderId = null;
            newProviderDisplayName = null;
            newProviderBaseUrl = null;
            await LoadProvidersAsync();
        }
        finally
        {
            providersBusy = false;
        }
    }

    private async Task SetProviderEnabledAsync(Guid id, SettingSwitchChange change)
    {
        providersBusy = true;
        try
        {
            var result = await Api.SetProviderEnabledAsync(id, change.Value);
            if (!result.Succeeded)
            {
                change.Refuse(result.Error);
            }

            await LoadProvidersAsync();
            if (result.Succeeded)
            {
                Snackbar.Saved(change.Value ? "Source enabled." : "Source disabled.");
            }
        }
        finally
        {
            providersBusy = false;
        }
    }

    private async Task ClearApiKeyAsync(ExternalProviderResponse provider)
    {
        if (!await Dialogs.ConfirmRemovalAsync($"Remove the API key for {provider.DisplayName}?", "The stored key is deleted."))
        {
            return;
        }

        providersBusy = true;
        try
        {
            var result = await Api.ClearProviderApiKeyAsync(provider.Id);
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error);
                return;
            }

            await LoadProvidersAsync();
            Snackbar.Saved("API key removed.");
        }
        finally
        {
            providersBusy = false;
        }
    }

    private async Task TestProviderAsync(Guid id)
    {
        providersBusy = true;
        try
        {
            var result = await Api.TestProviderAsync(id);
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error ?? "The connection test could not be run.");
                return;
            }

            // The result is recorded and shown on the card, beside the button.
            await LoadProvidersAsync();
        }
        finally
        {
            providersBusy = false;
        }
    }

    private async Task RemoveProviderAsync(ExternalProviderResponse provider)
    {
        if (!await Dialogs.ConfirmRemovalAsync($"Remove {provider.DisplayName}?",
                "This removes the source and its stored settings and key. Family Librarian stops searching it.",
                "Remove provider"))
        {
            return;
        }

        providersBusy = true;
        try
        {
            if (await Api.RemoveProviderAsync(provider.Id))
            {
                providerDrafts.Remove(provider.Id);
                apiKeyDrafts.Remove(provider.Id);
                baseUrlDrafts.Remove(provider.Id);
                await LoadProvidersAsync();
                Snackbar.Saved($"Removed {provider.DisplayName}.");
            }
            else
            {
                Snackbar.Failed("That provider could not be removed.");
            }
        }
        finally
        {
            providersBusy = false;
        }
    }

}
