    private AdminRequestAttentionResponse? attention;
    private GutenbergCatalogStatusResponse? gutenbergCatalogStatus;
    private bool gutenbergCatalogBusy;
    private bool gutenbergCatalogRefreshInProgress;
    private bool gutenbergCatalogStatusUnavailable;
    private bool gutenbergCatalogPurgeConfirmation;
    private bool gutenbergCatalogPurgeInProgress;
    private readonly CancellationTokenSource gutenbergCatalogStatusPollingCancellation = new();
    private Task? gutenbergCatalogStatusPollingTask;
    private bool isDisposed;

    private bool CanRegister =>
        !string.IsNullOrWhiteSpace(newProviderId) && !string.IsNullOrWhiteSpace(newProviderDisplayName) &&
        !string.IsNullOrWhiteSpace(newProviderBaseUrl);

    protected override Task OnInitializedAsync() =>
        Task.WhenAll(
            LoadGatewayAsync(),
            LoadCatalogsAsync(),
            LoadProvidersAsync(),
            LoadBuiltInSourcesAsync(),
            LoadAttentionAsync(),
            LoadGutenbergCatalogStatusAsync());

    private string? GetApiKeyDraft(Guid id) => apiKeyDrafts.GetValueOrDefault(id);

    private int BuiltInSourceGeneration(string providerId) =>
