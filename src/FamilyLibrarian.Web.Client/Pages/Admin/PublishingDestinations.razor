@page "/settings/publishing"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Publishing
@using FamilyLibrarian.Web.Client.Publishing
@using Microsoft.AspNetCore.Authorization
@inject CwaSettingsApiClient CwaApi
@inject AudiobookshelfSettingsApiClient AudiobookshelfApi
@inject ISnackbar Snackbar

<PageTitle>Publishing settings | Family Librarian</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Publishing settings</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Configure where approved files are published. Publishing activity is shown
    separately in the administrator workspace.
</MudText>

@if (cwaLoadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the CWA settings.</MudAlert>
}
else if (cwa is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading CWA settings" />
}
else
{
    // Needs setup: ingest delivery isn't configured enough for SetEnabledAsync to
    // accept turning CWA on.
    var cwaNeedsSetup = !cwa.IsIngestConfigured;
    // The delivery/OPDS panels track Enabled directly — off means collapsed to
    // just the name and description. expandedSetup covers the one case that
    // would otherwise be a dead end: flipping the switch while unconfigured
    // (see SetCwaEnabledAsync) reveals the panels instead of calling an API
    // that would only reject it.
    var cwaExpanded = cwa.IsEnabled || expandedSetup.Contains("cwa");

    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">CWA (ebook library)</MudText>
            @if (cwaNeedsSetup)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    Needs setup
                </MudChip>
            }

            <MudSpacer />

            <MudSwitch T="bool" @key="@("cwa:" + cwaSwitchGeneration)" Value="cwa.IsEnabled"
                       ValueChanged="@(enabled => SetCwaEnabledAsync(enabled))" Color="Color.Primary" Disabled="@cwaBusy"
                       Label="@(cwa.IsEnabled ? "Enabled" : "Disabled")" />
        </MudStack>

        @if (!cwaExpanded)
        {
            <MudText Typo="Typo.body2" Class="mt-3 mb-3">
                Publish approved ebooks straight into CWA's library, over a local path or SFTP,
                with an optional OPDS connection to verify imports.
            </MudText>
        }
        else
        {
        <MudDivider Class="my-3" />

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Ebook delivery</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Choose how Family Librarian places an approved ebook in CWA's ingest directory.
                Test checks the values currently in this form without saving them. Save is the only action that stores delivery settings or credentials.
            </MudText>
            <MudSelect T="string" Label="Delivery method" @bind-Value="cwaTransportMode" Disabled="@cwaBusy">
                <MudSelectItem Value="@("Local")">Local path (same host / mounted share)</MudSelectItem>
                <MudSelectItem Value="@("Sftp")">SFTP (remote host)</MudSelectItem>
            </MudSelect>
            @if (cwaTransportMode == "Local")
            {
                <MudTextField T="string" Label="Local ingest directory" @bind-Value="cwaLocalIngestPath"
                              Disabled="@cwaBusy" Class="mt-3" />
            }
            else
            {
                <MudStack Spacing="3" Class="mt-3">
                    <MudTextField T="string" Label="SFTP host" @bind-Value="cwaSftpHost" Disabled="@cwaBusy" />
                    <MudNumericField T="int?" Label="SFTP port (default 22)" @bind-Value="cwaSftpPort" Disabled="@cwaBusy" />
                    <MudTextField T="string" Label="SFTP username" @bind-Value="cwaSftpUsername"
                                  name="cwa-sftp-username" autocomplete="off" Disabled="@cwaBusy" />
                    <MudTextField T="string" Label="Remote ingest directory" @bind-Value="cwaSftpIngestPath"
                                  name="cwa-sftp-ingest-directory" autocomplete="off" Disabled="@cwaBusy" />
                    <MudSelect T="string" Label="Authentication" @bind-Value="cwaSftpAuthenticationMode" Disabled="@cwaBusy">
                        <MudSelectItem Value="@("Password")">Password</MudSelectItem>
                        <MudSelectItem Value="@("PrivateKey")">Private key</MudSelectItem>
                    </MudSelect>
                    @if (cwaSftpAuthenticationMode == "Password")
                    {
                        <MudText Typo="Typo.body2">@(cwa.HasSftpPassword ? "A password is stored. This field is intentionally blank: leave it blank to keep the stored password, enter a value to replace it, or use Remove stored password." : "Enter the SFTP password. It will be stored when you save or test delivery.")</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField T="string" @bind-Value="cwaSftpPasswordDraft" Label="SFTP password"
                                          InputType="InputType.Password" autocomplete="new-password"
                                          Disabled="@cwaBusy" Class="flex-grow-1" />
                            @if (cwa.HasSftpPassword)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@cwaBusy" OnClick="ClearCwaSftpPasswordAsync">Remove stored password</MudButton>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@(cwa.HasSftpPrivateKey ? $"A private key ending in {cwa.SftpPrivateKeyHint} is stored. Enter a value only to replace it." : "Enter a private key. It will be stored when you save or test delivery.")</MudText>
                        <MudTextField T="string" @bind-Value="cwaSftpPrivateKeyDraft" Label="Private key (PEM or OpenSSH)"
                                      Lines="4" Disabled="@cwaBusy" />
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField T="string" @bind-Value="cwaSftpPassphraseDraft" Label="Key passphrase (optional)"
                                          InputType="InputType.Password" autocomplete="new-password"
                                          Disabled="@cwaBusy" Class="flex-grow-1" />
                            @if (cwa.HasSftpPassphrase)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@cwaBusy" OnClick="ClearCwaSftpPassphraseAsync">Remove stored passphrase</MudButton>
                            }
                        </MudStack>
                    }

                    <MudText Typo="Typo.subtitle2">SFTP server identity</MudText>
                    @if (string.IsNullOrWhiteSpace(cwa.SftpHostKeyFingerprint))
                    {
                        <MudText Typo="Typo.body2">The first SFTP test will show the server's SSH fingerprint for approval.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">Trusted SHA-256 fingerprint: @cwa.SftpHostKeyFingerprint</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(cwaPendingSftpHostKeyFingerprint))
                    {
                        <MudAlert Severity="Severity.Warning">
                            Verify this SHA-256 fingerprint with your SFTP server before trusting it:
                            <code>@cwaPendingSftpHostKeyFingerprint</code>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@cwaBusy"
                                       OnClick="TrustCwaSftpHostKeyAsync" Class="ml-2">Approve for this test</MudButton>
                        </MudAlert>
                    }
                </MudStack>
            }

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@cwaBusy"
                           OnClick="SaveCwaIngestAsync">Save delivery settings</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@cwaBusy"
                           OnClick="SaveAndTestCwaIngestAsync">@CwaIngestTestButtonLabel</MudButton>
            </MudStack>
            @if (cwaIngestTestResult is not null)
            {
                <MudAlert Severity="@(cwaIngestTestResult.Succeeded ? Severity.Success : Severity.Warning)" Class="mt-3">
                    @cwaIngestTestResult.Message
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Optional import verification (OPDS)</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                OPDS is CWA's HTTP catalog and is separate from SFTP delivery. Enter CWA's site root,
                not its <code>/opds</code> page: for example, <code>https://books.example.com</code>,
                not <code>https://books.example.com/opds</code>. Family Librarian adds the
                <code>/opds/search/...</code> path itself. The OPDS test checks the current form values
                without saving them.
            </MudText>
            <MudStack Spacing="3">
                <MudTextField T="string" Label="CWA site root URL" @bind-Value="cwaOpdsBaseUrl"
                              Placeholder="https://books.example.com"
                              HelperText="Enter the CWA site root; do not add /opds."
                              Disabled="@cwaBusy" />
                <MudTextField T="string" Label="OPDS username" @bind-Value="cwaOpdsUsername" Disabled="@cwaBusy" />
                <MudText Typo="Typo.body2">@(cwa.HasOpdsPassword ? "An OPDS password is stored. This field is intentionally blank: leave it blank to keep it, or enter a value to replace it." : "No OPDS password is stored.")</MudText>
                <MudTextField T="string" @bind-Value="cwaOpdsPasswordDraft" Label="OPDS password"
                              InputType="InputType.Password" autocomplete="new-password" Disabled="@cwaBusy" />
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@cwaBusy"
                           OnClick="SaveCwaOpdsAsync">Save OPDS settings</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Disabled="@(cwaBusy || string.IsNullOrWhiteSpace(cwaOpdsBaseUrl))"
                           OnClick="TestCwaOpdsAsync">Test OPDS</MudButton>
            </MudStack>
            @if (cwaOpdsTestResult is not null)
            {
                <MudAlert Severity="@(cwaOpdsTestResult.Succeeded ? Severity.Success : Severity.Warning)" Class="mt-3">
                    @cwaOpdsTestResult.Message
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Confirm saved configuration</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Enabling CWA requires a passing test of the delivery and OPDS settings you just
                saved above — unlike the two tests above, this one is recorded, and is what
                actually unlocks the Enabled switch. Save delivery and OPDS settings first; this
                test checks what is currently saved, not this form's unsaved values.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@cwaBusy"
                       OnClick="TestCwaConnectionAsync">Test saved connection</MudButton>
            @if (cwaConnectionTestResult is not null)
            {
                <MudAlert Severity="@(cwaConnectionTestResult.Succeeded ? Severity.Success : Severity.Warning)" Class="mt-3">
                    @cwaConnectionTestResult.Message
                </MudAlert>
            }
            else if (cwa.LastTestedAtUtc is { } lastTestedAtUtc)
            {
                <MudText Typo="Typo.caption" Class="mt-3">
                    Last tested @lastTestedAtUtc.ToLocalTime().ToString("g") —
                    @(cwa.LastTestSucceeded == true ? "succeeded." : "failed.")
                    @cwa.LastTestMessage
                </MudText>
            }
        </MudPaper>
        }
    </MudPaper>
}

@if (audiobookshelfLoadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the Audiobookshelf settings.</MudAlert>
}
else if (audiobookshelf is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading Audiobookshelf settings" />
}
else
{
    // Audiobookshelf has no server-side gate blocking Enabled without a
    // configuration (unlike CWA), but the shape here mirrors CWA closely enough
    // that leaving it always expanded while CWA collapses would read as
    // inconsistent on the same page. "Configured" is a UI-only judgment call:
    // enough to actually run a search — base URL, library, and a token.
    var audiobookshelfNeedsSetup = string.IsNullOrWhiteSpace(audiobookshelf.BaseUrl) ||
        string.IsNullOrWhiteSpace(audiobookshelf.LibraryId) || !audiobookshelf.HasApiToken;
    // Unlike CWA, nothing blocks enabling Audiobookshelf while unconfigured, so
    // the switch alone (no interception needed) is enough to drive this.
    var audiobookshelfExpanded = audiobookshelf.IsEnabled;

    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">Audiobookshelf</MudText>
            @if (audiobookshelfNeedsSetup)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    Needs setup
                </MudChip>
            }
            <MudSpacer />
            <MudSwitch T="bool" @key="@("abs:" + audiobookshelfSwitchGeneration)" Value="audiobookshelf.IsEnabled" ValueChanged="@(enabled => SetAudiobookshelfEnabledAsync(enabled))" Color="Color.Primary" Disabled="@audiobookshelfBusy" Label="@(audiobookshelf.IsEnabled ? "Enabled" : "Disabled")" />
        </MudStack>

        @if (!audiobookshelfExpanded)
        {
            <MudText Typo="Typo.body2" Class="mt-3 mb-3">
                Publish approved audiobooks into an Audiobookshelf library and folder.
            </MudText>
        }
        else
        {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.body2" Class="mb-2">
            Discover libraries needs a base URL and an API token (a stored token is used if you leave the
            field below blank) to look up libraries and folders, so enter both before using it.
        </MudText>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Base URL" @bind-Value="audiobookshelfBaseUrl" Disabled="@audiobookshelfBusy" />

            <MudText Typo="Typo.subtitle2">API token</MudText>
            <MudText Typo="Typo.body2">@(audiobookshelf.HasApiToken ? $"A token ending in {audiobookshelf.ApiTokenHint} was saved {audiobookshelf.ApiTokenSetAtUtc?.ToLocalTime().ToString("f")}." : "No token is stored yet.")</MudText>
            <MudStack Row="true" Spacing="2">
                <MudTextField T="string" @bind-Value="audiobookshelfApiTokenDraft" Label="Replace API token" InputType="InputType.Password" Disabled="@audiobookshelfBusy" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Disabled="@(audiobookshelfBusy || string.IsNullOrWhiteSpace(audiobookshelfApiTokenDraft))" OnClick="SaveAudiobookshelfApiTokenAsync">Save token</MudButton>
                @if (audiobookshelf.HasApiToken) { <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@audiobookshelfBusy" OnClick="ClearAudiobookshelfApiTokenAsync">Remove</MudButton> }
            </MudStack>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined" Disabled="@(audiobookshelfBusy || string.IsNullOrWhiteSpace(audiobookshelfBaseUrl))" OnClick="DiscoverAudiobookshelfLibrariesAsync">Discover libraries</MudButton>
                @if (audiobookshelfDiscoveryError is not null) { <MudText Typo="Typo.body2" Color="Color.Error">@audiobookshelfDiscoveryError</MudText> }
            </MudStack>
            @if (audiobookshelfLibraryOptions is { Count: > 0 })
            {
                <MudSelect T="string" Label="Library" Value="@audiobookshelfLibraryId" ValueChanged="OnAudiobookshelfLibrarySelected" Disabled="@audiobookshelfBusy">
                    @foreach (var library in audiobookshelfLibraryOptions)
                    {
                        <MudSelectItem Value="@library.Id">@library.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (SelectedAudiobookshelfLibraryFolders is { Count: > 0 })
                {
                    <MudSelect T="string" Label="Folder" @bind-Value="audiobookshelfFolderId" Disabled="@audiobookshelfBusy">
                        @foreach (var folder in SelectedAudiobookshelfLibraryFolders)
                        {
                            <MudSelectItem Value="@folder.Id">@folder.Path</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            <MudTextField T="string" Label="Library ID" @bind-Value="audiobookshelfLibraryId" Disabled="@audiobookshelfBusy"
                          HelperText="Filled in by Discover libraries above, or enter it directly." />
            <MudTextField T="string" Label="Folder ID" @bind-Value="audiobookshelfFolderId" Disabled="@audiobookshelfBusy"
                          HelperText="Filled in after picking a library above, or enter it directly." />
        </MudStack>
        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@audiobookshelfBusy" OnClick="SaveAudiobookshelfSettingsAsync">Save settings</MudButton>
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.body2" Class="mb-2">
            Test checks the base URL, library ID, folder ID, and API token currently in this form (a stored token is
            used if the token field above is blank) without saving them. Save settings also saves a token typed into
            the field above; use Save token to store a token without changing the other fields.
        </MudText>
        <MudButton Variant="Variant.Outlined" Disabled="@audiobookshelfBusy" OnClick="TestAudiobookshelfAsync">Test connection</MudButton>
        @if (audiobookshelfTestResult is not null)
        {
            <MudAlert Severity="@(audiobookshelfTestResult.Succeeded ? Severity.Success : Severity.Warning)" Class="mt-3">
                @audiobookshelfTestResult.Message
            </MudAlert>
        }
        }
    </MudPaper>
}

@code {
    // Destinations ("cwa", "audiobookshelf") whose panels are showing even
    // though they're not Enabled — set when flipping the switch on an
    // unconfigured destination reveals its settings instead of calling the API
    // (see SetCwaEnabledAsync/SetAudiobookshelfEnabledAsync), and cleared again
    // once the destination is actually switched off for real.
    private readonly HashSet<string> expandedSetup = new(StringComparer.OrdinalIgnoreCase);
    private void Expand(string destinationId) => expandedSetup.Add(destinationId);
    private void Collapse(string destinationId) => expandedSetup.Remove(destinationId);

    private CwaSettingsResponse? cwa;
    private bool cwaLoadFailed, cwaBusy;
    private int cwaSwitchGeneration;
    private string cwaTransportMode = "Local", cwaSftpAuthenticationMode = "PrivateKey";
    private string? cwaLocalIngestPath, cwaSftpHost, cwaSftpUsername, cwaSftpIngestPath, cwaSftpPrivateKeyDraft, cwaSftpPassphraseDraft, cwaSftpPasswordDraft, cwaPendingSftpHostKeyFingerprint, cwaApprovedSftpHostKeyFingerprint, cwaOpdsBaseUrl, cwaOpdsUsername, cwaOpdsPasswordDraft;
    private int? cwaSftpPort;
    private PublishingConnectionTestResponse? cwaIngestTestResult, cwaOpdsTestResult, cwaConnectionTestResult;
    private AudiobookshelfSettingsResponse? audiobookshelf;
    private bool audiobookshelfLoadFailed, audiobookshelfBusy;
    private int audiobookshelfSwitchGeneration;
    private string? audiobookshelfBaseUrl, audiobookshelfLibraryId, audiobookshelfFolderId, audiobookshelfApiTokenDraft;
    private PublishingConnectionTestResponse? audiobookshelfTestResult;
    private List<AudiobookshelfLibraryOption>? audiobookshelfLibraryOptions;
    private string? audiobookshelfDiscoveryError;

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadCwaAsync(), LoadAudiobookshelfAsync());
    private async Task LoadCwaAsync() { try { cwa = await CwaApi.GetAsync(); ApplyCwaFields(cwa); } catch (HttpRequestException) { cwaLoadFailed = true; } }
    private void ApplyCwaFields(CwaSettingsResponse? settings) { if (settings is null) return; cwaTransportMode = settings.TransportMode; cwaLocalIngestPath = settings.LocalIngestPath; cwaSftpHost = settings.SftpHost; cwaSftpPort = settings.SftpPort; cwaSftpUsername = settings.SftpUsername; cwaSftpIngestPath = settings.SftpIngestPath; cwaSftpAuthenticationMode = settings.SftpAuthenticationMode; if (!string.IsNullOrWhiteSpace(settings.SftpHostKeyFingerprint)) cwaPendingSftpHostKeyFingerprint = null; cwaOpdsBaseUrl = settings.OpdsBaseUrl; cwaOpdsUsername = settings.OpdsUsername; }
    private string CwaIngestTestButtonLabel => cwaTransportMode == "Sftp" ? "Test SFTP" : "Test local path";
    private async Task SetCwaEnabledAsync(bool enabled)
    {
        if (enabled && cwa is { IsIngestConfigured: false })
        {
            // The server will refuse to enable CWA until ingest delivery is
            // configured, so there's nothing to gain from the round trip.
            // Flipping the switch here instead reveals the delivery panel — the
            // switch doubles as the only "let me configure this" control there
            // is. Bumping the generation undoes MudSwitch's optimistic flip.
            Expand("cwa");
            cwaSwitchGeneration++;
            return;
        }

        if (await RunCwaAsync(() => CwaApi.SetEnabledAsync(enabled)) && !enabled)
        {
            // Once switched off, the panels should actually collapse rather than
            // stay open because an earlier attempt to configure it left it
            // expanded.
            Collapse("cwa");
        }
    }
    private Task ClearCwaSftpPassphraseAsync() => RunCwaAsync(() => CwaApi.ClearSftpPassphraseAsync());
    private Task ClearCwaSftpPasswordAsync() => RunCwaAsync(() => CwaApi.ClearSftpPasswordAsync());
    private Task TrustCwaSftpHostKeyAsync()
    {
        if (!string.IsNullOrWhiteSpace(cwaPendingSftpHostKeyFingerprint))
        {
            cwaApprovedSftpHostKeyFingerprint = cwaPendingSftpHostKeyFingerprint;
            cwaPendingSftpHostKeyFingerprint = null;
            cwaIngestTestResult = null;
            Snackbar.Add("The server identity is approved for this unsaved form. Test again, then save delivery settings to persist it.", Severity.Success);
        }

        return Task.CompletedTask;
    }

    private async Task SaveCwaIngestAsync()
    {
        cwaBusy = true;
        try
        {
            if (await SaveCurrentCwaSettingsAsync(saveIngestCredential: true, saveOpdsCredential: false))
            {
                Snackbar.Add("Saved the CWA delivery settings.", Severity.Success);
            }
        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    private async Task SaveAndTestCwaIngestAsync()
    {
        cwaBusy = true;
        try
        {
            cwaIngestTestResult = await CwaApi.TestIngestAsync(new TestCwaIngestRequest(
                cwaTransportMode,
                cwaLocalIngestPath,
                cwaSftpHost,
                cwaSftpPort,
                cwaSftpUsername,
                cwaSftpIngestPath,
                cwaSftpAuthenticationMode,
                cwaSftpPrivateKeyDraft,
                cwaSftpPassphraseDraft,
                cwaSftpPasswordDraft,
                CurrentCwaSftpHostKeyFingerprint));
            if (cwaIngestTestResult is null)
            {
                Snackbar.Add("The delivery test could not be run.", Severity.Error);
                return;
            }

            if (cwaIngestTestResult.RequiresSftpHostKeyTrust)
            {
                cwaPendingSftpHostKeyFingerprint = cwaIngestTestResult.SftpHostKeyFingerprint;
                cwaApprovedSftpHostKeyFingerprint = null;
            }
        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    private async Task SaveCwaOpdsAsync()
    {
        cwaBusy = true;
        try
        {
            if (await SaveCurrentCwaSettingsAsync(saveIngestCredential: false, saveOpdsCredential: true))
            {
                Snackbar.Add("Saved the CWA OPDS settings.", Severity.Success);
            }
        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    private async Task TestCwaOpdsAsync()
    {
        cwaBusy = true;
        try
        {
            cwaOpdsTestResult = await CwaApi.TestOpdsAsync(new TestCwaOpdsRequest(
                cwaOpdsBaseUrl,
                cwaOpdsUsername,
                cwaOpdsPasswordDraft));
            if (cwaOpdsTestResult is null)
            {
                Snackbar.Add("The OPDS test could not be run.", Severity.Error);
                return;
            }

        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    private async Task TestCwaConnectionAsync()
    {
        cwaBusy = true;
        try
        {
            cwaConnectionTestResult = await CwaApi.TestConnectionAsync();
            if (cwaConnectionTestResult is null)
            {
                Snackbar.Add("The connection test could not be run.", Severity.Error);
                return;
            }

            // The test endpoint only returns pass/fail, not the updated
            // settings -- reload so LastTestSucceeded (and so whether the
            // Enable switch will actually be accepted) reflects this result.
            cwa = await CwaApi.GetAsync();
            ApplyCwaFields(cwa);
        }
        finally
        {
            cwaBusy = false;
            cwaSwitchGeneration++;
        }
    }

    private async Task<bool> SaveCurrentCwaSettingsAsync(
        bool saveIngestCredential,
        bool saveOpdsCredential)
    {
        var settingsResult = await CwaApi.SetSettingsAsync(new SetCwaSettingsRequest(
            cwaTransportMode,
            cwaLocalIngestPath,
            cwaSftpHost,
            cwaSftpPort,
            cwaSftpUsername,
            cwaSftpIngestPath,
            cwaSftpAuthenticationMode,
            cwaOpdsBaseUrl,
            cwaOpdsUsername));
        if (!AcceptCwaResult(settingsResult))
        {
            return false;
        }

        if (saveIngestCredential && cwaTransportMode == "Sftp")
        {
            if (cwaSftpAuthenticationMode == "Password" && !string.IsNullOrWhiteSpace(cwaSftpPasswordDraft))
            {
                if (!AcceptCwaResult(await CwaApi.SetSftpPasswordAsync(cwaSftpPasswordDraft)))
                {
                    return false;
                }

                cwaSftpPasswordDraft = null;
            }
            else if (cwaSftpAuthenticationMode == "PrivateKey")
            {
                if (!string.IsNullOrWhiteSpace(cwaSftpPrivateKeyDraft))
                {
                    if (!AcceptCwaResult(await CwaApi.SetSftpPrivateKeyAsync(cwaSftpPrivateKeyDraft)))
                    {
                        return false;
                    }

                    cwaSftpPrivateKeyDraft = null;
                }

                if (!string.IsNullOrWhiteSpace(cwaSftpPassphraseDraft))
                {
                    if (!AcceptCwaResult(await CwaApi.SetSftpPassphraseAsync(cwaSftpPassphraseDraft)))
                    {
                        return false;
                    }

                    cwaSftpPassphraseDraft = null;
                }
            }

            if (!string.IsNullOrWhiteSpace(cwaApprovedSftpHostKeyFingerprint))
            {
                if (!AcceptCwaResult(await CwaApi.TrustSftpHostKeyAsync(cwaApprovedSftpHostKeyFingerprint)))
                {
                    return false;
                }

                cwaApprovedSftpHostKeyFingerprint = null;
            }
        }

        if (saveOpdsCredential && !string.IsNullOrWhiteSpace(cwaOpdsPasswordDraft))
        {
            if (!AcceptCwaResult(await CwaApi.SetOpdsPasswordAsync(cwaOpdsPasswordDraft)))
            {
                return false;
            }

            cwaOpdsPasswordDraft = null;
        }

        ApplyCwaFields(cwa);
        return true;
    }

    private string? CurrentCwaSftpHostKeyFingerprint
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(cwaApprovedSftpHostKeyFingerprint))
            {
                return cwaApprovedSftpHostKeyFingerprint;
            }

            var savedSettings = cwa;
            return savedSettings is not null &&
                   string.Equals(savedSettings.SftpHost, cwaSftpHost, StringComparison.OrdinalIgnoreCase) &&
                   savedSettings.SftpPort == cwaSftpPort
                ? savedSettings.SftpHostKeyFingerprint
                : null;
        }
    }

    private bool AcceptCwaResult(CwaResult result)
    {
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Error ?? "The CWA settings could not be saved.", Severity.Error);
            return false;
        }

        cwa = result.Settings;
        return true;
    }

    private async Task<bool> RunCwaAsync(Func<Task<CwaResult>> action) { cwaBusy = true; try { var result = await action(); if (!result.Succeeded) { Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error); return false; } cwa = result.Settings; ApplyCwaFields(cwa); return true; } finally { cwaBusy = false; cwaSwitchGeneration++; } }
    private async Task LoadAudiobookshelfAsync() { try { audiobookshelf = await AudiobookshelfApi.GetAsync(); ApplyAudiobookshelfFields(audiobookshelf); } catch (HttpRequestException) { audiobookshelfLoadFailed = true; } }
    private void ApplyAudiobookshelfFields(AudiobookshelfSettingsResponse? settings) { if (settings is null) return; audiobookshelfBaseUrl = settings.BaseUrl; audiobookshelfLibraryId = settings.LibraryId; audiobookshelfFolderId = settings.FolderId; }
    private Task SetAudiobookshelfEnabledAsync(bool enabled) =>
        RunAudiobookshelfAsync(() => AudiobookshelfApi.SetEnabledAsync(enabled));
    private async Task SaveAudiobookshelfSettingsAsync()
    {
        audiobookshelfBusy = true;
        try
        {
            var result = await AudiobookshelfApi.SetSettingsAsync(new SetAudiobookshelfSettingsRequest(audiobookshelfBaseUrl, audiobookshelfLibraryId, audiobookshelfFolderId));
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error);
                return;
            }

            audiobookshelf = result.Settings;
            ApplyAudiobookshelfFields(audiobookshelf);

            if (!string.IsNullOrWhiteSpace(audiobookshelfApiTokenDraft))
            {
                var tokenResult = await AudiobookshelfApi.SetApiTokenAsync(audiobookshelfApiTokenDraft);
                if (!tokenResult.Succeeded)
                {
                    Snackbar.Add(tokenResult.Error ?? "The API token could not be saved.", Severity.Error);
                    return;
                }

                audiobookshelf = tokenResult.Settings;
                ApplyAudiobookshelfFields(audiobookshelf);
                audiobookshelfApiTokenDraft = null;
            }

            Snackbar.Add("Saved the Audiobookshelf settings.", Severity.Success);
        }
        finally
        {
            audiobookshelfBusy = false;
            audiobookshelfSwitchGeneration++;
        }
    }
    private async Task SaveAudiobookshelfApiTokenAsync() { if (string.IsNullOrWhiteSpace(audiobookshelfApiTokenDraft)) return; if (await RunAudiobookshelfAsync(() => AudiobookshelfApi.SetApiTokenAsync(audiobookshelfApiTokenDraft))) { audiobookshelfApiTokenDraft = null; Snackbar.Add("Saved the Audiobookshelf API token.", Severity.Success); } }
    private Task ClearAudiobookshelfApiTokenAsync() => RunAudiobookshelfAsync(() => AudiobookshelfApi.ClearApiTokenAsync());

    private async Task TestAudiobookshelfAsync()
    {
        audiobookshelfBusy = true;
        try
        {
            audiobookshelfTestResult = await AudiobookshelfApi.TestAsync(new TestAudiobookshelfRequest(
                audiobookshelfBaseUrl, audiobookshelfLibraryId, audiobookshelfFolderId, audiobookshelfApiTokenDraft));
            if (audiobookshelfTestResult is null)
            {
                Snackbar.Add("The connection test could not be run.", Severity.Error);
            }
        }
        finally
        {
            audiobookshelfBusy = false;
        }
    }

    private async Task DiscoverAudiobookshelfLibrariesAsync()
    {
        audiobookshelfBusy = true;
        try
        {
            var response = await AudiobookshelfApi.DiscoverLibrariesAsync(new DiscoverAudiobookshelfLibrariesRequest(
                audiobookshelfBaseUrl, audiobookshelfApiTokenDraft));
            if (response is null)
            {
                Snackbar.Add("The library lookup could not be run.", Severity.Error);
                return;
            }

            if (!response.Succeeded)
            {
                audiobookshelfLibraryOptions = [];
                audiobookshelfDiscoveryError = response.Error ?? "Could not list Audiobookshelf libraries.";
                return;
            }

            audiobookshelfLibraryOptions = response.Libraries.ToList();
            audiobookshelfDiscoveryError = audiobookshelfLibraryOptions.Count == 0
                ? "Audiobookshelf has no libraries yet."
                : null;
        }
        finally
        {
            audiobookshelfBusy = false;
        }
    }

    private void OnAudiobookshelfLibrarySelected(string libraryId)
    {
        audiobookshelfLibraryId = libraryId;
        var folders = SelectedAudiobookshelfLibraryFolders;
        audiobookshelfFolderId = folders?.Count == 1 ? folders[0].Id : null;
    }

    private IReadOnlyList<AudiobookshelfFolderOption>? SelectedAudiobookshelfLibraryFolders =>
        audiobookshelfLibraryOptions?.FirstOrDefault(library => library.Id == audiobookshelfLibraryId)?.Folders;

    private async Task<bool> RunAudiobookshelfAsync(Func<Task<AudiobookshelfResult>> action) { audiobookshelfBusy = true; try { var result = await action(); if (!result.Succeeded) { Snackbar.Add(result.Error ?? "That change could not be saved.", Severity.Error); return false; } audiobookshelf = result.Settings; ApplyAudiobookshelfFields(audiobookshelf); return true; } finally { audiobookshelfBusy = false; audiobookshelfSwitchGeneration++; } }
}
