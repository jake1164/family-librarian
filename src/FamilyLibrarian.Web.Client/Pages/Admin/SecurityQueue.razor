@page "/admin/security"
@attribute [Authorize(Roles = "Admin")]
@inherits LiveComponentBase
@using FamilyLibrarian.Contracts.Acquisition
@using FamilyLibrarian.Web.Client.Acquisition
@using Microsoft.AspNetCore.Authorization
@inject MediaAssetsApiClient MediaAssets
@inject ISnackbar Snackbar

<PageTitle>Security scans · Family Librarian</PageTitle>

@* The role attribute is UX only. Every endpoint behind this page independently
   requires the Admin policy and an anti-forgery token. *@
<MudText Typo="Typo.h4" GutterBottom="true">Security scans</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Recent imported and acquired files, including completed scans and deleted files.
    Clean, matching files proceed automatically. Files needing review retain their actions below.
    Confirmed malware is deleted automatically; its scan record remains visible.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap" Class="mb-4">
    <MudSelect T="int" Label="Recent files" Value="maximumCount" ValueChanged="ChangeLimitAsync"
               Disabled="loading" Style="max-width: 180px">
        <MudSelectItem T="int" Value="25">25 files</MudSelectItem>
        <MudSelectItem T="int" Value="50">50 files</MudSelectItem>
        <MudSelectItem T="int" Value="100">100 files</MudSelectItem>
    </MudSelect>
</MudStack>
<MudText Typo="Typo.caption" Class="mb-3">Latest @maximumCount files by file activity, newest first. Times are local.</MudText>

@if (loadFailed)
{
    <MudAlert Severity="Severity.Error">Could not refresh security scans. Any displayed records may be out of date.</MudAlert>
}
@if (assets is null && !loadFailed)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading security scans" />
}
else if (assets is null)
{
    <MudButton Variant="Variant.Outlined" OnClick="RefreshAsync">Try again</MudButton>
}
else if (assets.Count == 0)
{
    <MudAlert Severity="Severity.Info">No files have been received yet.</MudAlert>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Outlined="true" Elevation="0">
        @foreach (var asset in assets)
        {
            <MudExpansionPanel @key="asset.AssetId" Gutters="true">
                <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">@asset.WorkTitle</MudText>
                    <MediaTypeChip MediaType="@asset.MediaType" />
                    <MudSpacer />
                    <RequestStatusChip Status="@asset.StorageState" />
                    <RequestStatusChip Status="@ScanStatus(asset)" />
                </MudStack>

                <MudText Typo="Typo.body2" Class="mt-2">
                    @asset.OriginalFilename (@FormatSize(asset.SizeBytes)) — received
                    @asset.CreatedAtUtc.ToLocalTime().ToString("g")
                </MudText>
                </TitleContent>

                <ChildContent>
                <MudStack Spacing="2" Class="pb-2">
                    <MudLink Href="@($"admin/requests/{asset.RequestId}")">View request</MudLink>
                @if (asset.LatestEvaluation is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Scan started @asset.LatestEvaluation.CreatedAtUtc.ToLocalTime().ToString("G")
                        @if (asset.LatestEvaluation.CompletedAtUtc is { } completed)
                        {
                            <span> · Completed @completed.ToLocalTime().ToString("G")</span>
                        }
                        else if (asset.StorageState != "Processing")
                        {
                            <span> · Scan did not complete</span>
                        }
                        else
                        {
                            <span> · In progress</span>
                        }
                    </MudText>
                    <MudStack Spacing="0" Class="mt-2">
                        @foreach (var scan in asset.LatestEvaluation.ScanResults)
                        {
                            <MudText Typo="Typo.caption">
                                Scan (@scan.ScannerId): @scan.Status · @scan.ScannedAtUtc.ToLocalTime().ToString("G")
                                @if (!string.IsNullOrWhiteSpace(scan.ThreatName))
                                {
                                    <span> — @scan.ThreatName</span>
                                }
                            </MudText>
                        }
                        @foreach (var validation in asset.LatestEvaluation.ValidationResults)
                        {
                            <MudText Typo="Typo.caption">
                                Format check (@validation.ValidatorId): @(validation.IsValid ? "Valid" : "Invalid") · @validation.ValidatedAtUtc.ToLocalTime().ToString("G")
                                @if (!string.IsNullOrWhiteSpace(validation.Message))
                                {
                                    <span> — @validation.Message</span>
                                }
                            </MudText>
                        }
                    </MudStack>
                }

                <MudStack Row="true" Spacing="2" Class="mt-3">
                    @if (CanEvaluate(asset))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(busyAssetId is not null)"
                                   OnClick="@(() => EvaluateAsync(asset))">
                            Retry security scan
                        </MudButton>
                    }
                    @if (CanDecide(asset))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Disabled="@(busyAssetId is not null)"
                                   OnClick="@(() => ApproveAsync(asset))">
                            Approve
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Disabled="@(busyAssetId is not null)"
                                   OnClick="@(() => RejectAsync(asset))">
                            Reject
                        </MudButton>
                    }
                    @if (CanRetryIdentity(asset))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(busyAssetId is not null)"
                                   OnClick="@(() => RetryIdentityAsync(asset))">
                            Retry identity check
                        </MudButton>
                    }
                    @if (CanDiscard(asset))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Disabled="@(busyAssetId is not null)"
                                   OnClick="@(() => DiscardAsync(asset))">
                            Delete file
                        </MudButton>
                    }
                </MudStack>
                </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private IReadOnlyList<MediaAssetAdminResponse>? assets;
    private bool loadFailed;
    private Guid? busyAssetId;

    private int maximumCount = 50;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        Observe(LiveUpdateTopics.Security, LoadAsync);
        await RefreshLiveAsync();
    }

    private Task RefreshAsync() => LiveUpdates.RefreshAsync();

    private async Task ChangeLimitAsync(int value)
    {
        maximumCount = value;
        await RefreshLiveAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            assets = await MediaAssets.GetRecentAsync(maximumCount);
            loadFailed = false;
        }
        catch (HttpRequestException exception)
        {
            loadFailed = true;
            if (exception.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
                assets = null;
        }
        finally
        {
            loading = false;
        }
    }

    private static string ScanStatus(MediaAssetAdminResponse asset) => asset.StorageState switch
    {
        "Quarantine" => asset.LatestEvaluation is null ? "AwaitingScan" : "ScanInterrupted",
        "Processing" when asset.LatestEvaluation is null or { Status: "Pending" } => "Scanning",
        _ when asset.LatestEvaluation is { Status: "Pending" } => "ScanIncomplete",
        _ => asset.LatestEvaluation?.Status ?? "NotScanned"
    };

    private static bool CanEvaluate(MediaAssetAdminResponse asset) => asset.StorageState == "Quarantine";

    private static bool CanDecide(MediaAssetAdminResponse asset) =>
        asset.StorageState == "Processing" &&
        asset.LatestEvaluation is { Status: "Passed" or "ReviewRequired" };

    private async Task EvaluateAsync(MediaAssetAdminResponse asset) =>
        await RunAsync(asset, () => MediaAssets.EvaluateAsync(asset.AssetId));

    private async Task ApproveAsync(MediaAssetAdminResponse asset) =>
        await RunAsync(asset, () => MediaAssets.ApproveAsync(asset.AssetId));

    private async Task RetryIdentityAsync(MediaAssetAdminResponse asset) =>
        await RunAsync(asset, () => MediaAssets.RetryIdentityAsync(asset.AssetId));

    private async Task RejectAsync(MediaAssetAdminResponse asset) =>
        await RunAsync(asset, () => MediaAssets.RejectAsync(asset.AssetId));

    private async Task DiscardAsync(MediaAssetAdminResponse asset) =>
        await RunAsync(asset, () => MediaAssets.DiscardAsync(asset.AssetId));

    private async Task RunAsync(MediaAssetAdminResponse asset, Func<Task<MediaAssetActionOutcome>> action)
    {
        var shouldReload = false;
        busyAssetId = asset.AssetId;
        try
        {
            var outcome = await action();
            if (!outcome.Succeeded)
            {
                Snackbar.Add(outcome.Error ?? "That action could not be completed.", Severity.Error);
            }
            shouldReload = true;
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("That action could not be completed. Please try again.", Severity.Error);
        }
        finally
        {
            busyAssetId = null;
        }

        if (!shouldReload)
        {
            return;
        }

        // Reload the persisted state after an action as well as on hub events.
        await RefreshLiveAsync();
    }

    private static bool CanDiscard(MediaAssetAdminResponse asset) =>
        asset.StorageState is "Quarantine" or "Rejected" or "Unmatched";

    private static bool CanRetryIdentity(MediaAssetAdminResponse asset) =>
        asset.StorageState == "Unmatched" && asset.LatestEvaluation?.Status == "Passed";

    private static string FormatSize(long bytes)
    {
        double size = bytes;
        string[] units = ["B", "KB", "MB", "GB"];
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:0.#} {units[unitIndex]}";
    }
}
