@using FamilyLibrarian.Web.Client.Delivery
@page "/admin/publishing"
@inherits LiveComponentBase
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Publishing
@using FamilyLibrarian.Web.Client.Publishing
@using Microsoft.AspNetCore.Authorization
@inject LibraryPublishingApiClient PublishingApi
@inject ISnackbar Snackbar

<PageTitle>Publishing activity · Family Librarian</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Publishing activity</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Review what happened after an approved file was handed to CWA or Audiobookshelf.
</MudText>

@if (loadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the publishing queue.</MudAlert>
}
else if (queue is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading the publishing queue" />
}
else
{
    <MudText Typo="Typo.h6" Class="mb-2">Ebooks → CWA</MudText>
    @if (queue.LibraryImports.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">No ebook publishing attempts yet.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3" Class="mb-6">
            @foreach (var import in queue.LibraryImports)
            {
                <MudPaper Class="pa-4" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudLink Href="@($"admin/requests/{import.RequestId}")">
                            <MudText Typo="Typo.h6">@import.WorkTitle</MudText>
                        </MudLink>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="StatusColor(import.Status)">@import.Status</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        @import.OriginalFilename — staged @import.CreatedAtUtc.ToLocalTime().ToString("g")
                        @if (!string.IsNullOrWhiteSpace(import.ExternalBookId))
                        {
                            <span> — CWA book id @import.ExternalBookId</span>
                        }
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(import.FailureReason))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@import.FailureReason</MudText>
                    }
                    @if (import.Status is "AwaitingVerification" or "Failed")
                    {
                        <MudButton Variant="Variant.Outlined" Class="mt-2" Disabled="@(busyId == import.Id)"
                                   OnClick="@(() => RecheckLibraryImportAsync(import.Id))">
                            Recheck
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudStack>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Audiobooks → Audiobookshelf</MudText>
    @if (queue.Deliveries.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No audiobook publishing attempts yet.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var delivery in queue.Deliveries)
            {
                <MudPaper Class="pa-4" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudLink Href="@($"admin/requests/{delivery.RequestId}")">
                            <MudText Typo="Typo.h6">@delivery.WorkTitle</MudText>
                        </MudLink>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="StatusColor(delivery.Status)">@delivery.Status</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        @delivery.OriginalFilename — staged @delivery.CreatedAtUtc.ToLocalTime().ToString("g")
                        @if (!string.IsNullOrWhiteSpace(delivery.ExternalItemId))
                        {
                            <span> — Audiobookshelf item @delivery.ExternalItemId</span>
                        }
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(delivery.FailureReason))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@delivery.FailureReason</MudText>
                    }
                    @if (delivery.Status is "Verifying" or "Failed")
                    {
                        <MudButton Variant="Variant.Outlined" Class="mt-2" Disabled="@(busyId == delivery.Id)"
                                   OnClick="@(() => RecheckDeliveryAsync(delivery.Id))">
                            Recheck
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudStack>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6">Ebooks → Kindle</MudText>
        @if (AttentionCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error">@AttentionCount needing attention</MudChip>
        }
        @if (queue.DeliveryAttempts.Count > 0)
        {
            <MudSpacer />
            <MudSwitch T="bool" Value="showOnlyAttention" ValueChanged="@((bool v) => showOnlyAttention = v)"
                       Color="Color.Error" Label="Needs attention only" Class="mt-0" />
        }
    </MudStack>
    @if (queue.DeliveryAttempts.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No Kindle delivery attempts yet.</MudAlert>
    }
    else if (showOnlyAttention && AttentionCount == 0)
    {
        <MudAlert Severity="Severity.Success">Nothing needs attention right now.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var attempt in VisibleAttempts)
            {
                <MudPaper Class="pa-4" Elevation="1" data-attempt-id="@attempt.Id"
                          Style="@(attempt.NeedsAttention ? "border-left: 4px solid var(--mud-palette-error);" : null)">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        @if (attempt.RequestId is { } requestId)
                        {
                            <MudLink Href="@($"admin/requests/{requestId}")">
                                <MudText Typo="Typo.h6">@(attempt.WorkTitle ?? "Untitled")</MudText>
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">@(attempt.WorkTitle ?? "Existing library book")</MudText>
                        }
                        <MudSpacer />
                        @if (attempt.NeedsAttention)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Needs attention</MudChip>
                        }
                        <KindleStatusChip Status="@attempt.Status" ConfirmationStatus="@attempt.ConfirmationStatus" />
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        Requested by @attempt.RequesterDisplayName (@attempt.RequesterEmail) —
                        attempt @attempt.AttemptNumber, @attempt.CreatedAtUtc.ToLocalTime().ToString("g")
                        — CWA book id @attempt.ExternalBookId
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(attempt.FailureReason))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@attempt.FailureReason</MudText>
                    }
                    @if (attempt.ConfirmedAtUtc is { } answered)
                    {
                        <MudText Typo="Typo.caption">Receipt answer updated @answered.ToLocalTime().ToString("g")</MudText>
                    }
                    @if (attempt.NextAutomaticRetryAtUtc is { } retryAt)
                    {
                        <MudText Typo="Typo.caption">Automatic retry eligible after @retryAt.ToLocalTime().ToString("g"); next eligible worker sweep, subject to recipient checks.</MudText>
                    }
                    @if (attempt.AutomaticRetriesExhausted)
                    {
                        <MudText Typo="Typo.caption">Automatic retries exhausted.</MudText>
                    }
                    @if (attempt.CanRetry)
                    {
                        <MudButton Variant="Variant.Outlined" Class="mt-2" Disabled="@(busyId == attempt.Id)"
                                   OnClick="@(() => RetryDeliveryAttemptAsync(attempt.Id, attempt.Status == "SubmissionUnknown"))">
                            @(attempt.Status == "SubmissionUnknown" ? "Resend (may create a duplicate)" : "Retry")
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudStack>
    }
}

@code {
    private PublishingQueueResponse? queue;
    private bool loadFailed;
    private Guid? busyId;
    private bool showOnlyAttention;

    private int AttentionCount => queue?.DeliveryAttempts.Count(a => a.NeedsAttention) ?? 0;

    private IEnumerable<DeliveryAttemptResponse> VisibleAttempts =>
        (queue?.DeliveryAttempts ?? [])
            .Where(a => a.IsLatest && (!showOnlyAttention || a.NeedsAttention))
            .OrderByDescending(a => a.NeedsAttention)
            .ThenByDescending(a => a.CreatedAtUtc);

    protected override async Task OnInitializedAsync()
    {
        Observe(LiveUpdateTopics.Publishing, LoadAsync);
        await RefreshLiveAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            queue = await PublishingApi.GetQueueAsync();
            loadFailed = false;
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    private async Task RecheckLibraryImportAsync(Guid id)
    {
        busyId = id;
        try
        {
            var succeeded = await PublishingApi.RecheckLibraryImportAsync(id);
            if (!succeeded)
            {
                Snackbar.Add("That recheck could not be completed.", Severity.Error);
                return;
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("That recheck could not be completed. Please try again.", Severity.Error);
            return;
        }
        finally
        {
            busyId = null;
        }

        await LoadAsync();
    }

    private async Task RecheckDeliveryAsync(Guid id)
    {
        busyId = id;
        try
        {
            var succeeded = await PublishingApi.RecheckDeliveryAsync(id);
            if (!succeeded)
            {
                Snackbar.Add("That recheck could not be completed.", Severity.Error);
                return;
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("That recheck could not be completed. Please try again.", Severity.Error);
            return;
        }
        finally
        {
            busyId = null;
        }

        await LoadAsync();
    }

    private async Task RetryDeliveryAttemptAsync(Guid id, bool confirmPossibleDuplicate)
    {
        busyId = id;
        try
        {
            var succeeded = await PublishingApi.RetryDeliveryAttemptAsync(id, confirmPossibleDuplicate: confirmPossibleDuplicate);
            if (!succeeded)
            {
                Snackbar.Add("That retry could not be sent.", Severity.Error);
                return;
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("That retry could not be sent. Please try again.", Severity.Error);
            return;
        }
        finally
        {
            busyId = null;
        }

        await LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Available" or "Delivered" or "Submitted" => Color.Success,
        "Failed" => Color.Error,
        "AwaitingVerification" or "Verifying" or "Pending" or "Submitting" => Color.Warning,
        _ => Color.Default
    };
}
