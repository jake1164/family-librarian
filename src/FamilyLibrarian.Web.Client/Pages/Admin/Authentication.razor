@page "/settings/authentication"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.Authentication
@using FamilyLibrarian.Web.Client.Authentication
@using Microsoft.AspNetCore.Authorization
@inject OidcSettingsApiClient OidcApi
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Authentication | Family Librarian</PageTitle>
<SettingsDraftGuard IsDirty="@(IsDirty)" />

<MudText Typo="Typo.h4" GutterBottom="true">Authentication</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Optional single sign-on through any standards-compliant OIDC identity provider —
    configured entirely here, no environment variables. Local sign-in keeps working
    alongside it until you choose to disable it below. Anyone your identity provider
    lets reach this application signs in immediately, with no separate approval step
    here — control access on the identity provider's side (e.g. which users/groups
    it assigns to this application).
</MudText>

@if (loadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load the authentication settings.</MudAlert>
}
else if (settings is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading authentication settings" />
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">OpenID Connect</MudText>
            <MudSpacer />
            <SettingSwitch Value="settings.IsEnabled" Changing="SetEnabledAsync" Disabled="@busy" AlignEnd="true"
                           Label="@(settings.IsEnabled ? "Enabled" : "Disabled")" aria-label="OpenID Connect" />
        </MudStack>

        <MudDivider Class="my-3" />

        <MudStack Spacing="3">
            <MudTextField Immediate="true" T="string" Label="Button label" @bind-Value="displayName" Disabled="@busy"
                          HelperText="Shown on the sign-in page (e.g. Sign in with Authentik)." />
            <MudTextField Immediate="true" T="string" Label="Issuer (Authority) URL" @bind-Value="authority" Disabled="@busy"
                          HelperText="Everything else — authorize, token, userinfo, JWKS — is resolved from here automatically." />
            <MudTextField Immediate="true" T="string" Label="Client ID" @bind-Value="clientId" Disabled="@busy" />
            <MudTextField Immediate="true" T="string" Label="Scopes" @bind-Value="scopes" Disabled="@busy" />

            <MudStack Row="true" Spacing="3">
                <MudTextField Immediate="true" T="string" Label="Match claim" @bind-Value="matchClaimName" Disabled="@busy"
                              HelperText="Links a sign-in to an existing account by this claim." Class="flex-grow-1" />
                <MudTextField Immediate="true" T="string" Label="Admin claim name" @bind-Value="adminClaimName" Disabled="@busy" Class="flex-grow-1" />
                <MudTextField Immediate="true" T="string" Label="Admin claim values" @bind-Value="adminClaimValues" Disabled="@busy"
                              HelperText="Comma-separated. Any match grants the Admin role." Class="flex-grow-1" />
            </MudStack>
        </MudStack>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">Client secret</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(settings.HasClientSecret
                ? $"A secret ending in {settings.ClientSecretHint} was saved {settings.ClientSecretSetAtUtc?.ToLocalTime().ToString("f")}."
                : "No secret is stored yet.")
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudTextField Immediate="true" T="string" @bind-Value="clientSecretDraft" Label="Replace client secret"
                          InputType="InputType.Password" Disabled="@busy" Class="flex-grow-1"
                          HelperText="@(string.IsNullOrWhiteSpace(clientSecretDraft) ? null : "Not saved yet -- click Save settings.")" />
            @if (settings.HasClientSecret)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@busy" OnClick="ClearClientSecretAsync">
                    Remove
                </MudButton>
            }
        </MudStack>

        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="SaveSettingsAsync">
            Save settings
        </MudButton>

        <MudDivider Class="my-3" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudButton Variant="Variant.Outlined" Disabled="@busy" OnClick="TestAsync">Test connection</MudButton>
            @if (testResult is null && settings.LastTestedAtUtc is not null)
            {
                <MudText Typo="Typo.body2">
                    <MudIcon Icon="@(settings.LastTestSucceeded == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                             Color="@(settings.LastTestSucceeded == true ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    @settings.LastTestMessage
                </MudText>
            }
        </MudStack>

        @if (testResult is not null)
        {
            <MudAlert Severity="@(testResult.Succeeded ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-3" role="status">
                @testResult.Message
            </MudAlert>
        }

        @if (lastTestEndpoints is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption">Authorize: @lastTestEndpoints.AuthorizationEndpoint</MudText>
                    <MudText Typo="Typo.caption">Token: @lastTestEndpoints.TokenEndpoint</MudText>
                    <MudText Typo="Typo.caption">Userinfo: @lastTestEndpoints.UserinfoEndpoint</MudText>
                    <MudText Typo="Typo.caption">JWKS: @lastTestEndpoints.JwksUri</MudText>
                    <MudText Typo="Typo.caption">Logout: @lastTestEndpoints.EndSessionEndpoint</MudText>
                </MudStack>
            </MudAlert>
        }

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">Local sign-in</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Disabling local sign-in leaves it working for one break-glass account only —
            the administrator created when this deployment was first started.
        </MudText>
        <SettingSwitch Value="settings.LocalLoginDisabled" Changing="SetLocalLoginDisabledAsync" Color="Color.Warning" Disabled="@busy"
                       WorkingText="@(settings.LastTestSucceeded == true ? "Saving…" : "Testing the sign-in server…")"
                       ConfirmTitle="Disable local sign-in?" ConfirmYes="Disable local sign-in"
                       ConfirmOn="Everyone except the emergency administrator account will have to sign in through your identity provider. Check that signing in that way works first: the connection test only confirms the server can be reached."
                       Label="@(settings.LocalLoginDisabled ? "Local sign-in disabled" : "Local sign-in enabled")" />
        <MudText Typo="Typo.caption">
            Disabling it first tests the saved issuer URL if that has not passed a test yet.
        </MudText>
    </MudPaper>
}

@code {
    private readonly SettingsSnapshot draft = new();
    private object SettingsFields => new { displayName, authority, clientId, scopes, matchClaimName, adminClaimName, adminClaimValues };
    private OidcSettingsResponse? settings;
    private bool loadFailed;
    private bool busy;
    private OidcConnectionTestResponse? lastTestEndpoints;
    private OidcConnectionTestResponse? testResult;

    private string? displayName;
    private string? authority;
    private string? clientId;
    private string scopes = "openid profile email";
    private string matchClaimName = "email";
    private string? adminClaimName = "groups";
    private string? adminClaimValues;
    private string? clientSecretDraft;

    private bool IsDirty => draft.HasChanges("settings", SettingsFields) || !string.IsNullOrEmpty(clientSecretDraft);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            settings = await OidcApi.GetAsync();
            ApplyFields(settings);
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    private void ApplyFields(OidcSettingsResponse? source)
    {
        if (source is null)
        {
            return;
        }

        displayName = source.DisplayName;
        authority = source.Authority;
        clientId = source.ClientId;
        scopes = source.Scopes;
        matchClaimName = source.MatchClaimName;
        adminClaimName = source.AdminClaimName;
        adminClaimValues = source.AdminClaimValues;
        draft.Accept("settings", SettingsFields);
    }

    private Task SetEnabledAsync(SettingSwitchChange change) => SwitchAsync(
        change, () => OidcApi.SetEnabledAsync(change.Value),
        change.Value ? "OpenID Connect enabled." : "OpenID Connect disabled.");

    private Task SetLocalLoginDisabledAsync(SettingSwitchChange change) => SwitchAsync(
        change, () => OidcApi.SetLocalLoginDisabledAsync(change.Value),
        change.Value ? "Local sign-in disabled." : "Local sign-in enabled.");

    private async Task SwitchAsync(SettingSwitchChange change, Func<Task<OidcResult>> action, string successMessage)
    {
        if (change.Value && IsDirty)
        {
            change.Refuse("Save settings first. This uses the saved settings.");
            return;
        }

        busy = true;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                change.Refuse(result.Error);
                settings = await OidcApi.GetAsync();
                return;
            }

            settings = result.Settings;
            Snackbar.Saved(successMessage);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        busy = true;
        try
        {
            var result = await OidcApi.SetSettingsAsync(new SetOidcSettingsRequest(
                displayName ?? "Sign in with SSO", authority, clientId, scopes, matchClaimName,
                adminClaimName, adminClaimValues, clientSecretDraft));
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error);
                return;
            }

            // The secret is dropped from the page as soon as the host has it.
            clientSecretDraft = null;
            settings = result.Settings;
            ApplyFields(settings);
            Snackbar.Saved("Authentication settings saved.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ClearClientSecretAsync()
    {
        if (!await Dialogs.ConfirmRemovalAsync("Remove client secret?",
                "The stored secret is deleted. Single sign-on stops working until you enter one again."))
        {
            return;
        }

        busy = true;
        try
        {
            var result = await OidcApi.ClearClientSecretAsync();
            if (!result.Succeeded)
            {
                Snackbar.Failed(result.Error);
                return;
            }

            // Anything typed and not yet saved stays in the form.
            settings = result.Settings;
            Snackbar.Saved("Client secret removed.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TestAsync()
    {
        busy = true;
        try
        {
            var result = await OidcApi.TestAsync(authority);
            if (result is null)
            {
                Snackbar.Failed("The connection test could not be run.");
                return;
            }

            lastTestEndpoints = result.Succeeded ? result : null;
            testResult = result;
            // The host records the result only when the tested URL is the saved one, so ask it what is recorded.
            settings = await OidcApi.GetAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
