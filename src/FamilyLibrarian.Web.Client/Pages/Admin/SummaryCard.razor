@inject IJSRuntime JS

@if (!string.IsNullOrWhiteSpace(TargetElementId))
{
    <MudPaper Outlined="true" Class="pa-2 task-summary-metric summary-card-link"
              @onclick="@(() => JS.InvokeVoidAsync("familyLibrarian.scrollToElement", TargetElementId))"
              @onkeydown="@(async e => { if (e.Key is "Enter" or " ") { await JS.InvokeVoidAsync("familyLibrarian.scrollToElement", TargetElementId); } })"
              tabindex="0" role="button" aria-label="@($"Jump to {Label}")"
              Style="cursor:pointer;width:100%;min-height:4.5rem;">
        @MetricContent
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Class="pa-2 task-summary-metric" Style="width:100%;min-height:4.5rem;">
        @MetricContent
    </MudPaper>
}

@code {
    private RenderFragment MetricContent => @<text>
        <div style="display:flex;align-items:center;gap:8px;">
            <MudIcon Icon="@Icon" Color="@Color" Size="Size.Small" aria-hidden="true" />
            <MudText Typo="Typo.caption" Style="flex:1;line-height:1.3;">@Label</MudText>
            <MudText Typo="Typo.h6" Color="@Color" Style="line-height:1;flex-shrink:0;">@Value</MudText>
        </div>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.caption" Class="mt-1" Style="line-height:1.3;">@Description</MudText>
        }
    </text>;

    [Parameter, EditorRequired]
    public string Icon { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Label { get; set; } = null!;

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public Color Color { get; set; } = Color.Default;

    /// <summary>
    /// Id of the element on this same page to scroll to when clicked. A plain
    /// href="#id" would get intercepted by Blazor's router and resolved
    /// against the app's base URI (navigating to "/" instead of scrolling
    /// within the current page), so this scrolls via JS interop instead.
    /// </summary>
    [Parameter]
    public string? TargetElementId { get; set; }
}
