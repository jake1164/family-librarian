@using FamilyLibrarian.Contracts.ModelGateway
@using FamilyLibrarian.Web.Client.ModelGateway

<MudPaper Outlined="true" Class="pa-4" id="tasks-ai-usage">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">AI activity · @WindowLabel</MudText>
        <MudSelect T="int" Value="Days" ValueChanged="DaysChanged" Label="Period" Variant="Variant.Outlined" Dense="true" Style="min-width: 10rem;"
                   Disabled="Loading" aria-label="AI activity period">
            <MudSelectItem Value="1">Last 24 hours</MudSelectItem>
            <MudSelectItem Value="7">Last 7 days</MudSelectItem>
            <MudSelectItem Value="30">Last 30 days</MudSelectItem>
            <MudSelectItem Value="90">Last 90 days</MudSelectItem>
        </MudSelect>
        <MudSpacer />
        <MudButton OnClick="Refresh" Disabled="Loading" Variant="Variant.Text">Refresh AI activity</MudButton>
        <MudLink Href="admin/ai-failures">AI diagnostics</MudLink>
        <MudLink Href="admin/model-gateway">AI settings</MudLink>
    </MudStack>
    @if (Failed)
    {
        <MudAlert Severity="Severity.Warning">AI activity could not be loaded. Refresh to try again.</MudAlert>
    }
    else if (Settings is null || Usage is null)
    {
        <MudText>Loading AI activity…</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            @(Settings.IsEnabled ? "AI models are on." : "AI models are off.")
            Actual model calls since @Usage.SinceUtc.ToLocalTime().ToString("g").
            Counts survive restarts and include earlier calls to features now off. Reused decisions and requests blocked
            before a model call are not counted. Accepted replies passed response validation; a valid hold, rejection of a book,
            or uncertain assessment still belongs here. Rejected replies were received but failed response validation, such as
            unsupported evidence or a repeated search. Provider errors include timeouts, connection errors and unavailable models.
            These categories describe the call and reply; they do not mean a book failed.
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Provider replies measures responses received versus provider errors. Accepted replies measures how many received responses
            passed validation, including evidence checks where required. Pending and cancelled calls are excluded from both rates.
            A high rate does not prove accuracy or usefulness: prompts, settings and available evidence also affect results.
            Calls to tracks or repeated inputs are not independent quality tests.
        </MudText>
        <MudTable Items="Settings.Roles" Dense="true" Hover="true" TableAttributes="TableAttributes">
            <HeaderContent>
                <MudTh>Feature</MudTh><MudTh>Currently</MudTh><MudTh>Calls</MudTh><MudTh>Accepted replies</MudTh><MudTh>Rejected replies</MudTh><MudTh>Provider errors</MudTh>
                @if (ShowCancelled) { <MudTh>Cancelled</MudTh> }
                @if (ShowUnclassified) { <MudTh>Unclassified</MudTh> }
                <MudTh>Pending</MudTh><MudTh>Quality signals</MudTh><MudTh>Workflow impact</MudTh><MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var rows = Usage.Rows.Where(row => row.Role == context.Role).ToArray(); var metrics = AiQualityMetrics.From(rows); }
                <MudTd DataLabel="Feature">@ModelRoleLabels.Title(context.Role)</MudTd>
                <MudTd DataLabel="Currently">@(Settings.IsEnabled && context.IsEnabled ? "Enabled" : "Off")</MudTd>
                <MudTd DataLabel="Calls">@rows.Sum(row => row.Calls)</MudTd>
                <MudTd DataLabel="Accepted replies">@metrics.Usable</MudTd>
                <MudTd DataLabel="Rejected replies"><AiOutcomeCount Count="metrics.UnusableReplies" Role="@context.Role" Category="@ModelCallCategories.RejectedReply" /></MudTd>
                <MudTd DataLabel="Provider errors"><AiOutcomeCount Count="metrics.ProviderErrors" Role="@context.Role" Category="@ModelCallCategories.ProviderError" /></MudTd>
                @if (ShowCancelled) { <MudTd DataLabel="Cancelled"><AiOutcomeCount Count="metrics.Cancelled" Role="@context.Role" Category="@ModelCallCategories.Cancelled" /></MudTd> }
                @if (ShowUnclassified) { <MudTd DataLabel="Unclassified"><AiOutcomeCount Count="metrics.Unclassified" Role="@context.Role" Category="@ModelCallCategories.Unknown" /></MudTd> }
                <MudTd DataLabel="Pending">@metrics.Pending</MudTd>
                <MudTd DataLabel="Quality signals"><AiQualitySignal Metrics="metrics" /></MudTd>
                <MudTd DataLabel="Workflow impact"><AiWorkflowSignal Metrics="@AiWorkflowMetrics.From(rows)" /></MudTd>
                @{ var status = AiRoleStatus.From(rows); }
                <MudTd DataLabel="Status"><strong>@status.Label</strong><br /><span class="mud-typography-caption">@status.Reason</span></MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-2">
            Status is a fixed rule over these counts, not a quality score. "Failing": more than half of at least @AiRoleStatus.MinAcceptedCalls evaluated calls
            were rejected or errored. "Too little data": fewer than @AiRoleStatus.MinAcceptedCalls accepted calls. "Doing work": a workflow action was applied
            or advice was saved. "Safe but idle": accepted calls agreed, abstained or changed nothing. None of these says an answer was right.
        </MudText>
        @if (Usage.Latency is { Count: > 0 } latency)
        {
            <details class="mt-3">
                <summary>Speed and tokens by model</summary>
                <MudText Typo="Typo.body2" Class="my-2">
                    How long finished calls took (median and 95th percentile, real values, not averages) and the tokens providers reported. A call
                    whose provider reported no usage adds no tokens here.
                </MudText>
                <MudTable Items="latency" Dense="true" Outlined="true" Breakpoint="Breakpoint.Sm" TableAttributes="LatencyTableAttributes">
                    <HeaderContent><MudTh>Feature</MudTh><MudTh>Model</MudTh><MudTh>Calls</MudTh><MudTh>Median</MudTh><MudTh>95th percentile</MudTh><MudTh>Reported tokens</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Feature">@ModelRoleLabels.Title(context.Role)@(context.IsCloud ? " (cloud)" : "")</MudTd>
                        <MudTd DataLabel="Model">@context.Model</MudTd>
                        <MudTd DataLabel="Calls">@context.Calls</MudTd>
                        <MudTd DataLabel="Median">@Seconds(context.MedianMilliseconds)</MudTd>
                        <MudTd DataLabel="95th percentile">@Seconds(context.P95Milliseconds)</MudTd>
                        <MudTd DataLabel="Reported tokens">@context.ReportedTokens.ToString("N0")</MudTd>
                    </RowTemplate>
                </MudTable>
            </details>
        }
        <details class="mt-3">
            <summary>Quality by model and recorded recommendations</summary>
            <MudText Typo="Typo.body2" Class="my-2">
                Models are the aliases actually used, including earlier settings. Recommendation counts come from saved validated assessments;
                they are separate from call counts and do not establish that a recommendation was applied or helped.
                Uncertainty, no objection and keeping the current choice can be appropriate answers. Workflow effects are observed application use,
                not proof of accuracy or net benefit. Counts are calls used at least once, not numbers of actions; one call can have several effects,
                including later reuse. Historical calls without observations are untracked.
            </MudText>
            <AiModelQualityTable Usage="Usage" />
        </details>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> TableAttributes = new() { ["aria-label"] = "AI calls by feature" };
    [Parameter] public ModelGatewaySettingsResponse? Settings { get; set; }
    [Parameter] public ModelUsageResponse? Usage { get; set; }
    [Parameter] public bool Failed { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public int Days { get; set; } = 1;
    [Parameter] public EventCallback<int> DaysChanged { get; set; }
    private static readonly Dictionary<string, object?> LatencyTableAttributes = new() { ["aria-label"] = "Speed and tokens by model" };
    private string WindowLabel => Days switch { 7 => "last 7 days", 30 => "last 30 days", 90 => "last 90 days", _ => "last 24 hours" };
    private static string Seconds(long milliseconds) => milliseconds < 1000 ? $"{milliseconds} ms" : $"{milliseconds / 1000.0:0.0} s";
    private bool ShowCancelled => Usage?.Rows.Any(row => ModelCallCategories.Classify(row.Outcome, row.ReasonCode) == ModelCallCategories.Cancelled) == true;
    private bool ShowUnclassified => Usage?.Rows.Any(row => ModelCallCategories.Classify(row.Outcome, row.ReasonCode) == ModelCallCategories.Unknown) == true;
}
