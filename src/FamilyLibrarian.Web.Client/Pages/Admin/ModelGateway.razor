@page "/admin/model-gateway"
@attribute [Authorize(Roles = "Admin")]
@using FamilyLibrarian.Contracts.ModelGateway
@using FamilyLibrarian.Web.Client.ModelGateway
@inject ModelGatewayApiClient Api

<PageTitle>AI models · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">AI models</MudText>
        <MudText Typo="Typo.body1">
            Everything here is off until you turn it on. Family Librarian only asks a model for advice: it can never accept a match,
            approve a request, lift a security hold, acquire or publish anything, and if a model is unavailable the deterministic
            behaviour carries on unchanged. Each role runs on exactly the model you choose for it, and there is no automatic fall
            back from a local model to a cloud one.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@(messageIsError ? Severity.Error : Severity.Success)" role="status">@message</MudAlert>
    }

    @if (settings is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading settings" />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5">Connection</MudText>
                <MudTextField @bind-Value="endpoint" Label="Endpoint URL" Variant="Variant.Outlined"
                              HelperText="Any OpenAI-compatible endpoint, for example your LiteLLM address (no credentials or query string)." />
                <MudSwitch T="bool" @bind-Value="allowCloud" Color="Color.Warning"
                           Label="Allow roles to use cloud models (can send book data off this server and use paid or rate-limited services)" />

                <MudText Typo="Typo.h5">Roles</MudText>
                @foreach (var role in roles)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudSwitch T="bool" @bind-Value="role.IsEnabled" Color="Color.Primary" Label="@Title(role.Role)" />
                            <MudText Typo="Typo.body2">@Describe(role.Role)</MudText>
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                <MudSelect T="string" @bind-Value="role.Placement" Label="Runs on" Variant="Variant.Outlined" Style="min-width: 12rem;">
                                    <MudSelectItem Value="@("Local")">Local model</MudSelectItem>
                                    <MudSelectItem Value="@("Cloud")" Disabled="@(!allowCloud)">Cloud model</MudSelectItem>
                                </MudSelect>
                                <MudTextField @bind-Value="role.LocalModel" Label="Local model alias" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="role.CloudModel" Label="Cloud model alias" Variant="Variant.Outlined" Disabled="@(!allowCloud)" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="SaveAsync">Save settings</MudButton>

                <MudDivider />
                <MudText Typo="Typo.h6">API key</MudText>
                <MudText Typo="Typo.body2">@(settings.HasApiKey ? "A key is stored (it cannot be shown again)." : "No key is stored.")</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="apiKey" Label="New API key" InputType="InputType.Password" Variant="Variant.Outlined"
                                  Class="flex-grow-1" />
                    <MudButton Variant="Variant.Outlined" Disabled="@(busy || string.IsNullOrWhiteSpace(apiKey))" OnClick="SetApiKeyAsync">Store key</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@(busy || !settings.HasApiKey)" OnClick="ClearApiKeyAsync">Remove key</MudButton>
                </MudStack>

                <MudDivider />
                <MudSwitch T="bool" Value="settings.IsEnabled" ValueChanged="SetEnabledAsync" Color="Color.Primary" Disabled="@busy"
                           Label="AI models are enabled (master switch)" />
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private sealed class RoleEdit
    {
        public string Role { get; init; } = string.Empty;
        public bool IsEnabled { get; set; }
        public string Placement { get; set; } = "Local";
        public string? LocalModel { get; set; }
        public string? CloudModel { get; set; }
    }

    private ModelGatewaySettingsResponse? settings;
    private List<RoleEdit> roles = [];
    private string endpoint = string.Empty;
    private bool allowCloud;
    private string apiKey = string.Empty;
    private bool busy;
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Apply(await Api.GetAsync());
        }
        catch (HttpRequestException)
        {
            message = "Settings could not be loaded.";
            messageIsError = true;
        }
    }

    private void Apply(ModelGatewaySettingsResponse value)
    {
        settings = value;
        endpoint = value.EndpointUrl ?? string.Empty;
        allowCloud = value.AllowCloud;
        roles = [.. value.Roles.Select(role => new RoleEdit
        {
            Role = role.Role, IsEnabled = role.IsEnabled, Placement = role.Placement, LocalModel = role.LocalModel, CloudModel = role.CloudModel
        })];
    }

    private async Task SaveAsync() => await ApplyResultAsync(
        await Api.SaveAsync(new SaveModelGatewaySettingsRequest(
            endpoint, allowCloud,
            [.. roles.Select(role => new ModelRoleDto(role.Role, role.IsEnabled, role.Placement, role.LocalModel, role.CloudModel))])),
        "Settings saved.");

    private async Task SetApiKeyAsync()
    {
        await ApplyResultAsync(await Api.SetApiKeyAsync(apiKey), "API key stored.");
        apiKey = string.Empty;
    }

    private async Task ClearApiKeyAsync() => await ApplyResultAsync(await Api.ClearApiKeyAsync(), "API key removed.");

    private async Task SetEnabledAsync(bool enabled) => await ApplyResultAsync(await Api.SetEnabledAsync(enabled), enabled ? "AI models are on." : "AI models are off.");

    private async Task ApplyResultAsync(ModelGatewayCallResult<ModelGatewaySettingsResponse> result, string success)
    {
        busy = true;
        try
        {
            messageIsError = !result.Succeeded;
            message = result.Succeeded ? success : result.Error;
            if (result.Value is { } value) Apply(value);
        }
        finally
        {
            busy = false;
        }
    }

    private static string Title(string role) => role switch
    {
        "IntentInterpretation" => "Understand book requests",
        "ConversationResponse" => "Phrase conversational replies",
        "CandidateAmbiguityAssessment" => "Assess ambiguous candidates",
        "ArtifactValidationAssessment" => "Assess downloaded files",
        "VisionCoverIdentification" => "Identify books from cover images",
        _ => role
    };

    private static string Describe(string role) => role switch
    {
        "IntentInterpretation" => "Interprets a chat message the built-in parser did not recognise. It can suggest what was asked; it cannot act.",
        "ConversationResponse" => "Rewords replies. Never decides anything.",
        "CandidateAmbiguityAssessment" => "Adds a note to candidates the matcher could not tell apart. Shown to administrators only; it never changes the match.",
        "ArtifactValidationAssessment" => "Adds a note to a file's recorded evidence. Shown to administrators only; it never lifts a hold.",
        "VisionCoverIdentification" => "Needs a vision-capable model. A suggestion is only a lead: it must be confirmed against a metadata lookup.",
        _ => string.Empty
    };
}
