@page "/settings/ebook-delivery"
@attribute [Authorize]
@using FamilyLibrarian.Web.Client.Delivery
@using FamilyLibrarian.Web.Client.Setup
@inject DeliveryTargetApiClient DeliveryTargets
@inject SetupApiClient SetupApi
@inject ISnackbar Snackbar

<PageTitle>Ebook delivery · Family Librarian</PageTitle>
<SettingsDraftGuard IsDirty="@(draft.HasChanges("delivery", DeliveryFields))" />

<MudText Typo="Typo.h4" GutterBottom="true">Ebook delivery</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Add a Kindle email address so an ebook can be sent straight to your device once it's
    ready, in addition to reading it in the library. Only you and household administrators
    can see this address.
</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading ebook delivery settings" />
}
else
{
    @if (isAvailable == false)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Kindle delivery isn't available yet. An administrator needs to set up the delivery service.
            @if (hasTarget)
            {
                <text>Your saved Kindle address is kept, but books can't be sent to it until then.</text>
            }
            <AuthorizeView Roles="Admin">
                <MudLink Href="settings/publishing">Set it up in Publishing settings</MudLink>
            </AuthorizeView>
        </MudAlert>
    }

    @if (guidance is not null)
    {
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="How to set up your Kindle" @key="hadTargetAtLoad" Expanded="!hadTargetAtLoad">
                <KindleSetupGuide Guidance="guidance" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudPaper Class="pa-4" Outlined="true">
        @if (hasTarget)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudText Typo="Typo.h6">Kindle</MudText>
                <MudSpacer />
                <SettingSwitch Value="isEnabled" Changing="SetEnabledAsync" Disabled="@busy" AlignEnd="true"
                               Label="@(isEnabled ? "Enabled" : "Disabled")" aria-label="Kindle delivery" />
            </MudStack>
            <MudDivider Class="mb-3" />
        }

        <MudStack Spacing="3">
            <MudTextField Immediate="true" T="string"
                          @bind-Value="address"
                          Label="Kindle email address"
                          Disabled="@(busy || !CanEdit)"
                          HelperText="@("Your Kindle's own address, usually ending in @kindle.com.")" />
            @if (KindleAddress.Warning(address) is { } addressWarning)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@addressWarning</MudAlert>
            }

            <div>
                <MudCheckBox T="bool"
                             @bind-Value="sendByDefault"
                             Label="Send to my Kindle by default when I request an ebook"
                             Disabled="@(busy || !CanEdit)" />
                <MudText Typo="Typo.caption">You can always uncheck it for a specific request.</MudText>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !CanEdit)" OnClick="SaveAddressAsync">
                    @(hasTarget ? "Save" : "Add Kindle")
                </MudButton>
            </div>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Outlined="true">
        @if (hasTarget || isAvailable == true)
        {
            <MudLink Href="deliveries">View my Kindle deliveries and confirm receipt</MudLink>
        }
        <MudText Typo="Typo.h6" GutterBottom="true">Test service sign-in</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Checks that the shared delivery service account can sign in — it does not send a
            book or verify send permissions, SMTP configuration, or Kindle receipt.
            To send a book, choose Kindle delivery on a request or use Send to Kindle on an existing library book.
        </MudText>
        <MudButton Variant="Variant.Outlined" Disabled="@(testBusy || isAvailable != true)" OnClick="TestKindleDeliveryAsync">
            Test service sign-in
        </MudButton>
        @if (testResult is not null)
        {
            <MudAlert Severity="@(testResult.Value.Succeeded ? Severity.Success : Severity.Warning)" Class="mt-3" role="status">
                @testResult.Value.Message
            </MudAlert>
        }
    </MudPaper>
}

@code {
    private readonly SettingsSnapshot draft = new();
    private object DeliveryFields => new { address, sendByDefault };
    private bool isLoading = true;
    private bool busy;
    private bool testBusy;
    private (bool Succeeded, string Message)? testResult;
    private bool hasTarget;
    private bool hadTargetAtLoad;
    // Null while delivery isn't set up, or if it could not be read: the page works without the instructions.
    private FamilyLibrarian.Contracts.Setup.KindleGuidanceResponse? guidance;
    // Null means the lookup failed: controls that need the service stay disabled
    // without claiming it isn't set up.
    private bool? isAvailable;
    private bool CanEdit => hasTarget || isAvailable == true;
    private bool isEnabled;
    private bool sendByDefault = true;
    private string address = string.Empty;
    private uint? version;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var target = await DeliveryTargets.GetMyKindleTargetAsync();
            ApplyTarget(target);
            hadTargetAtLoad = hasTarget;
            isAvailable = await DeliveryTargets.IsKindleDeliveryAvailableAsync();
            guidance = (await SetupApi.GetAsync())?.Kindle;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Your ebook delivery settings could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAddressAsync()
    {
        busy = true;
        errorMessage = null;

        try
        {
            var outcome = await DeliveryTargets.SetKindleAddressAsync(address, version, sendByDefault);
            if (outcome.Succeeded && outcome.Target is { } target)
            {
                ApplyTarget(target);
                Snackbar.Saved("Kindle delivery settings saved.");
            }
            else
            {
                errorMessage = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "That could not be saved. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetEnabledAsync(SettingSwitchChange change)
    {
        if (version is not { } expectedVersion)
        {
            change.Refuse("Reload this page and try again.");
            return;
        }

        busy = true;
        errorMessage = null;

        try
        {
            var outcome = await DeliveryTargets.SetKindleEnabledAsync(change.Value, expectedVersion);
            if (outcome.Succeeded && outcome.Target is { } target)
            {
                ApplyTarget(target, applyFields: false);
                Snackbar.Saved(change.Value ? "Kindle delivery enabled." : "Kindle delivery disabled.");
            }
            else
            {
                change.Refuse(outcome.Error);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TestKindleDeliveryAsync()
    {
        testBusy = true;
        testResult = null;

        try
        {
            var result = await DeliveryTargets.TestKindleDeliveryAsync();
            if (result is null)
            {
                testResult = (false, "The Kindle delivery test could not be run.");
                return;
            }

            testResult = (result.Succeeded, result.Message);
        }
        catch (HttpRequestException)
        {
            testResult = (false, "The Kindle delivery test could not be run.");
        }
        finally
        {
            testBusy = false;
        }
    }

    private void ApplyTarget(FamilyLibrarian.Contracts.Delivery.DeliveryTargetResponse? target, bool applyFields = true)
    {
        hasTarget = target is not null;
        isEnabled = target?.IsEnabled ?? false;
        if (applyFields)
        {
            sendByDefault = target?.SendByDefault ?? sendByDefault;
            address = target?.Address ?? address;
            draft.Accept("delivery", DeliveryFields);
        }
        version = target?.Version;
    }
}
