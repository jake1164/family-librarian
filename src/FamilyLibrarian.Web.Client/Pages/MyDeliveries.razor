@page "/deliveries"
@page "/deliveries/{AttemptId:guid}"
@attribute [Authorize]
@inherits LiveComponentBase
@using FamilyLibrarian.Contracts.Delivery
@using FamilyLibrarian.Web.Client.Delivery
@inject DeliveryTargetApiClient DeliveryApi

<PageTitle>My Kindle deliveries · Family Librarian</PageTitle>
<MudStack Spacing="3">
    <MudText Typo="Typo.h4">My Kindle deliveries</MudText>
    <MudText>Request deliveries and books sent from the library. Sent means the library accepted the send; only you can confirm arrival.</MudText>
    <MudStack Row="true" Spacing="3">
        <MudLink Href="deliveries">All deliveries</MudLink>
        <MudLink Href="settings/ebook-delivery">Kindle settings</MudLink>
    </MudStack>
    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error">@error</MudAlert>
    }
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" aria-label="Loading Kindle deliveries" />
    }
    else if (attempts.Count == 0 && error is null)
    {
        <MudAlert Severity="Severity.Info">No Kindle deliveries yet.</MudAlert>
    }
    @foreach (var attempt in attempts)
    {
        <MudPaper Outlined="true" Class="pa-4" @key="attempt.Id" data-attempt-id="@attempt.Id">
            <MudStack Spacing="2">
                <MudLink Href="@($"deliveries/{attempt.Id}")">@(attempt.BookTitle ?? "Book from your library")</MudLink>
                <div><KindleStatusChip Status="@attempt.Status" ConfirmationStatus="@attempt.ConfirmationStatus" /></div>
                <MudText Typo="Typo.caption">Attempt @attempt.AttemptNumber · @attempt.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
                @if (attempt.ConfirmedAtUtc is { } answered)
                {
                    <MudText Typo="Typo.caption">Receipt answer updated @answered.ToLocalTime().ToString("g")</MudText>
                }
                @if (attempt.LatestAttemptId != attempt.Id)
                {
                    <MudText>Superseded. <MudLink Href="@($"deliveries/{attempt.LatestAttemptId}")">View latest attempt</MudLink></MudText>
                }
                @if (!string.IsNullOrWhiteSpace(attempt.FailureReason))
                {
                    <MudText>@attempt.FailureReason</MudText>
                }
                @if (attempt.NextAutomaticRetryAtUtc is { } retryAt)
                {
                    <MudText Typo="Typo.caption">Automatic retry eligible after @retryAt.ToLocalTime().ToString("g"); the worker checks every five minutes and rechecks recipient eligibility.</MudText>
                }
                @if (attempt.AutomaticRetriesExhausted)
                {
                    <MudText>Automatic retries exhausted. Check the cause before retrying.</MudText>
                }
                @if (attempt.Id == attempt.LatestAttemptId && attempt.Status == "Submitted" && attempt.ConfirmationStatus == "Unconfirmed")
                {
                    <MudText>Did it arrive on your Kindle?</MudText>
                    <MudStack Row="true">
                        <MudButton Variant="Variant.Outlined" Disabled="@(busyId is not null)" OnClick="@(() => ConfirmAsync(attempt.Id, true))">Received</MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="@(busyId is not null)" OnClick="@(() => ConfirmAsync(attempt.Id, false))">Not received</MudButton>
                    </MudStack>
                }
                @if (attempt.CanRetry)
                {
                    <div><MudButton Variant="Variant.Outlined" Disabled="@(busyId is not null)" OnClick="@(() => RetryAsync(attempt))">
                        @(attempt.Status == "SubmissionUnknown" ? "Resend (may create a duplicate)" : "Retry")
                    </MudButton></div>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public Guid? AttemptId { get; set; }
    private IReadOnlyList<PersonalDeliveryAttemptResponse> attempts = [];
    private bool loading = true;
    private Guid? busyId;
    private string? error;

    protected override void OnInitialized() => Observe(LiveUpdateTopics.Deliveries, LoadAsync);
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await RefreshLiveAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            if (AttemptId is { } id)
            {
                var attempt = await DeliveryApi.GetMyAttemptAsync(id);
                attempts = attempt is null ? [] : [attempt];
                error = attempt is null ? "This delivery could not be found." : null;
            }
            else
            {
                attempts = await DeliveryApi.ListMyAttemptsAsync();
                error = null;
            }
        }
        catch (HttpRequestException) { error = "Your Kindle deliveries could not be loaded. Please try again."; }
        finally { loading = false; }
    }

    private Task ConfirmAsync(Guid id, bool received) => RunAsync(id, () => received
        ? DeliveryApi.ConfirmDeliveryReceivedAsync(id) : DeliveryApi.ReportDeliveryMissingAsync(id));

    private Task RetryAsync(PersonalDeliveryAttemptResponse attempt) => RunAsync(attempt.Id,
        () => DeliveryApi.RetryDeliveryAsync(attempt.Id, attempt.Status == "SubmissionUnknown"));

    private async Task RunAsync(Guid id, Func<Task<bool>> action)
    {
        busyId = id;
        try
        {
            var succeeded = await action();
            await RefreshLiveAsync();
            if (!succeeded) error = "That action could not be completed. The delivery may have changed; check its latest status.";
        }
        catch (HttpRequestException) { error = "That action could not be completed. Please try again."; }
        finally { busyId = null; }
    }
}
