@page "/settings/matrix"
@attribute [Authorize]
@using FamilyLibrarian.Contracts.Accounts
@using FamilyLibrarian.Contracts.Communications
@using FamilyLibrarian.Web.Client.Accounts
@using FamilyLibrarian.Web.Client.Communications
@using FamilyLibrarian.Web.Client.Realtime
@inherits LiveComponentBase
@implements IAsyncDisposable
@inject MatrixLinkApiClient MatrixLinkApi
@inject QuietHoursApiClient QuietHoursApi
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Matrix chat · Family Librarian</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Matrix chat</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Link your Matrix ID to receive Family Librarian notifications as chat messages,
    in addition to email. Once linked, you can reply directly to some notifications
    -- for example, confirming a Kindle delivery arrived with a simple "yes" or "no".
</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading Matrix link settings" />
}
else if (loadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load your Matrix link settings.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Outlined="true">
        @if (status is { IsVerified: true })
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                <MudText Typo="Typo.h6">Linked to @status.MatrixUserId</MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@busy" OnClick="UnlinkAsync">
                Remove link
            </MudButton>
        }
        else
        {
            @if (status is { AwaitingVerification: true })
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    We sent a verification code to @status.MatrixUserId on Matrix. Reply with that
                    code in the chat to finish linking. Requesting a new code below replaces it.
                </MudAlert>
            }

            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="matrixUserId" Label="Your Matrix ID" Disabled="@busy"
                              Placeholder="@("@you:example.org")" />

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                }

                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="RequestLinkAsync">
                        Send verification code
                    </MudButton>
                </div>
            </MudStack>
        }
    </MudPaper>
}

<MudText Typo="Typo.h4" GutterBottom="true" Class="mt-8">Quiet hours</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    During these hours Family Librarian holds verification alerts until the window ends,
    instead of sending them right away. (Other notifications are not affected yet.)
</MudText>

@if (isLoadingQuietHours)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading quiet hours" />
}
else if (quietHoursLoadFailed)
{
    <MudAlert Severity="Severity.Error">We could not load your quiet hours.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Spacing="3">
            <MudSwitch T="bool" Value="quietHoursEnabled" ValueChanged="OnQuietHoursEnabledChangedAsync"
                       Color="Color.Primary" Label="Hold verification alerts during a daily window" />

            @if (quietHoursEnabled)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudTextField T="string" @bind-Value="timeZoneId" Label="Time zone" Disabled="@busy"
                                  Placeholder="@("America/New_York")" Style="min-width:16rem;" />
                    <MudButton Variant="Variant.Text" Disabled="@busy" OnClick="UseBrowserTimeZoneAsync">
                        Use my browser's time zone
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                    <MudTimePicker Label="Start" @bind-Time="startTime" Disabled="@busy" />
                    <MudTimePicker Label="End" @bind-Time="endTime" Disabled="@busy" />
                </MudStack>

                <MudText Typo="Typo.caption">
                    A window that ends before it starts (e.g. 22:00-07:00) crosses midnight.
                </MudText>
            }

            @if (!string.IsNullOrWhiteSpace(quietHoursError))
            {
                <MudAlert Severity="Severity.Error">@quietHoursError</MudAlert>
            }

            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="SaveQuietHoursAsync">
                    Save quiet hours
                </MudButton>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    private bool isLoading = true;
    private bool loadFailed;
    private bool busy;
    private MatrixLinkStatusResponse? status;
    private string matrixUserId = string.Empty;
    private string? errorMessage;

    private bool isLoadingQuietHours = true;
    private bool quietHoursLoadFailed;
    private bool quietHoursEnabled;
    private string timeZoneId = string.Empty;
    private TimeSpan? startTime;
    private TimeSpan? endTime;
    private string? quietHoursError;
    private IJSObjectReference? timezoneInterop;

    protected override void OnInitialized() =>
        Observe(LiveUpdateTopics.Communications, RefreshMatrixStatusAsync);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            status = await MatrixLinkApi.GetAsync();
            matrixUserId = status?.MatrixUserId ?? matrixUserId;
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }

        try
        {
            var quietHours = await QuietHoursApi.GetAsync();
            if (quietHours is { TimeZoneId: not null, StartMinute: { } start, EndMinute: { } end })
            {
                quietHoursEnabled = true;
                timeZoneId = quietHours.TimeZoneId;
                startTime = TimeSpan.FromMinutes(start);
                endTime = TimeSpan.FromMinutes(end);
            }
        }
        catch (HttpRequestException)
        {
            quietHoursLoadFailed = true;
        }
        finally
        {
            isLoadingQuietHours = false;
        }
    }

    private async Task RefreshMatrixStatusAsync()
    {
        var latestStatus = await MatrixLinkApi.GetAsync();
        status = latestStatus;
        matrixUserId = latestStatus?.MatrixUserId ?? string.Empty;
    }

    private async Task OnQuietHoursEnabledChangedAsync(bool enabled)
    {
        quietHoursEnabled = enabled;
        if (enabled && string.IsNullOrWhiteSpace(timeZoneId))
        {
            await UseBrowserTimeZoneAsync();
        }
    }

    private async Task UseBrowserTimeZoneAsync()
    {
        try
        {
            timezoneInterop ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/timezone-interop.js");
            timeZoneId = await timezoneInterop.InvokeAsync<string>("getBrowserTimeZone");
        }
        catch (JSException)
        {
            // The field stays editable either way; this is only a convenience default.
        }
    }

    private async Task SaveQuietHoursAsync()
    {
        busy = true;
        quietHoursError = null;

        try
        {
            QuietHoursResult result;
            if (!quietHoursEnabled)
            {
                result = await QuietHoursApi.SetAsync(null, null, null);
            }
            else if (startTime is { } start && endTime is { } end && !string.IsNullOrWhiteSpace(timeZoneId))
            {
                result = await QuietHoursApi.SetAsync(timeZoneId, (int)start.TotalMinutes, (int)end.TotalMinutes);
            }
            else
            {
                quietHoursError = "Enter a time zone and both a start and end time.";
                return;
            }

            if (result.Succeeded)
            {
                Snackbar.Add("Quiet hours saved.", Severity.Success);
            }
            else
            {
                quietHoursError = result.Error;
            }
        }
        catch (HttpRequestException)
        {
            quietHoursError = "That could not be saved. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RequestLinkAsync()
    {
        busy = true;
        errorMessage = null;

        try
        {
            var result = await MatrixLinkApi.RequestLinkAsync(matrixUserId);
            if (result.Succeeded)
            {
                status = result.Status;
                try
                {
                    await RefreshMatrixStatusAsync();
                }
                catch (HttpRequestException)
                {
                    // Keep the successful request response; a later live update will refresh again.
                }
                Snackbar.Add("Verification code sent on Matrix.", Severity.Success);
            }
            else
            {
                errorMessage = result.Error;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "That could not be saved. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UnlinkAsync()
    {
        busy = true;

        try
        {
            var result = await MatrixLinkApi.UnlinkAsync();
            if (result.Succeeded)
            {
                status = result.Status;
                matrixUserId = string.Empty;
                Snackbar.Add("Matrix link removed.", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "That could not be removed.", Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("That could not be removed. Please try again.", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (timezoneInterop is not null)
        {
            try
            {
                await timezoneInterop.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone -- nothing left to clean up.
            }
        }
    }
}
