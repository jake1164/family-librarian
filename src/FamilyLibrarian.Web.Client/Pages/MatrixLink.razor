@page "/settings/matrix"
@attribute [Authorize]
@using FamilyLibrarian.Contracts.Setup
@using FamilyLibrarian.Web.Client.Setup
@inject SetupApiClient SetupApi

<PageTitle>Message the Librarian · Family Librarian</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Message the Librarian</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading Message the Librarian" />
}
else
{
    <MudText Typo="Typo.body1" Class="mb-6">
        @(guidance?.ChatEnabled == true
            ? "Ask for books and get updates by message, from your phone or computer."
            : "Get a message when your book is ready, and reply to quick questions.")
    </MudText>

    <MudPaper Class="pa-4" Outlined="true">
        <MessagingConnectionPanel Guidance="guidance" />
    </MudPaper>
}

<MudText Typo="Typo.body2" Class="mt-4">
    To stop messages arriving overnight, set your <MudLink Href="settings/quiet-hours">quiet hours</MudLink>.
</MudText>

@code {
    private bool isLoading = true;
    // Null while messaging isn't set up, or if it could not be read: connecting still works without the instructions.
    private MessagingGuidanceResponse? guidance;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            guidance = (await SetupApi.GetAsync())?.Messaging;
        }
        catch (HttpRequestException)
        {
            guidance = null;
        }
        finally
        {
            isLoading = false;
        }
    }
}
