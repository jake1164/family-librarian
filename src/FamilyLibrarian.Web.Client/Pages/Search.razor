@page "/search"
@attribute [Authorize]
@using System.Net
@using System.Text.RegularExpressions
@inject CatalogApiClient Catalog
@inject CatalogSearchState SearchState

<PageTitle>Search · Family Librarian</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h3">Find a book</MudText>
        <MudText Typo="Typo.body1">
            Search enabled catalogs by title, author, or ISBN. Queries may be sent to configured external metadata providers.
        </MudText>
    </div>

    <MudPaper Class="pa-4" Elevation="1">
        <form role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="searchText"
                              Label="Title, author, or ISBN"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Class="flex-grow-1"
                              Disabled="@isSearching" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@isSearching">
                    Search
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }

    @if (unavailableProviders.Count > 0)
    {
        <MudAlert Severity="Severity.Warning">
            Some catalog sources are temporarily unavailable: @(string.Join(", ", unavailableProviders)).
        </MudAlert>
    }

    @if (isSearching)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (hasSearched && results.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No matches found. Try a title with its author, or an ISBN.</MudAlert>
    }
    else if (results.Count > 0)
    {
        <MudText Typo="Typo.h5">Results</MudText>
        <MudStack Spacing="0">
            @foreach (var result in results)
            {
                <MudStack Row="true" Spacing="3" Class="pa-3" @key="ResultKey(result)">
                    @if (!string.IsNullOrWhiteSpace(result.CoverUrl) && !failedCovers.Contains(ResultKey(result)))
                    {
                        <img src="@result.CoverUrl"
                             alt=""
                             loading="lazy"
                             class="search-result-cover"
                             @onerror="() => OnCoverError(result)" />
                    }
                    else
                    {
                        <MudPaper Outlined="true" Class="search-result-cover d-flex align-center justify-center">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Default" />
                        </MudPaper>
                    }
                    <MudStack Spacing="1" Class="flex-grow-1" Style="min-width: 0;">
                        <MudLink Typo="Typo.h6" Class="search-result-title" Href="@DetailsHref(result)">@result.Title</MudLink>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Join(", ", result.Authors)</MudText>
                        @if (result.Series.FirstOrDefault(series => series.IsPrimary) is { } series)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @series.Name@(string.IsNullOrWhiteSpace(series.PositionLabel) ? string.Empty : $" · Book {series.PositionLabel}")
                            </MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(result.Description))
                        {
                            <MudText Typo="Typo.body2" Class="search-result-description">@PlainSnippet(result.Description)</MudText>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @result.ProviderName
                                @(string.IsNullOrWhiteSpace(result.Publisher) ? string.Empty : $" · {result.Publisher}")
                                @(result.PublicationDate is { } publicationDate ? $" · {publicationDate:yyyy}" : string.Empty)
                            </MudText>
                            @if (result.Editions.Count > 1)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Href="@DetailsHref(result)">
                                    @result.Editions.Count more editions
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudStack>
                <MudDivider />
            }
        </MudStack>
    }
</MudStack>

@code {
    private string searchText = string.Empty;
    private IReadOnlyList<CatalogBookCandidateResponse> results = [];
    private bool hasSearched;
    private bool isSearching;
    private string? errorMessage;
    private IReadOnlyList<string> unavailableProviders = [];

    protected override void OnInitialized()
    {
        searchText = SearchState.SearchText;
        results = SearchState.Results;
        unavailableProviders = SearchState.UnavailableProviders;
        hasSearched = SearchState.HasSearched;
    }

    private async Task SearchAsync()
    {
        var query = searchText.Trim();
        if (query.Length < 2)
        {
            errorMessage = "Enter at least two characters to search.";
            return;
        }

        isSearching = true;
        hasSearched = true;
        errorMessage = null;
        unavailableProviders = [];

        try
        {
            var response = await Catalog.SearchAsync(query);
            results = response.Results;
            unavailableProviders = response.Providers
                .Where(provider => !provider.Succeeded)
                .Select(provider => provider.ProviderName)
                .ToArray();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The catalog is unavailable. Please try again.";
            results = [];
            unavailableProviders = [];
        }
        finally
        {
            isSearching = false;
        }

        SearchState.SearchText = searchText;
        SearchState.Results = results;
        SearchState.UnavailableProviders = unavailableProviders;
        SearchState.HasSearched = hasSearched;
    }

    private readonly HashSet<string> failedCovers = [];

    private static string ResultKey(CatalogBookCandidateResponse result) =>
        $"{result.ProviderId}:{result.ExternalId}";

    private static string DetailsHref(CatalogBookCandidateResponse result) =>
        $"search/{Uri.EscapeDataString(result.ProviderId)}/{Uri.EscapeDataString(result.ExternalId)}";

    private void OnCoverError(CatalogBookCandidateResponse result) =>
        failedCovers.Add(ResultKey(result));

    private const int MaxSnippetSentences = 2;
    private const int MaxSnippetLength = 320;

    private static readonly Regex HtmlTagPattern = new("<[^>]+>", RegexOptions.Compiled);
    private static readonly Regex WhitespacePattern = new(@"\s+", RegexOptions.Compiled);
    private static readonly Regex SentencePattern = new(@"[^.!?]+[.!?]+", RegexOptions.Compiled);

    private static string PlainSnippet(string description)
    {
        var decoded = WebUtility.HtmlDecode(description);
        var plainText = WhitespacePattern
            .Replace(HtmlTagPattern.Replace(decoded, " "), " ")
            .Trim();

        var allSentences = SentencePattern.Matches(plainText)
            .Select(match => match.Value.Trim())
            .Where(sentence => sentence.Length > 0)
            .ToArray();
        var sentences = allSentences.Take(MaxSnippetSentences).ToArray();
        var snippet = sentences.Length > 0 ? string.Join(" ", sentences) : plainText;

        if (snippet.Length > MaxSnippetLength)
        {
            return string.Concat(snippet.AsSpan(0, MaxSnippetLength).TrimEnd(), "…");
        }

        return allSentences.Length > sentences.Length ? $"{snippet} …" : snippet;
    }
}
