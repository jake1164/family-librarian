@page "/reading"
@attribute [Authorize]
@inject FeedbackApiClient Feedback

<PageTitle>My reading · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">My reading</MudText>
        <MudText Typo="Typo.body1">
            Books you have finished and how you rated them. Only you can see this list.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Nothing logged yet. Rate a book from its
            <MudLink Href="search">search result</MudLink> once you have finished it.
        </MudAlert>
    }
    else
    {
        @foreach (var item in items)
        {
            <MudCard Outlined="true" Class="mb-3">
                <MudCardContent>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">
                            <MudLink Href="@($"works/{item.WorkId}")">@item.WorkTitle</MudLink>
                        </MudText>
                        <MudText Typo="Typo.body2">@string.Join(", ", item.Authors)</MudText>
                        <MudRating SelectedValue="item.Rating" MaxValue="5" ReadOnly="true" />
                        <MudText Typo="Typo.caption">
                            Finished @item.CompletedOn.ToString("d")
                        </MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<WorkFeedbackResponse> items = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Feedback.GetMineAsync();
            items = response.Items;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Your reading list could not be loaded. Please try again.";
            items = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
