@page "/reading"
@attribute [Authorize]
@inherits LiveComponentBase
@inject FeedbackApiClient Feedback
@inject RequestsApiClient Requests

<PageTitle>My reading · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h3">My reading</MudText>
        <MudText Typo="Typo.body1">
            Every book available to you, and whether you've read it. Only you can see this list.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Nothing available yet. Once a book you asked for is ready, it will show up here.
        </MudAlert>
    }
    else
    {
        @foreach (var row in rows)
        {
            <MudCard Outlined="true" Class="mb-3" @key="row.WorkId">
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">
                            <MudLink Href="@($"works/{row.WorkId}")">@row.WorkTitle</MudLink>
                        </MudText>
                        <MudText Typo="Typo.body2">@string.Join(", ", row.Authors)</MudText>

                        @if (!string.IsNullOrWhiteSpace(row.Error))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@row.Error</MudAlert>
                        }

                        @if (row.IsLogged)
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudDatePicker Date="row.CompletedOnDate"
                                               DateChanged="date => OnDateChangedAsync(row, date)"
                                               Label="Date finished"
                                               Editable="true"
                                               Disabled="@row.IsSaving" />
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           Disabled="@row.IsSaving"
                                           OnClick="() => RemoveRowAsync(row)">
                                    Unmark as read
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@row.IsSaving"
                                       OnClick="() => MarkReadAsync(row)">
                                @(row.IsSaving ? "Saving…" : "Mark read")
                            </MudButton>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    }
</MudStack>

@code {
    private sealed class ReadingRow
    {
        public required Guid WorkId { get; init; }
        public required string WorkTitle { get; init; }
        public required IReadOnlyList<string> Authors { get; init; }
        public uint? Version { get; set; }
        public DateTime? CompletedOnDate { get; set; }
        public bool IsSaving { get; set; }
        public bool IsLogged { get; set; }
        public string? Error { get; set; }
    }

    private readonly List<ReadingRow> rows = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Observe(LiveUpdateTopics.Requests, LoadAsync);
        await RefreshLiveAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var feedbackByWorkId = (await Feedback.GetMineAsync()).Items
                .ToDictionary(item => item.WorkId);

            var requests = await Requests.GetMineAsync();
            var available = requests.Active
                .Concat(requests.History)
                .Where(request => request.Status == "Available")
                .DistinctBy(request => request.WorkId);

            rows.Clear();
            rows.AddRange(available.Select(request =>
                feedbackByWorkId.TryGetValue(request.WorkId, out var feedback)
                    ? new ReadingRow
                    {
                        WorkId = request.WorkId,
                        WorkTitle = request.WorkTitle,
                        Authors = request.Authors,
                        Version = feedback.Version,
                        CompletedOnDate = feedback.CompletedOn.ToDateTime(TimeOnly.MinValue),
                        IsLogged = true
                    }
                    : new ReadingRow
                    {
                        WorkId = request.WorkId,
                        WorkTitle = request.WorkTitle,
                        Authors = request.Authors
                    }));
        }
        catch (HttpRequestException)
        {
            errorMessage = "Your reading list could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task MarkReadAsync(ReadingRow row) => SaveRowAsync(row, DateTime.Today);

    private Task OnDateChangedAsync(ReadingRow row, DateTime? date) =>
        date is null ? Task.CompletedTask : SaveRowAsync(row, date.Value);

    private async Task SaveRowAsync(ReadingRow row, DateTime completedOn)
    {
        row.IsSaving = true;
        row.Error = null;

        try
        {
            var outcome = await Feedback.SetAsync(row.WorkId, DateOnly.FromDateTime(completedOn), row.Version);
            if (outcome.Succeeded && outcome.Feedback is { } feedback)
            {
                row.Version = feedback.Version;
                row.CompletedOnDate = feedback.CompletedOn.ToDateTime(TimeOnly.MinValue);
                row.IsLogged = true;
            }
            else
            {
                row.Error = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            row.Error = "That could not be saved. Please try again.";
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private async Task RemoveRowAsync(ReadingRow row)
    {
        if (row.Version is null)
        {
            return;
        }

        row.IsSaving = true;
        row.Error = null;

        try
        {
            var outcome = await Feedback.RemoveAsync(row.WorkId, row.Version.Value);
            if (outcome.Succeeded)
            {
                row.Version = null;
                row.CompletedOnDate = null;
                row.IsLogged = false;
            }
            else
            {
                row.Error = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            row.Error = "That could not be removed. Please try again.";
        }
        finally
        {
            row.IsSaving = false;
        }
    }
}
