@page "/works/{WorkId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject CatalogApiClient Catalog
@inject RequestsApiClient Requests
@inject FeedbackApiClient Feedback

<PageTitle>@(work?.Title ?? "Book") · Family Librarian</PageTitle>

<MudStack Spacing="3">
    <MudButton Variant="Variant.Text" Href="search">Back to search</MudButton>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (work is null)
    {
        <MudAlert Severity="Severity.Warning">This catalog Work could not be found.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h3">@work.Title</MudText>
        <MudText Typo="Typo.h6">@string.Join(", ", work.Authors)</MudText>

        @if (!string.IsNullOrWhiteSpace(work.Description))
        {
            <div class="mud-typography mud-typography-body1">@CatalogDescriptionMarkup.ToMarkup(work.Description)</div>
        }

        @if (work.Series.Count > 0)
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6">Known series context</MudText>
                @foreach (var series in work.Series)
                {
                    <MudText Typo="Typo.body2">
                        @series.Name@(string.IsNullOrWhiteSpace(series.PositionLabel) ? string.Empty : $" · position {series.PositionLabel}")
                    </MudText>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6">Known editions</MudText>
            @foreach (var edition in work.Editions)
            {
                <MudText Typo="Typo.body2">
                    @edition.Format · @edition.Title@(string.IsNullOrWhiteSpace(edition.Isbn13) ? string.Empty : $" · ISBN {edition.Isbn13}")
                </MudText>
            }
        </MudPaper>

        @if (HasOwnedOption(fulfillment?.Ebook) || HasOwnedOption(fulfillment?.Audiobook))
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Already in your library</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @if (HasOwnedOption(fulfillment?.Ebook))
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                            Ebook — already in CWA
                        </MudChip>
                        @if (OwnedLink(fulfillment?.Ebook) is { } ebookLink)
                        {
                            <MudLink Href="@ebookLink" Target="_blank" rel="noopener noreferrer">Open in CWA</MudLink>
                        }
                    }
                    @if (HasOwnedOption(fulfillment?.Audiobook))
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                            Audiobook — already in Audiobookshelf
                        </MudChip>
                        @if (OwnedLink(fulfillment?.Audiobook) is { } audiobookLink)
                        {
                            <MudLink Href="@audiobookLink" Target="_blank" rel="noopener noreferrer">Open in Audiobookshelf</MudLink>
                        }
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mt-2">
                    Already having a copy doesn't guarantee everyone in the household can get to it —
                    you can still ask for it below.
                </MudText>
            </MudPaper>
        }

        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Ask for this book</MudText>
                <MudText Typo="Typo.body2">
                    When a trusted free source has one clear match, we fetch it automatically,
                    scan and verify it, then publish it to the family library.
                </MudText>

                @if (createdRequest is not null)
                {
                    <MudAlert Severity="@RequestStatusSeverity(createdRequest.Status)">
                        Your request is in. @createdRequest.StatusDescription
                    </MudAlert>
                    @foreach (var format in createdRequest.Formats.Where(format =>
                        !string.IsNullOrWhiteSpace(format.ProgressDescription)))
                    {
                        <MudText Typo="Typo.body2" Color="@ProgressColor(format.ProgressCode)">
                            @format.MediaType: @format.ProgressDescription
                        </MudText>
                    }
                    <MudText Typo="Typo.caption">
                        This update refreshes automatically while you are on this page.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="requests">
                        See my requests
                    </MudButton>
                }
                else
                {
                    <fieldset class="pa-0" style="border: 0;">
                        <legend class="mud-typography mud-typography-body2">Which format would you like?</legend>
                        <MudCheckBox @bind-Value="wantsEbook" Label="Ebook" Disabled="@isSubmitting" />
                        <MudCheckBox @bind-Value="wantsAudiobook" Label="Audiobook" Disabled="@isSubmitting" />
                    </fieldset>

                    <MudTextField @bind-Value="note"
                                  Label="Anything we should know? (optional)"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  MaxLength="1000"
                                  Disabled="@isSubmitting" />

                    @if (duplicate is not null)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @duplicate.Message
                            @if (duplicate.ExistingRequest is not null)
                            {
                                <text>
                                    You asked for
                                    @string.Join(" and ", duplicate.OverlappingFormats).ToLowerInvariant()
                                    on @duplicate.ExistingRequest.RequestedAtUtc.ToLocalTime().ToString("d")
                                    — @duplicate.ExistingRequest.StatusDescription
                                </text>
                            }
                        </MudAlert>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="() => SubmitAsync(false)"
                                   Disabled="@(isSubmitting || !HasFormatSelected)">
                            @(isSubmitting ? "Sending…" : "Request this book")
                        </MudButton>

                        @* Shown only after the host has reported an overlap, so the
                           confirmation is a deliberate second choice. *@
        @if (duplicate is not null)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="() => SubmitAsync(true)"
                                       Disabled="@isSubmitting">
                                Request it anyway
                            </MudButton>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Your reading</MudText>

                @if (isLoadingFeedback)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }
                else
                {
                    <MudDatePicker @bind-Date="completedOnDate"
                                    Label="Date finished"
                                    Editable="true"
                                    Disabled="@isSavingFeedback" />
                    <MudRating @bind-SelectedValue="rating" MaxValue="5" Disabled="@isSavingFeedback" />

                    @if (!string.IsNullOrWhiteSpace(feedbackError))
                    {
                        <MudAlert Severity="Severity.Error">@feedbackError</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SaveFeedbackAsync"
                                   Disabled="@(isSavingFeedback || completedOnDate is null || rating is 0)">
                            @(isSavingFeedback ? "Saving…" : feedback is null ? "Log as finished" : "Update")
                        </MudButton>

                        @if (feedback is not null)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       OnClick="RemoveFeedbackAsync"
                                       Disabled="@isSavingFeedback">
                                Remove
                            </MudButton>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid WorkId { get; set; }

    private CatalogWorkResponse? work;
    private bool isLoading = true;
    private WorkFulfillmentOptionsResponse? fulfillment;

    private bool wantsEbook = true;
    private bool wantsAudiobook;
    private string? note;
    private bool isSubmitting;
    private string? errorMessage;
    private BookRequestDuplicateResponse? duplicate;
    private BookRequestResponse? createdRequest;
    private CancellationTokenSource? requestStatusRefreshCancellation;

    private WorkFeedbackResponse? feedback;
    private bool isLoadingFeedback = true;
    private DateTime? completedOnDate;
    private int rating;
    private bool isSavingFeedback;
    private string? feedbackError;

    private bool HasFormatSelected => wantsEbook || wantsAudiobook;

    protected override async Task OnParametersSetAsync()
    {
        StopRequestStatusRefresh();
        isLoading = true;
        createdRequest = null;
        duplicate = null;
        errorMessage = null;

        try
        {
            work = await Catalog.GetWorkAsync(WorkId);
        }
        catch (HttpRequestException)
        {
            work = null;
        }
        finally
        {
            isLoading = false;
        }

        await LoadFeedbackAsync();
        await LoadFulfillmentOptionsAsync();
    }

    private async Task LoadFulfillmentOptionsAsync()
    {
        try
        {
            fulfillment = await Catalog.GetFulfillmentOptionsAsync(WorkId);
        }
        catch (HttpRequestException)
        {
            // Informational only — a failed lookup just means no "already have
            // this" chip shows, not a page-level error.
            fulfillment = null;
        }
    }

    private static bool HasOwnedOption(IReadOnlyList<FulfillmentOptionResponse>? options) =>
        options?.Any(option => option.OptionKind == "Owned") ?? false;

    private static string? OwnedLink(IReadOnlyList<FulfillmentOptionResponse>? options) =>
        options?.FirstOrDefault(option => option.OptionKind == "Owned")?.ExternalActionUri;

    private static Severity RequestStatusSeverity(string status) => status switch
    {
        "NeedsReview" => Severity.Warning,
        "NotAvailable" => Severity.Error,
        "Available" => Severity.Success,
        _ => Severity.Info
    };

    private static Color ProgressColor(string? progressCode) => progressCode switch
    {
        "SecurityCheckFailed" or "PublishingNeedsAttention" => Color.Error,
        "AwaitingApproval" or "SecurityReviewRequired" or "IdentityReviewRequired" => Color.Warning,
        "Available" => Color.Success,
        _ => Color.Info
    };

    private async Task LoadFeedbackAsync()
    {
        isLoadingFeedback = true;
        feedbackError = null;

        try
        {
            feedback = await Feedback.FindAsync(WorkId);
            completedOnDate = feedback?.CompletedOn.ToDateTime(TimeOnly.MinValue);
            rating = feedback?.Rating ?? 0;
        }
        catch (HttpRequestException)
        {
            feedback = null;
            feedbackError = "Your reading history for this book could not be loaded.";
        }
        finally
        {
            isLoadingFeedback = false;
        }
    }

    private async Task SaveFeedbackAsync()
    {
        if (completedOnDate is null || rating is < 1 or > 5)
        {
            feedbackError = "Choose a date finished and a rating.";
            return;
        }

        isSavingFeedback = true;
        feedbackError = null;

        try
        {
            var outcome = await Feedback.SetAsync(
                WorkId,
                DateOnly.FromDateTime(completedOnDate.Value),
                rating,
                feedback?.Version);

            if (outcome.Succeeded)
            {
                feedback = outcome.Feedback;
            }
            else
            {
                feedbackError = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            feedbackError = "That could not be saved. Please try again.";
        }
        finally
        {
            isSavingFeedback = false;
        }
    }

    private async Task RemoveFeedbackAsync()
    {
        if (feedback is null)
        {
            return;
        }

        isSavingFeedback = true;
        feedbackError = null;

        try
        {
            var outcome = await Feedback.RemoveAsync(WorkId, feedback.Version);
            if (outcome.Succeeded)
            {
                feedback = null;
                completedOnDate = null;
                rating = 0;
            }
            else
            {
                feedbackError = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            feedbackError = "That could not be removed. Please try again.";
        }
        finally
        {
            isSavingFeedback = false;
        }
    }

    private async Task SubmitAsync(bool confirmDuplicate)
    {
        if (!HasFormatSelected)
        {
            errorMessage = "Choose ebook, audiobook, or both.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var formats = new List<string>(2);
            if (wantsEbook)
            {
                formats.Add("Ebook");
            }

            if (wantsAudiobook)
            {
                formats.Add("Audiobook");
            }

            var outcome = await Requests.CreateAsync(WorkId, formats, note, confirmDuplicate);
            switch (outcome.Status)
            {
                case CreateRequestStatus.Created:
                    createdRequest = outcome.Request;
                    duplicate = null;
                    StartRequestStatusRefresh();
                    break;
                case CreateRequestStatus.DuplicateWarning:
                    duplicate = outcome.Existing;
                    break;
                default:
                    errorMessage = outcome.Error;
                    break;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Your request could not be sent. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void StartRequestStatusRefresh()
    {
        StopRequestStatusRefresh();
        requestStatusRefreshCancellation = new CancellationTokenSource();
        _ = RefreshRequestStatusPeriodicallyAsync(requestStatusRefreshCancellation.Token);
    }

    private async Task RefreshRequestStatusPeriodicallyAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    var currentRequest = createdRequest;
                    if (currentRequest is null)
                    {
                        return;
                    }

                    var requests = await Requests.GetMineAsync(cancellationToken);
                    createdRequest = requests.Active
                        .Concat(requests.History)
                        .FirstOrDefault(request => request.Id == currentRequest.Id);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Navigation away or a new request cycle stops this lightweight poll.
        }
        catch (HttpRequestException)
        {
            // The original request status remains visible; My Requests still offers
            // an explicit, retryable view if a transient refresh fails.
        }
    }

    private void StopRequestStatusRefresh()
    {
        requestStatusRefreshCancellation?.Cancel();
        requestStatusRefreshCancellation?.Dispose();
        requestStatusRefreshCancellation = null;
    }

    public void Dispose() => StopRequestStatusRefresh();
}
