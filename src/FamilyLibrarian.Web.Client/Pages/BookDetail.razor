@page "/search/{ProviderId}/{ExternalId}"
@attribute [Authorize]
@inject CatalogApiClient Catalog
@inject NavigationManager Navigation

<PageTitle>@(book?.Title ?? "Book") · Family Librarian</PageTitle>

<MudStack Spacing="3">
    <MudButton Variant="Variant.Text" Href="search">Back to search</MudButton>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (book is null)
    {
        <MudAlert Severity="Severity.Warning">This catalog entry is no longer available.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h3">@book.Title</MudText>
        <MudText Typo="Typo.h6">@string.Join(", ", book.Authors)</MudText>

        @if (!string.IsNullOrWhiteSpace(book.Description))
        {
            <MudText Typo="Typo.body1">@book.Description</MudText>
        }

        @if (book.Series.Count > 0)
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6">Known series context</MudText>
                @foreach (var series in book.Series)
                {
                    <MudText Typo="Typo.body2">
                        @series.Name@(string.IsNullOrWhiteSpace(series.PositionLabel) ? string.Empty : $" · position {series.PositionLabel}")
                    </MudText>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6">Known editions</MudText>
            @foreach (var edition in book.Editions)
            {
                <MudText Typo="Typo.body2">
                    @edition.Format · @edition.Title@(string.IsNullOrWhiteSpace(edition.Isbn13) ? string.Empty : $" · ISBN {edition.Isbn13}")
                </MudText>
            }
        </MudPaper>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="ResolveAsync"
                   Disabled="@isResolving">
            @(isResolving ? "Saving…" : "Use this book")
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(resolveError))
        {
            <MudAlert Severity="Severity.Error">@resolveError</MudAlert>
        }

        <MudText Typo="Typo.body2">
            Choosing this book saves it to the family catalog, where you can request it.
        </MudText>
    }
</MudStack>

@code {
    [Parameter]
    public string ProviderId { get; set; } = string.Empty;

    [Parameter]
    public string ExternalId { get; set; } = string.Empty;

    private CatalogBookCandidateResponse? book;
    private bool isLoading = true;
    private bool isResolving;
    private string? resolveError;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            book = await Catalog.GetCandidateAsync(ProviderId, ExternalId);
        }
        catch (HttpRequestException)
        {
            book = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResolveAsync()
    {
        isResolving = true;
        resolveError = null;
        try
        {
            var work = await Catalog.ResolveCandidateAsync(ProviderId, ExternalId);
            Navigation.NavigateTo($"works/{work.Id}");
        }
        catch (HttpRequestException)
        {
            resolveError = "This book could not be saved to the catalog. Please try again.";
        }
        finally
        {
            isResolving = false;
        }
    }
}
