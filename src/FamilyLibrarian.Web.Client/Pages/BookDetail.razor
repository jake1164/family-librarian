@page "/search/{ProviderId}/{ExternalId}"
@attribute [Authorize]
@inject CatalogApiClient Catalog
@inject CatalogSearchState SearchState
@inject RequestsApiClient Requests

<PageTitle>@(book?.Title ?? "Book") · Family Librarian</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true">
        <MudButton Variant="Variant.Text" Href="search" StartIcon="@Icons.Material.Filled.ArrowBack">
            Back to search
        </MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (book is null)
    {
        <MudAlert Severity="Severity.Warning">This catalog entry is no longer available.</MudAlert>
    }
    else
    {
        @if (isRefreshing)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        }

        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                @if (!string.IsNullOrWhiteSpace(book.CoverUrl) && !coverFailed)
                {
                    <img src="@book.CoverUrl"
                         alt=""
                         width="160"
                         height="240"
                         class="book-detail-cover"
                         style="width: 160px; height: 240px; object-fit: cover; border-radius: 4px; flex: 0 0 auto;"
                         @onerror="() => coverFailed = true" />
                }
                else
                {
                    <MudPaper Outlined="true" Class="book-detail-cover d-flex align-center justify-center">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Default" />
                    </MudPaper>
                }
                <MudStack Spacing="2" Class="flex-grow-1" Style="min-width: 0;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.overline">Catalog record</MudText>
                        <ProviderChip ProviderName="@book.ProviderName" SourceUrl="@book.SourceUrl" />
                    </MudStack>

                    <div>
                        <MudText Typo="Typo.h3">@book.Title</MudText>
                        <MudText Typo="Typo.h6">@string.Join(", ", book.Authors)</MudText>
                    </div>

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @if (book.PublicationDate is { } publicationDate)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                First reported: @publicationDate.ToString("MMMM d, yyyy")
                            </MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.Publisher))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @book.Publisher
                            </MudChip>
                        }
                        @if (book.PageCount is { } pageCount)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @pageCount pages
                            </MudChip>
                        }
                        @if (book.Editions.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @EditionCountLabel(book.Editions.Count)
                            </MudChip>
                        }
                    </MudStack>
                    @if (book.Subjects.Count > 0)
                    {
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var subject in book.Subjects)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">
                                    @subject
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(book.Description))
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">About this record</MudText>
                <div class="mud-typography mud-typography-body1">@CatalogDescriptionMarkup.ToMarkup(book.Description)</div>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                This source did not provide a description for this record. The edition details below
                can still help you decide whether it is the one you want.
            </MudAlert>
        }

        @if (book.Series.Count > 0)
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6">Known series context</MudText>
                @foreach (var series in book.Series)
                {
                    <MudText Typo="Typo.body2">
                        @series.Name@(string.IsNullOrWhiteSpace(series.PositionLabel) ? string.Empty : $" · position {series.PositionLabel}")
                    </MudText>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-1">Known editions</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                These are the edition details reported by @book.ProviderName for this catalog record.
            </MudText>

            @if (book.Editions.Count == 0)
            {
                <MudText Typo="Typo.body2">No edition details were reported.</MudText>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var edition in book.Editions)
                    {
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle1">@edition.Title</MudText>
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @FormatLabel(edition.Format)
                                    </MudChip>
                                    @if (edition.PublicationDate is { } editionDate)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            Published: @editionDate.ToString("yyyy")
                                        </MudChip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(edition.Isbn13))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            ISBN: @edition.Isbn13
                                        </MudChip>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Similar titles are kept separate unless catalog sources report the same ISBN. Contributor
            names, subtitles, formats, and dates can indicate a different edition, adaptation,
            retelling, translation, or a separate catalog record.
        </MudAlert>

        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Ask for this book</MudText>
                <MudText Typo="Typo.body2">
                    This saves the record to the family catalog and asks for it in one step. When a
                    trusted free source has one clear match, we fetch it automatically, scan and
                    verify it, then publish it to the family library.
                </MudText>

                @if (createdRequest is not null)
                {
                    <MudAlert Severity="@RequestStatusSeverity(createdRequest.Status)">
                        Your request is in. @createdRequest.StatusDescription
                    </MudAlert>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="requests">
                            See my requests
                        </MudButton>
                        @if (resolvedWork is { } work)
                        {
                            <MudButton Variant="Variant.Outlined" Href="@($"works/{work.Id}")">
                                View catalog page
                            </MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    <fieldset class="pa-0" style="border: 0;">
                        <legend class="mud-typography mud-typography-body2">Which format would you like?</legend>
                        <MudCheckBox @bind-Value="wantsEbook" Label="Ebook" Disabled="@isSubmitting" />
                        <MudCheckBox @bind-Value="wantsAudiobook" Label="Audiobook" Disabled="@isSubmitting" />
                    </fieldset>

                    <MudTextField @bind-Value="note"
                                  Label="Anything we should know? (optional)"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  MaxLength="1000"
                                  Disabled="@isSubmitting" />

                    @if (duplicate is not null)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @duplicate.Message
                            @if (duplicate.ExistingRequest is not null)
                            {
                                <text>
                                    You asked for
                                    @string.Join(" and ", duplicate.OverlappingFormats).ToLowerInvariant()
                                    on @duplicate.ExistingRequest.RequestedAtUtc.ToLocalTime().ToString("d")
                                    — @duplicate.ExistingRequest.StatusDescription
                                </text>
                            }
                        </MudAlert>
                    }

                    @if (owned is not null)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @owned.Message
                            @foreach (var format in owned.OwnedFormats)
                            {
                                <MudText Typo="Typo.body2">
                                    @format.MediaType is already in your library.
                                    @if (!string.IsNullOrEmpty(format.ExternalActionUri))
                                    {
                                        <MudLink Href="@format.ExternalActionUri" Target="_blank" rel="noopener noreferrer">Open it</MudLink>
                                    }
                                </MudText>
                            }
                        </MudAlert>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SubmitAsync"
                                   Disabled="@(isSubmitting || !HasFormatSelected)">
                            @(isSubmitting ? "Sending…" : "Request this book")
                        </MudButton>

                        @* Shown only after the host has reported an overlap, so the
                           confirmation is a deliberate second choice. *@
                        @if (duplicate is not null)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="ConfirmDuplicateAsync"
                                       Disabled="@isSubmitting">
                                Request it anyway
                            </MudButton>
                        }

                        @* Shown only after the host has reported an already-owned
                           format, so the confirmation is a deliberate second choice. *@
                        @if (owned is not null)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="ConfirmOwnedAsync"
                                       Disabled="@isSubmitting">
                                Request it anyway
                            </MudButton>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public string ProviderId { get; set; } = string.Empty;

    [Parameter]
    public string ExternalId { get; set; } = string.Empty;

    private CatalogBookCandidateResponse? book;
    private bool isLoading = true;
    private bool isRefreshing;
    private bool coverFailed;

    private bool wantsEbook = true;
    private bool wantsAudiobook;
    private string? note;
    private bool isSubmitting;
    private string? errorMessage;
    private bool confirmDuplicate;
    private bool confirmOwned;
    private BookRequestDuplicateResponse? duplicate;
    private BookRequestOwnedResponse? owned;
    private BookRequestResponse? createdRequest;
    private CatalogWorkResponse? resolvedWork;

    private bool HasFormatSelected => wantsEbook || wantsAudiobook;

    protected override async Task OnParametersSetAsync()
    {
        coverFailed = false;
        wantsEbook = true;
        wantsAudiobook = false;
        note = null;
        errorMessage = null;
        confirmDuplicate = false;
        confirmOwned = false;
        duplicate = null;
        owned = null;
        createdRequest = null;
        resolvedWork = null;

        // Search already fetched this candidate a moment ago: show it immediately
        // instead of leaving the page blank while we re-fetch full details.
        var cached = FindCachedCandidate();
        if (cached is not null)
        {
            book = cached;
            isLoading = false;
            isRefreshing = true;
        }
        else
        {
            book = null;
            isLoading = true;
            isRefreshing = false;
        }

        try
        {
            var fresh = await Catalog.GetCandidateAsync(ProviderId, ExternalId);
            book = fresh;
        }
        catch (HttpRequestException)
        {
            // A transient failure keeps showing the cached summary rather than
            // blanking a page the user already saw content on.
            if (cached is null)
            {
                book = null;
            }
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
        }
    }

    private CatalogBookCandidateResponse? FindCachedCandidate() =>
        SearchState.Results.FirstOrDefault(result =>
            string.Equals(result.ProviderId, ProviderId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(result.ExternalId, ExternalId, StringComparison.OrdinalIgnoreCase));

    private async Task SubmitAsync()
    {
        if (!HasFormatSelected)
        {
            errorMessage = "Choose ebook, audiobook, or both.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            resolvedWork ??= await Catalog.ResolveCandidateAsync(ProviderId, ExternalId);

            var formats = new List<string>(2);
            if (wantsEbook)
            {
                formats.Add("Ebook");
            }

            if (wantsAudiobook)
            {
                formats.Add("Audiobook");
            }

            var outcome = await Requests.CreateAsync(resolvedWork.Id, formats, note, confirmDuplicate, confirmOwned);
            switch (outcome.Status)
            {
                case CreateRequestStatus.Created:
                    createdRequest = outcome.Request;
                    duplicate = null;
                    owned = null;
                    break;
                case CreateRequestStatus.DuplicateWarning:
                    duplicate = outcome.Existing;
                    owned = null;
                    break;
                case CreateRequestStatus.OwnedWarning:
                    owned = outcome.Owned;
                    duplicate = null;
                    break;
                default:
                    errorMessage = outcome.Error;
                    break;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "This book could not be saved or requested. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task ConfirmDuplicateAsync()
    {
        confirmDuplicate = true;
        return SubmitAsync();
    }

    private Task ConfirmOwnedAsync()
    {
        confirmOwned = true;
        return SubmitAsync();
    }

    private static Severity RequestStatusSeverity(string status) => status switch
    {
        "NeedsReview" => Severity.Warning,
        "NotAvailable" => Severity.Error,
        "Available" => Severity.Success,
        _ => Severity.Info
    };

    private static string EditionCountLabel(int count) =>
        count == 1 ? "1 known edition" : $"{count} known editions";

    private static string FormatLabel(string format) =>
        string.IsNullOrWhiteSpace(format) ? "Format not reported" : format;
}
