@inherits LayoutComponentBase
@implements IDisposable
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject AdminRequestsApiClient AdminRequests
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using FamilyLibrarian.Web.Client.Theme

<MudThemeProvider @bind-IsDarkMode="isDarkMode"
                   ObserveSystemDarkModeChange="@(themeMode == ThemeMode.System)"
                   Theme="AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout id="family-librarian-page-top">
    <MudAppBar Elevation="1">
        @* Only signed-in users have anywhere to navigate to. Always visible
           (not just d-md-none/mobile) since the drawer is now a persistent
           mini rail that this button expands/collapses at any width. *@
        <AuthorizeView>
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Open navigation"
                           OnClick="@(() => isDrawerOpen = !isDrawerOpen)" />
        </AuthorizeView>

        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudText Typo="Typo.h6">Family Librarian</MudText>
        </MudLink>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <NotificationTray IsAdmin="@isAdmin" />
            </Authorized>
        </AuthorizeView>

        @* Config/setup pages an admin visits rarely stay tucked in this
           dropdown rather than taking up rows in the nav rail; the
           everyday admin destinations (Tasks/Queue/Security queue/Accounts/
           Publishing activity) live in the drawer instead. Hiding this is
           UX only — every page carries [Authorize] and every endpoint
           behind it independently authorizes the caller. *@
        <AuthorizeView Roles="Admin">
            <MudMenu Icon="@Icons.Material.Filled.Settings"
                     Color="Color.Inherit"
                     AriaLabel="Settings menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Href="settings/metadata-providers" Icon="@Icons.Material.Filled.AutoStories">Metadata providers</MudMenuItem>
                <MudMenuItem Href="settings/sources" Icon="@Icons.Material.Filled.Source">
                    Sources@(ProviderIssueCount == 0 ? string.Empty : $" · {ProviderIssueCount} issue{(ProviderIssueCount == 1 ? string.Empty : "s")}")
                </MudMenuItem>
                <MudMenuItem Href="settings/publishing" Icon="@Icons.Material.Filled.CloudUpload">Publishing</MudMenuItem>
                <MudMenuItem Href="settings/communications" Icon="@Icons.Material.Filled.Email">Communications</MudMenuItem>
                <MudMenuItem Href="settings/acquisition-policy" Icon="@Icons.Material.Filled.Rule">Acquisition policy</MudMenuItem>
                <MudMenuItem Href="settings/authentication" Icon="@Icons.Material.Filled.VerifiedUser">Authentication</MudMenuItem>
                <MudMenuItem Href="settings/backup" Icon="@Icons.Material.Filled.Backup">Settings backup</MudMenuItem>
            </MudMenu>
        </AuthorizeView>

        <MudMenu Icon="@ThemeMenuIcon"
                  Color="Color.Inherit"
                  AriaLabel="Theme"
                  AnchorOrigin="Origin.BottomRight"
                  TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="@(() => SetThemeModeAsync(ThemeMode.Light))">
                <div class="d-flex align-center" style="gap: 0.5rem; min-width: 8rem;">
                    <MudIcon Icon="@Icons.Material.Filled.LightMode" Size="Size.Small" />
                    <MudText>Light</MudText>
                    @if (themeMode == ThemeMode.Light)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-auto" />
                    }
                </div>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => SetThemeModeAsync(ThemeMode.Dark))">
                <div class="d-flex align-center" style="gap: 0.5rem; min-width: 8rem;">
                    <MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small" />
                    <MudText>Dark</MudText>
                    @if (themeMode == ThemeMode.Dark)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-auto" />
                    }
                </div>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => SetThemeModeAsync(ThemeMode.System))">
                <div class="d-flex align-center" style="gap: 0.5rem; min-width: 8rem;">
                    <MudIcon Icon="@Icons.Material.Filled.BrightnessAuto" Size="Size.Small" />
                    <MudText>Auto</MudText>
                    @if (themeMode == ThemeMode.System)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-auto" />
                    }
                </div>
            </MudMenuItem>
        </MudMenu>

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AriaLabel="Account menu"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">
                        Signed in as <strong>@context.User.Identity?.Name</strong>
                    </MudText>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">
                        Sign out
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* Mini variant: a persistent icon-only rail at all screen widths that the
       app bar's hamburger expands to show labels alongside the icons (and
       collapses back to icons-only) — the M3Undle-style rail this is modeled
       on, rather than a responsive drawer that hides below md. *@
    <AuthorizeView>
        <MudDrawer @bind-Open="isDrawerOpen"
                   Variant="DrawerVariant.Mini"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2">
            <MudNavMenu>
                <MudNavLink Href="search" Icon="@Icons.Material.Filled.Search">Search</MudNavLink>
                <MudNavLink Href="requests" Icon="@Icons.Material.Filled.MenuBook">My requests</MudNavLink>
                <MudNavLink Href="reading" Icon="@Icons.Material.Filled.Star">My reading</MudNavLink>
                @* Everyday admin destinations. The config/setup pages that
                   are visited rarely (Metadata providers, Sources,
                   Publishing, Acquisition policy, Authentication) stay in
                   the Settings dropdown up in the app bar instead of taking
                   rows here. Hiding this is UX only — every page carries
                   [Authorize] and every endpoint behind it independently
                   authorizes the caller. *@
                <AuthorizeView Roles="Admin" Context="adminContext">
                    <MudDivider Class="my-2" />
                    <MudNavLink Href="admin/tasks" Icon="@Icons.Material.Filled.TaskAlt">Tasks</MudNavLink>
                    <MudNavLink Href="admin/requests" Icon="@Icons.Material.Filled.Inbox">Queue</MudNavLink>
                    <MudNavLink Href="admin/security" Icon="@Icons.Material.Filled.Shield">Security queue</MudNavLink>
                    <MudNavLink Href="admin/accounts" Icon="@Icons.Material.Filled.People">Accounts</MudNavLink>
                    <MudNavLink Href="admin/publishing" Icon="@Icons.Material.Filled.Assessment">Publishing activity</MudNavLink>
                </AuthorizeView>
            </MudNavMenu>
        </MudDrawer>
    </AuthorizeView>

    @* No `pa-` class here. MudBlazor's own .mud-main-content sets
       padding-top: var(--mud-appbar-height) to clear the fixed app bar, and the
       spacing utilities are declared !important — so pa-6 would win and slide
       the page under the bar. The custom class reserves room for the fixed
       status footer; the container handles the sides and the top gap. *@
    <MudMainContent Class="family-librarian-main-content">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudFab Href="#family-librarian-page-top"
            StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
            Color="Color.Primary"
            Size="Size.Medium"
            Class="family-librarian-go-to-top"
            aria-label="Go to top"
            title="Go to top" />

    @* Sticky status footer, ABS/M3Undle-style. Nothing to surface here yet —
       it's just the shell (app name + version) so future status indicators
       (queue depth, scan health, etc.) have somewhere to land without another
       layout pass. *@
    <MudAppBar Bottom="true" Dense="true" Elevation="1" Class="family-librarian-status-footer">
        <MudText Typo="Typo.caption">Family Librarian</MudText>
        <MudSpacer />
    </MudAppBar>
</MudLayout>

@code {
    private const string ThemeModeStorageKey = "familylibrarian.thememode";

    private enum ThemeMode
    {
        Light,
        Dark,
        System,
    }

    // False by default: DrawerVariant.Mini renders as a persistent icon-only
    // rail when closed and expands to show labels alongside the icons when
    // open, toggled by the app bar's hamburger button.
    private bool isDrawerOpen;
    private bool isAdmin;
    private bool isDarkMode;
    private ThemeMode themeMode = ThemeMode.System;
    private AdminRequestAttentionResponse? adminAttention;
    private CancellationTokenSource? attentionRefreshCancellation;

    private int ProviderIssueCount => adminAttention?.ProviderIssues.Count ?? 0;

    private string ThemeMenuIcon => themeMode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    protected override async Task OnInitializedAsync()
    {
        // ObserveSystemDarkModeChange on the MudThemeProvider below owns
        // isDarkMode whenever themeMode is System — it queries the OS
        // preference itself and keeps isDarkMode current via @bind-IsDarkMode
        // as long as the OS preference changes while the app is open. An
        // explicit Light/Dark choice sets isDarkMode directly instead and
        // turns that observation off.
        var savedMode = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeModeStorageKey);
        themeMode = savedMode switch
        {
            "light" => ThemeMode.Light,
            "dark" => ThemeMode.Dark,
            _ => ThemeMode.System,
        };
        if (themeMode != ThemeMode.System)
        {
            isDarkMode = themeMode == ThemeMode.Dark;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = state.User.IsInRole("Admin");
        if (!isAdmin)
        {
            return;
        }

        await RefreshAdminAttentionAsync(CancellationToken.None);
        attentionRefreshCancellation = new CancellationTokenSource();
        _ = RefreshAdminAttentionPeriodicallyAsync(attentionRefreshCancellation.Token);
    }

    private async Task SetThemeModeAsync(ThemeMode mode)
    {
        themeMode = mode;
        if (mode != ThemeMode.System)
        {
            isDarkMode = mode == ThemeMode.Dark;
        }

        var storedValue = mode switch
        {
            ThemeMode.Light => "light",
            ThemeMode.Dark => "dark",
            _ => "system",
        };
        await JS.InvokeVoidAsync("localStorage.setItem", ThemeModeStorageKey, storedValue);
    }

    private async Task RefreshAdminAttentionAsync(CancellationToken cancellationToken)
    {
        try
        {
            adminAttention = await AdminRequests.GetAttentionAsync(cancellationToken);
        }
        catch (HttpRequestException)
        {
            // Attention indicators are helpful, but a transient summary failure
            // must not hide the rest of the authenticated application.
        }
    }

    private async Task RefreshAdminAttentionPeriodicallyAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAdminAttentionAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Application disposal or sign-out stopped the refresh loop.
        }
    }

    private async Task SignOutAsync()
    {
        attentionRefreshCancellation?.Cancel();
        await AuthenticationStateProvider.SignOutAsync();
        // forceLoad so nothing cached in the WebAssembly app outlives the session.
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        attentionRefreshCancellation?.Cancel();
        attentionRefreshCancellation?.Dispose();
    }
}
