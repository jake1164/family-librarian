@inherits LayoutComponentBase
@implements IDisposable
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject AdminRequestsApiClient AdminRequests
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @* Only signed-in users have anywhere to navigate to. *@
        <AuthorizeView>
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           Class="d-md-none"
                           aria-label="Open navigation"
                           OnClick="@(() => isDrawerOpen = !isDrawerOpen)" />
        </AuthorizeView>

        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudText Typo="Typo.h6">Family Librarian</MudText>
        </MudLink>

        <MudSpacer />

        @* Config/setup pages an admin visits rarely — everyday destinations
           (Search/My Requests/My Reading/Queue/Security Queue) live in the
           sidebar drawer instead. Hiding this is UX only — every page carries
           [Authorize] and every endpoint behind it independently authorizes
           the caller. *@
        <AuthorizeView Roles="Admin">
            <MudMenu Icon="@Icons.Material.Filled.Settings"
                     Color="Color.Inherit"
                     AriaLabel="Settings menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Href="settings/metadata-providers" Icon="@Icons.Material.Filled.AutoStories">Metadata providers</MudMenuItem>
                <MudMenuItem Href="settings/sources" Icon="@Icons.Material.Filled.Source">
                    Sources@(ProviderIssueCount == 0 ? string.Empty : $" · {ProviderIssueCount} issue{(ProviderIssueCount == 1 ? string.Empty : "s")}")
                </MudMenuItem>
                <MudMenuItem Href="settings/publishing" Icon="@Icons.Material.Filled.CloudUpload">Publishing</MudMenuItem>
                <MudMenuItem Href="settings/acquisition-policy" Icon="@Icons.Material.Filled.Rule">Acquisition policy</MudMenuItem>
                <MudMenuItem Href="settings/authentication" Icon="@Icons.Material.Filled.VerifiedUser">Authentication</MudMenuItem>
            </MudMenu>
            <MudMenu Icon="@Icons.Material.Filled.People"
                     Color="Color.Inherit"
                     AriaLabel="Administration menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.BottomRight">
                <MudMenuItem Href="admin/accounts" Icon="@Icons.Material.Filled.People">Accounts</MudMenuItem>
                <MudMenuItem Href="admin/publishing" Icon="@Icons.Material.Filled.Assessment">Publishing activity</MudMenuItem>
            </MudMenu>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AriaLabel="Account menu"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">
                        Signed in as <strong>@context.User.Identity?.Name</strong>
                    </MudText>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">
                        Sign out
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* Responsive: an overlay drawer below md (toggled by the hamburger above),
       a permanently visible sidebar from md up — the ABS-style persistent nav
       this whole layout is modeled on. *@
    <AuthorizeView>
        <MudDrawer @bind-Open="isDrawerOpen"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   Elevation="2">
            <MudNavMenu>
                <MudNavLink Href="search" Icon="@Icons.Material.Filled.Search">Search</MudNavLink>
                <MudNavLink Href="requests" Icon="@Icons.Material.Filled.MenuBook">My requests</MudNavLink>
                <MudNavLink Href="reading" Icon="@Icons.Material.Filled.Star">My reading</MudNavLink>
                <AuthorizeView Roles="Admin" Context="adminContext">
                    <MudDivider Class="my-2" />
                    <MudNavLink Href="admin/requests" Icon="@Icons.Material.Filled.Inbox">
                        Queue@(NeedsReviewCount == 0 ? string.Empty : $" · {NeedsReviewCount} need review")
                    </MudNavLink>
                    <MudNavLink Href="admin/security" Icon="@Icons.Material.Filled.Shield">Security queue</MudNavLink>
                </AuthorizeView>
            </MudNavMenu>
        </MudDrawer>
    </AuthorizeView>

    @* No `pa-` class here. MudBlazor's own .mud-main-content sets
       padding-top: var(--mud-appbar-height) to clear the fixed app bar, and the
       spacing utilities are declared !important — so pa-6 would win and slide
       the page under the bar. Bottom padding only; the container handles the
       sides and the top gap. *@
    <MudMainContent Class="pb-8">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
            <AuthorizeView Roles="Admin">
                @if (adminAttention is { } attention && (attention.NeedsReviewCount > 0 || attention.ProviderIssues.Count > 0))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2">
                                Admin attention:
                                @if (attention.NeedsReviewCount > 0)
                                {
                                    <span>@attention.NeedsReviewCount request@(attention.NeedsReviewCount == 1 ? string.Empty : "s") need review.</span>
                                }
                                @if (attention.ProviderIssues.Count > 0)
                                {
                                    <span>@attention.ProviderIssues.Count automatic source issue@(attention.ProviderIssues.Count == 1 ? string.Empty : "s") need attention.</span>
                                }
                            </MudText>
                            @if (attention.NeedsReviewCount > 0)
                            {
                                <MudLink Href="admin/requests">Open queue</MudLink>
                            }
                            @if (attention.ProviderIssues.Count > 0)
                            {
                                <MudLink Href="settings/sources">Review sources</MudLink>
                            }
                        </MudStack>
                    </MudAlert>
                }
            </AuthorizeView>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // True by default: DrawerVariant.Responsive renders as a permanently
    // visible sidebar from md up (matching the standard MudBlazor template),
    // and as a dismissible overlay below it, toggled by the app bar's
    // hamburger button.
    private bool isDrawerOpen = true;
    private AdminRequestAttentionResponse? adminAttention;
    private CancellationTokenSource? attentionRefreshCancellation;

    private int NeedsReviewCount => adminAttention?.NeedsReviewCount ?? 0;

    private int ProviderIssueCount => adminAttention?.ProviderIssues.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Admin"))
        {
            return;
        }

        await RefreshAdminAttentionAsync(CancellationToken.None);
        attentionRefreshCancellation = new CancellationTokenSource();
        _ = RefreshAdminAttentionPeriodicallyAsync(attentionRefreshCancellation.Token);
    }

    private async Task RefreshAdminAttentionAsync(CancellationToken cancellationToken)
    {
        try
        {
            adminAttention = await AdminRequests.GetAttentionAsync(cancellationToken);
        }
        catch (HttpRequestException)
        {
            // Attention indicators are helpful, but a transient summary failure
            // must not hide the rest of the authenticated application.
        }
    }

    private async Task RefreshAdminAttentionPeriodicallyAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAdminAttentionAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Application disposal or sign-out stopped the refresh loop.
        }
    }

    private async Task SignOutAsync()
    {
        attentionRefreshCancellation?.Cancel();
        await AuthenticationStateProvider.SignOutAsync();
        // forceLoad so nothing cached in the WebAssembly app outlives the session.
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        attentionRefreshCancellation?.Cancel();
        attentionRefreshCancellation?.Dispose();
    }
}
