@using FamilyLibrarian.Contracts.Catalog
@using FamilyLibrarian.Web.Client.Theme

@if (Availability is null && LegacyAvailability is null)
{
    <MudSkeleton Width="90px" Height="24px" SkeletonType="SkeletonType.Rectangle" Style="border-radius: 16px;" />
}
else if (Badges.Count > 0)
{
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        @foreach (var badge in Badges)
        {
            <MudTooltip Text="@MediaTypeVisuals.OptionKindLabel(badge.OptionKind)">
                <MudChip T="string" Size="Size.Small" Color="@MediaTypeVisuals.OptionKindColor(badge.OptionKind)"
                         Icon="@MediaTypeVisuals.Icon(badge.MediaType)">
                    @MediaTypeVisuals.OptionKindLabel(badge.OptionKind)
                </MudChip>
            </MudTooltip>
        }
    </MudStack>
}

@code {
    /// <summary>Null means the check hasn't resolved yet -- renders a loading skeleton.</summary>
    [Parameter]
    public CandidateAvailabilityRunResponse? Availability { get; set; }

    [Parameter]
    public CandidateAvailabilityResponse? LegacyAvailability { get; set; }

    /// <summary>
    /// One badge per distinct (kind, media type) combination, not one per raw
    /// FulfillmentOption -- a public-domain title like "Moby Dick" can match
    /// several Gutenberg editions, each independently confirming the same
    /// "free ebook" fact, and rendering one identical-looking chip per match
    /// is clutter, not information. The requester sees the availability fact,
    /// not the provider topology; provider-specific evidence remains in the
    /// administrator workflow.
    /// </summary>
    private List<BadgeGroup> Badges =>
        Availability is not null
            ? Availability.Availability
                .Select(fact => new BadgeGroup(fact.OptionKind, fact.MediaType))
                .ToList()
            : LegacyAvailability is null
                ? []
                : LegacyAvailability.Ebook.Select(option => new BadgeGroup(option.OptionKind, "Ebook"))
                    .Concat(LegacyAvailability.Audiobook.Select(option => new BadgeGroup(option.OptionKind, "Audiobook")))
                    .Distinct()
                    .ToList();

    private sealed record BadgeGroup(string OptionKind, string MediaType);
}
