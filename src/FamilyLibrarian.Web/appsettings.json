{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "EnableLocal": true
  },
  "MetadataProviders": {
    "Demo": {
      "Enabled": true
    },
    "OpenLibrary": {
      "Enabled": false,
      "MaxResults": 25,
      "TimeoutSeconds": 15,
      "RequestsPerSecond": 1
    },
    "GoogleBooks": {
      "Enabled": false,
      "MaxResults": 10,
      "TimeoutSeconds": 15
    }
  },
  "ExternalProviderOutput": {
    "Ebook": {
      "MaxOutputCount": 16,
      "MaxFileBytes": 268435456,
      "MaxJobBytes": 536870912
    },
    "Audiobook": {
      "MaxOutputCount": 256,
      "MaxFileBytes": 2092957696,
      "MaxJobBytes": 8589934592
    },
    "MaxFilenameLength": 1024,
    "ReadInactivityTimeoutSeconds": 120,
    "MinFreeDiskBytes": 1073741824
  },
  "AllowedHosts": "*"
}
