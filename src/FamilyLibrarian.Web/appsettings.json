{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "EnableLocal": true
  },
  "MetadataProviders": {
    "Demo": {
      "Enabled": true
    },
    "OpenLibrary": {
      "Enabled": false,
      "MaxResults": 10,
      "TimeoutSeconds": 15,
      "RequestsPerSecond": 1
    },
    "GoogleBooks": {
      "Enabled": false,
      "MaxResults": 10,
      "TimeoutSeconds": 15
    }
  },
  "AllowedHosts": "*"
}
