{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "EnableLocal": true
  },
  "MetadataProviders": {
    "Demo": {
      "Enabled": true
    },
    "OpenLibrary": {
      "Enabled": false,
      "MaxResults": 10,
      "TimeoutSeconds": 15,
      "RequestsPerSecond": 1
    },
    "GoogleBooks": {
      "Enabled": false,
      "MaxResults": 10,
      "TimeoutSeconds": 15
    }
  },
  "ExternalProviderOutput": {
    "MaxOutputCount": 64,
    "MaxFileBytes": 1073741824,
    "MaxJobBytes": 4294967296,
    "MaxFilenameLength": 1024,
    "ReadInactivityTimeoutSeconds": 120
  },
  "AllowedHosts": "*"
}
