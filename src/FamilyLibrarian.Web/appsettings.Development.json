{
  "ConnectionStrings": {
    "FamilyLibrarian": "Host=localhost;Port=5432;Database=family_librarian;Username=family_librarian;Password=family_librarian"
  },
  "MetadataProviders": {
    "Demo": {
      "Enabled": false
    },
    "OpenLibrary": {
      "Enabled": true
    }
  },
  "Storage": {
    // The production default (/data/family-librarian) only exists because the
    // Dockerfile creates it and Compose mounts a volume there. A bare
    // `dotnet run` outside a container needs somewhere it can actually write,
    // so this is relative to the Web project's own content root instead.
    "RootPath": "./.local-data/media"
  }
}
