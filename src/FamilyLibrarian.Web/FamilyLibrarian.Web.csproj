<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../FamilyLibrarian.Contracts/FamilyLibrarian.Contracts.csproj" />
    <ProjectReference Include="../FamilyLibrarian.Infrastructure/FamilyLibrarian.Infrastructure.csproj" />
    <ProjectReference Include="../FamilyLibrarian.Web.Client/FamilyLibrarian.Web.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Top-level statements compile to an internal Program class. WebApplicationFactory
      needs to reach it to boot the real host. Granting the test assembly access keeps
      Program internal rather than widening the public surface just for tests.
    -->
    <InternalsVisibleTo Include="FamilyLibrarian.Web.Tests" />
  </ItemGroup>
</Project>
