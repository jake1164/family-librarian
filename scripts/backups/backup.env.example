# Copy this file outside the repository, restrict it to the backup operator,
# and pass it to create-backup.sh with --config. Do not put credentials here.

# The completed backup-set directory is created below this path.
BACKUP_OUTPUT_DIRECTORY=/var/backups/family-librarian

# Each external library is either disabled because it is not used by this
# deployment, or backed up from host-visible directories. A remote library must
# expose those directories through a mounted/network path or use its own backup
# mechanism; do not claim a full recovery set otherwise.
CWA_BACKUP_MODE=disabled
# CWA_CONFIGURATION_DIRECTORY=/srv/cwa/config
# CWA_LIBRARY_DIRECTORY=/srv/cwa/calibre-library

AUDIOBOOKSHELF_BACKUP_MODE=disabled
# AUDIOBOOKSHELF_CONFIGURATION_DIRECTORY=/srv/audiobookshelf/config
# AUDIOBOOKSHELF_LIBRARY_DIRECTORY=/srv/audiobookshelf/library

# A descriptive recovery reference only (for example, a secret-manager record
# name and certificate renewal/runbook ID). It is recorded in the manifest but
# no raw certificate, passphrase, or credential is ever copied into a backup.
DEPLOYMENT_SECRET_RECOVERY_REFERENCE=record-in-your-secret-manager-and-runbook
