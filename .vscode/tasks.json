{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "dotnet build the solution (warnings are errors)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/FamilyLibrarian.slnx",
        "-consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "detail": "dotnet clean the solution",
      "command": "dotnet",
      "type": "process",
      "args": ["clean", "${workspaceFolder}/FamilyLibrarian.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "detail": "Run the MSTest / Microsoft Testing Platform suite",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "--solution", "${workspaceFolder}/FamilyLibrarian.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "detail": "dotnet watch run with hot reload (no debugger attached)",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/FamilyLibrarian.Web"],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080"
        }
      },
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },

    {
      "label": "dev-db: up",
      "detail": "Start the local debug PostgreSQL container and wait for health",
      "command": "docker",
      "type": "process",
      "args": ["compose", "-f", "compose.debug.yaml", "up", "-d", "--wait"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "dev-db: down",
      "detail": "Stop the local debug PostgreSQL container (keeps its volume)",
      "command": "docker",
      "type": "process",
      "args": ["compose", "-f", "compose.debug.yaml", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "dev-db: reset",
      "detail": "Destroy the local debug PostgreSQL container AND its data volume",
      "command": "docker",
      "type": "process",
      "args": ["compose", "-f", "compose.debug.yaml", "down", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "db: apply migrations",
      "detail": "Run the host with --migrate against the local debug database",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/src/FamilyLibrarian.Web", "--", "--migrate"],
      "options": { "env": { "ASPNETCORE_ENVIRONMENT": "Development" } },
      "dependsOn": ["dev-db: up"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dev: check .env",
      "detail": "Fail early with a clear message if .env is missing (launch.json envFile needs it)",
      "type": "shell",
      "command": "test -f .env || { echo 'Missing .env — run: cp .env.example .env  then edit the values'; exit 1; }",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "dev: prepare",
      "detail": "Check .env, start the debug database, apply migrations, then build",
      "dependsOrder": "sequence",
      "dependsOn": ["dev: check .env", "dev-db: up", "db: apply migrations", "build"],
      "problemMatcher": []
    },

    {
      "label": "compose: up --build",
      "detail": "Run the full production-shaped stack (needs .env)",
      "command": "docker",
      "type": "process",
      "args": ["compose", "up", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "compose: down",
      "detail": "Stop the full Compose stack",
      "command": "docker",
      "type": "process",
      "args": ["compose", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
