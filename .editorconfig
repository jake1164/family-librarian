root = true

[*.cs]
# Unused using directives.
#
# Default severity is "suggestion", which never surfaces in a command-line
# build even with EnforceCodeStyleInBuild set — so a vestigial using can sit in
# the tree indefinitely, and with it the dead ProjectReference it appears to
# justify. That is exactly how FamilyLibrarian.Application kept a reference to
# FamilyLibrarian.Contracts long after nothing crossed the boundary. Raised to
# warning so TreatWarningsAsErrors turns it into a build failure.
dotnet_diagnostic.IDE0005.severity = warning

# Namespace must match folder structure. The codebase already follows this
# (Infrastructure/Security -> FamilyLibrarian.Infrastructure.Security), so this
# pins an existing convention rather than imposing a new one.
dotnet_diagnostic.IDE0130.severity = warning

# EF Core writes the migration files, including their using directives, and
# scaffolds new ones the same way. Holding generated code to a style rule the
# generator does not follow would fail the build on every `dotnet ef migrations
# add`, so these are exempt. Everything hand-written stays covered above.
[src/FamilyLibrarian.Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none

# Same rationale as IDE0005 above: EF's migration scaffolder always writes a
# composite CreateIndex's columns as `new[] { ... }`, which CA1861 flags as a
# reused-array-literal perf smell. It first surfaced on a freshly scaffolded
# migration (AddDeliveryAttempts) even though every earlier migration already
# contains the identical pattern -- Roslyn's incremental analyzer cache had
# simply never re-flagged the untouched older files. Held to that rule would
# fail the build on every `dotnet ef migrations add` that touches a composite
# index, so it is exempt here alongside IDE0005.
dotnet_diagnostic.CA1861.severity = none
