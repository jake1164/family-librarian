# Copy this file to .env and replace every example value before starting Compose.
# .env is git-ignored and is the single place local credentials live. It feeds
# both Docker Compose and the VS Code debugger (launch.json `envFile`).
#
# Avoid "$" in any value: Docker Compose interpolates it in this file.

# --- Docker Compose (compose.yaml) -------------------------------------------
# Referenced as ${NAME} in compose.yaml and injected into the containers there.
POSTGRES_PASSWORD=replace-with-a-strong-development-password

# Optional Open Library identification. Leave both defaults unchanged for the
# anonymous one-request-per-second limit. Open Library allows up to three requests
# per second only when a real contact email is supplied.
OPENLIBRARY_CONTACT_EMAIL=
OPENLIBRARY_REQUESTS_PER_SECOND=1

# Optional Google Books metadata. The key is server-only; never paste it in a
# source file or browser configuration.
#
# Leave both of these blank to manage Google Books from the Admin > Integrations
# page instead: the key is then stored encrypted in PostgreSQL under the Data
# Protection key ring, and an administrator can replace or remove it without a
# redeploy. Setting ApiKey here instead makes it a read-only deployment override
# — the admin page shows it as "Managed by this deployment" and refuses to change
# it, because the next deploy would overwrite the change anyway.
MetadataProviders__GoogleBooks__Enabled=false
MetadataProviders__GoogleBooks__ApiKey=

# --- First administrator (Compose *and* the VS Code debugger) ----------------
# Read directly by key (not a nested options class), so this is a flat name
# like POSTGRES_PASSWORD above rather than the "__" section-separator style
# used elsewhere in this file. Env var names are matched case-insensitively.
#
# Local Identity is enabled by default as of M4. These two values create the
# first administrator on startup, and only when no admin exists yet. The
# password needs at least 8 characters; there is no digit/case/symbol
# requirement. Without them the app still starts and seeds the User/Admin
# roles, but no account exists to sign in with, so the Admin pages stay
# unreachable.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE-ME-Local-Dev-1!

# --- Invitations --------------------------------------------------------------
# Everyone after the first administrator joins through an invite link created on
# the Accounts page. Both settings are optional; the defaults below apply when
# they are unset, and an out-of-range value fails startup rather than being
# silently ignored.
#
# How many days an invite link stays usable (1-90).
Invitations__LifetimeDays=7
# Redemption/preview attempts allowed per caller per minute (1-10000). The
# redemption endpoint is anonymous by necessity, so it is rate limited. Raise
# this only if a household behind one shared address trips it, since everyone
# behind that address counts as one caller.
Invitations__RedemptionAttemptsPerMinute=10

# Optional: overrides appsettings.Development.json. Only set this if you changed
# the credentials in compose.debug.yaml, and keep the two in sync.
# ConnectionStrings__FamilyLibrarian=Host=localhost;Port=5432;Database=family_librarian;Username=family_librarian;Password=family_librarian

# --- Reverse proxy (only needed behind one) -----------------------------------
# CIDR networks the forwarded-headers middleware trusts to supply
# X-Forwarded-For/X-Forwarded-Proto — comma-separated, e.g.
# ReverseProxy__TrustedNetworks__0=172.30.0.0/16. Unconfigured, only loopback
# is trusted (the framework default), so a reverse proxy on another host or in
# another container needs this set, or every caller's real address and scheme
# are lost. Never widen this to "trust everything" — that lets any client
# spoof its own address into request logs and the invitation rate limiter's
# per-caller partition key. See docs/06-deployment-and-recovery.md.
# ReverseProxy__TrustedNetworks__0=

# --- Data Protection key ring encryption (strongly recommended in production) -
# Every provider credential, SFTP key, and OIDC client secret saved through the
# admin UI is encrypted with this key ring, persisted in PostgreSQL. Without a
# certificate here, the key ring itself sits in the database unencrypted —
# meaning a database backup contains everything needed to decrypt every secret
# it also contains. The app still starts and logs a warning; it does not fail
# closed, because an operator's first deploy has no certificate to provide yet.
# See docs/06-deployment-and-recovery.md.
# DataProtection__KeyEncryptionCertificate__Path=/run/secrets/dataprotection.pfx
# DataProtection__KeyEncryptionCertificate__Password=
